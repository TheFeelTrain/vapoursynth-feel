#version 450
#extension GL_EXT_shader_16bit_storage : require

/*
 * GaussBlur — separable per-plane Gaussian blur (Vulkan port of the vszipcl /
 * vszipcu reference kernels). Exactly one of ENTRY_GAUSS / ENTRY_VERT /
 * ENTRY_HORIZ is defined at compile time, selecting the entry point:
 *
 *   ENTRY_GAUSS  — fused small path (radius <= 32): vertical blur of the tile
 *                  columns plus a +/-RAD X-halo into shared memory, then the
 *                  horizontal blur from shared memory straight to the output.
 *   ENTRY_VERT   — large path (radius > 32), first pass: R consecutive output
 *                  rows per thread using a rolling weight window.
 *   ENTRY_HORIZ  — large path, second pass: R consecutive output columns per
 *                  thread from the vertical pass' float buffer.
 *
 * Parity notes (do not alter): mirror reflects at the edges (single fold,
 * `-i` / `2*(dim-1)-i`), the taps are accumulated in ascending-k order, and
 * the accumulation uses explicit fma() so the FMAD contraction matches the
 * CUDA/OpenCL references. The IO conversion follows the references: integer
 * input is the raw code (no scaling), integer output rounds to nearest even
 * and saturates (convert_*_sat_rte).
 *
 * All buffers live in device-local VRAM (the host moves frames in/out with
 * DMA copies in the same command buffer). Compile-time variants:
 * -DBITS=16|32. The 16-bit path uses native uint16_t SSBO elements (the
 * device enables storageBuffer16BitAccess), so loads and stores are plain
 * coalesced element accesses — no shift/mask unpacking, no dword packing,
 * no atomics.
 */

#if !defined(BITS)
#define BITS 16
#endif

#if BITS == 16
#define IO_TYPE uint16_t
#define PEAK    65535.0f
#else
#define IO_TYPE float
#define PEAK    1.0f
#endif

const int BLK_X = 16;
const int BLK_Y = 8;
const int VRT = 3;
const int R = 8;

layout(constant_id = 0) const int WIDTH = 1920;
layout(constant_id = 1) const int HEIGHT = 1080;
layout(constant_id = 2) const int STRIDE = 1920;
layout(constant_id = 3) const int KLEN = 1;
layout(constant_id = 4) const int RAD = 0;

layout(std430, binding = 0) readonly buffer WtBuf { float wt[]; };
layout(std430, binding = 1) readonly buffer SrcBuf { IO_TYPE src[]; };
layout(std430, binding = 2) writeonly buffer DstBuf { IO_TYPE dst[]; };
layout(std430, binding = 3) buffer TmpBuf { float tmp[]; };

// element offsets into the VRAM buffers; wt_base is a float element offset
// into the weights buffer
layout(push_constant) uniform PushConstants {
    int src_base;
    int dst_base;
    int tmp_base;
    int wt_base;
} pc;

float load_value(int idx) {
#if BITS == 32
    return src[pc.src_base + idx];
#else
    // direct uint16_t->float conversion chokes glslc; int() widens cleanly
    return float(int(src[pc.src_base + idx]));
#endif
}

// load from an absolute element index (the caller precomputes src_base itself)
float load_value_raw(int idx) {
#if BITS == 32
    return src[idx];
#else
    return float(int(src[idx]));
#endif
}

void store_value(int idx, float v) {
#if BITS == 32
    dst[pc.dst_base + idx] = v;
#else
    // glslc -O chokes on a direct float->uint16_t convert (OpUConvert); go
    // through uint with an explicit mask (same workaround as nlmeans/dfttest)
    dst[pc.dst_base + idx] = uint16_t(uint(clamp(roundEven(v), 0.0f, PEAK)) & 0xFFFFu);
#endif
}

#if defined(ENTRY_HORIZ) && (BITS == 16)
// raw dword view of the 16-bit output buffer (even element = low halfword),
// used by the packed pair stores of the horizontal pass
layout(std430, binding = 4) writeonly buffer DstU32 { uint dst32[]; };

// Horizontal-pass output, interior rows only: write R consecutive values as
// packed dword pairs (R/2 32-bit stores). The caller guarantees x0 is even
// and x0+R-1 < WIDTH, so each thread owns its dwords outright.
void store_row_packed(int row, int x0, float vals[R]) {
    const int base32 = (pc.dst_base + row + x0) >> 1;   // dword index
    #pragma unroll
    for (int p = 0; p < R / 2; ++p) {
        const uint lo = uint(clamp(roundEven(vals[2 * p]), 0.0f, PEAK)) & 0xFFFFu;
        const uint hi = uint(clamp(roundEven(vals[2 * p + 1]), 0.0f, PEAK)) & 0xFFFFu;
        dst32[base32 + p] = lo | (hi << 16);
    }
}
#elif defined(ENTRY_HORIZ)
// float path: no packing needed, plain stores
void store_row_packed(int row, int x0, float vals[R]) {
    #pragma unroll
    for (int j = 0; j < R; ++j) {
        dst[pc.dst_base + row + x0 + j] = vals[j];
    }
}
#endif

// mirror reflects a raw (possibly out-of-range) tap coordinate
int mirror(int i, int dim) {
    if (i < 0) {
        return -i;
    } else if (i >= dim) {
        return 2 * (dim - 1) - i;
    }
    return i;
}

#if defined(ENTRY_GAUSS)

// the tile of vertically blurred columns: VRT*BLK_Y output rows wide, with a
// +-RAD halo of columns so the horizontal pass never leaves shared memory
shared float vblur[VRT * BLK_Y][BLK_X + 2 * RAD];

layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int lx = int(gl_LocalInvocationID.x);
    const int ly = int(gl_LocalInvocationID.y);
    const int gx0 = int(gl_WorkGroupID.x) * BLK_X;       // first output column
    const int gy0 = int(gl_WorkGroupID.y) * (VRT * BLK_Y); // first output row

    // Phase 1 — vertical blur of the tile columns + a +-RAD X-halo into local
    // memory. Every thread reaches the barrier below (the `continue` only
    // skips the row's work), so no deadlock on the ragged tail.
    for (int ry = ly; ry < VRT * BLK_Y; ry += BLK_Y) {
        const int y = gy0 + ry;
        if (y >= HEIGHT) continue;   // row past frame: Phase 2 never reads it
        for (int cj = lx; cj < BLK_X + 2 * RAD; cj += BLK_X) {
            int cx = gx0 - RAD + cj;                     // raw (maybe OOB) column
            cx = mirror(cx, WIDTH);
            cx = min(max(cx, 0), WIDTH - 1);             // no-op for read cells
            float vsum = 0.0f;
            for (int k = 0; k < KLEN; ++k) {             // ascending k
                int sy = y + k - RAD;
                sy = mirror(sy, HEIGHT);
                vsum = fma(load_value(sy * STRIDE + cx), wt[pc.wt_base + k], vsum);
            }
            vblur[ry][cj] = vsum;
        }
    }
    barrier();

    // Phase 2 — horizontal blur from vblur -> dst. Output col x, VRT output
    // rows per thread.
    const int x = gx0 + lx;
    if (x >= WIDTH) return;
    for (int r = 0; r < VRT; ++r) {
        const int y = gy0 + ly + r * BLK_Y;
        if (y >= HEIGHT) return;                         // strided y -> safe to bail
        const int lc = ly + r * BLK_Y;                   // local tile row
        float sum = 0.0f;
        for (int k = 0; k < KLEN; ++k)                   // ascending k
            sum = fma(vblur[lc][lx + k], wt[pc.wt_base + k], sum);
        store_value(y * STRIDE + x, sum);
    }
}

#elif defined(ENTRY_VERT)

// Large path, vertical pass. R consecutive output rows per thread; the rolling
// weight window reproduces the per-pixel ascending-k FMAs exactly (taps past
// the kernel length carry wreg[j] == 0.0f, an exact no-op).
//
// Optimizations over the naive rolling window (bit-exactness preserved — the
// FMA sequence per output pixel is unchanged):
// - interior threads (no mirror needed for any tap) run a branch-free loop
//   with incrementing row addresses; only edge threads take the mirror path
// - two tap rows are in flight at once (even/odd k), so the VMEM engine
//   overlaps loads instead of stalling on every tap
layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y0 = int(gl_GlobalInvocationID.y) * R;     // first output row
    if (x >= WIDTH || y0 >= HEIGHT) return;
    const int radius = KLEN / 2;
    float sum[R], wreg[R];
    #pragma unroll
    for (int j = 0; j < R; ++j) { sum[j] = 0.0f; wreg[j] = 0.0f; }

    // the thread is interior when every row it reads — the full rolling
    // window, i.e. [y0-radius, y0+taps-1-radius] — is in range: no mirror
    // anywhere, no out-of-bounds loads
    const int taps_v = KLEN + (R - 1);
    const bool interior = y0 - radius >= 0 && y0 + taps_v - 1 - radius < HEIGHT;

    if (interior) {
        const int idx0 = pc.src_base + (y0 - radius) * STRIDE + x;
        const int taps = KLEN + (R - 1);
        for (int k = 0; k < taps; k += 2) {
            #pragma unroll
            for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];
            wreg[0] = (k < KLEN) ? wt[pc.wt_base + k] : 0.0f;
            // both tap rows are issued before either FMA batch, so the VMEM
            // engine has two loads in flight instead of stalling per tap
            const float v0 = load_value_raw(idx0 + k * STRIDE);
            if (k + 1 < taps) {
                const float v1 = load_value_raw(idx0 + (k + 1) * STRIDE);
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v0, wreg[j], sum[j]);
                #pragma unroll
                for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];
                wreg[0] = (k + 1 < KLEN) ? wt[pc.wt_base + k + 1] : 0.0f;
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v1, wreg[j], sum[j]);
            } else {
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v0, wreg[j], sum[j]);
            }
        }
    } else {
        for (int k = 0; k < KLEN + (R - 1); ++k) {
            #pragma unroll
            for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];
            wreg[0] = (k < KLEN) ? wt[pc.wt_base + k] : 0.0f;
            int sy = y0 + k - radius;
            sy = mirror(sy, HEIGHT);
            sy = min(max(sy, 0), HEIGHT - 1);
            const float v = load_value(sy * STRIDE + x);
            #pragma unroll
            for (int j = 0; j < R; ++j)
                sum[j] = fma(v, wreg[j], sum[j]);
        }
    }
    #pragma unroll
    for (int j = 0; j < R; ++j) {
        if (y0 + j < HEIGHT) tmp[pc.tmp_base + (y0 + j) * STRIDE + x] = sum[j];
    }
}

#elif defined(ENTRY_HORIZ)

// Large path, horizontal pass: R consecutive output columns per thread,
// reading the vertical pass' float tmp buffer. Same optimizations as the
// vertical pass (interior fast path + two taps in flight), plus the output
// is written as packed dword pairs — R/2 32-bit stores instead of R 16-bit
// stores (thread ownership of whole dwords is guaranteed: x0 is even).
layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int x0 = int(gl_GlobalInvocationID.x) * R;     // first output column
    const int y = int(gl_GlobalInvocationID.y);
    if (x0 >= WIDTH || y >= HEIGHT) return;
    const int radius = KLEN / 2;
    const int row = y * STRIDE;
    float sum[R], wreg[R];
    #pragma unroll
    for (int j = 0; j < R; ++j) { sum[j] = 0.0f; wreg[j] = 0.0f; }

    // interior: no column tap ever needs the mirror (the full rolling window
    // [x0-radius, x0+taps-1-radius] is in range), which also implies x0 and
    // x0+R-1 are both in range, so every output and packed store is valid
    const int taps_h = KLEN + (R - 1);
    const bool interior = x0 - radius >= 0 && x0 + taps_h - 1 - radius < WIDTH;

    if (interior) {
        const int base = pc.tmp_base + row + x0 - radius;
        const int taps = KLEN + (R - 1);
        for (int k = 0; k < taps; k += 2) {
            #pragma unroll
            for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];
            wreg[0] = (k < KLEN) ? wt[pc.wt_base + k] : 0.0f;
            const float v0 = tmp[base + k];
            if (k + 1 < taps) {
                const float v1 = tmp[base + k + 1];
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v0, wreg[j], sum[j]);
                #pragma unroll
                for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];
                wreg[0] = (k + 1 < KLEN) ? wt[pc.wt_base + k + 1] : 0.0f;
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v1, wreg[j], sum[j]);
            } else {
                #pragma unroll
                for (int j = 0; j < R; ++j)
                    sum[j] = fma(v0, wreg[j], sum[j]);
            }
        }
        store_row_packed(row, x0, sum);
    } else {
        for (int k = 0; k < KLEN + (R - 1); ++k) {
            #pragma unroll
            for (int j = R - 1; j >= 1; --j) wreg[j] = wreg[j - 1];   // slide the window
            wreg[0] = (k < KLEN) ? wt[pc.wt_base + k] : 0.0f;
            int sx = x0 + k - radius;
            sx = mirror(sx, WIDTH);
            sx = min(max(sx, 0), WIDTH - 1);                 // no-op for valid radius
            const float v = tmp[pc.tmp_base + row + sx];
            #pragma unroll
            for (int j = 0; j < R; ++j)
                sum[j] = fma(v, wreg[j], sum[j]);
        }
        #pragma unroll
        for (int j = 0; j < R; ++j) {
            if (x0 + j < WIDTH) store_value(row + x0 + j, sum[j]);
        }
    }
}

#endif
