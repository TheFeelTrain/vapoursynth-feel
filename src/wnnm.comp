#version 450
// Buffer float atomics: the accumulator is scattered by every group that
// matched a position. -DNO_FLOAT_ATOMICS builds the same add on
// atomicCompSwap (the reference's own atom_add_f) for devices without
// shaderBufferFloat32AtomicAdd.
#ifndef NO_FLOAT_ATOMICS
#extension GL_EXT_shader_atomic_float : require
#endif
#extension GL_EXT_buffer_reference : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_16bit_storage : require

/*
 * WNNM (weighted nuclear norm minimization) denoiser, ported from
 * reference/vapoursynth-zip's CPU filter. One workgroup owns one reference
 * block of the step lattice and does the whole pipeline for it: block match,
 * WNNM shrinkage of the group's pmat matrix, weighted scatter.
 *
 * -DENTRY_GROUP is the per-block kernel, -DENTRY_FINISH the num/den divide.
 * The Gram matrix, the Jacobi rotations and the shrink factors are float: f64
 * tracks the reference's arithmetic to ulp level but costs 13.5x the whole
 * frame here, and only moves the shrink decisions where an eigenvalue already
 * sits within ~1e-5 of the threshold.
 * -DQMAX sizes the LDS eigen workspace (8/16/32); q = min(bs^2, group_size).
 *
 * Matching is the reference's selectTopIdx as a streaming top-k: candidates are
 * fed in (y, x) scan order, which is what makes ties resolve the same way,
 * including the all-equal-window case where the first k in scan order win.
 */

// The eigen work is float throughout. f64 doubles the cost of every rotation on
// this GPU (measured 13.5x on the whole frame) and only moves the shrink
// decisions where they are already a coin flip; see notes/WNNM.md.
#define ETEPS 1.1920928955078125e-7
#define ETBIG 4.611686e18

#ifndef QMAX
#define QMAX 8
#endif

// The group kernel owns one reference block per workgroup, so -DWG sizes it to
// the threads that block actually uses; the match kernels keep 128.
#ifndef WG
#define WG 128
#endif
// Cyclic Jacobi sweeps for the split estimate's eigen step: f32 does not
// converge in 16 (2.4e-3 output error), 20 does, and 24/30 give the identical
// answer.
#define SWEEPS 20
// Candidates per selection tile, and the threads the matcher runs at. The tile
// has to cover the group kernel's whole workgroup to use every lane: at 32
// threads a 32-candidate tile leaves three quarters of the CU idle while the
// SSDs of a tile are latency-bound.
#ifndef TFULL
#define TFULL 32
#endif
#ifndef SELCAP
#define SELCAP 32
#endif
#define KMAXL 64
// The final list is capped at the group size, so its storage only has to cover
// GS; the fused matcher's running list (KMAXL) is wider than the top list.
#if defined(NOMATCH) || defined(MATCH_ONLY)
#define TOPCAP GS
#else
#define TOPCAP KMAXL
#endif

layout(local_size_x = WG) in;

layout(constant_id = 0) const int W = 1920;
layout(constant_id = 1) const int H = 1080;
layout(constant_id = 2) const int STRIDE = 1920;
layout(constant_id = 3) const int BS = 8;
layout(constant_id = 4) const int STEP = 8;
layout(constant_id = 5) const int GS = 8;
layout(constant_id = 6) const int BM_RANGE = 7;
layout(constant_id = 7) const int RADIUS = 0;
layout(constant_id = 8) const int PS_NUM = 2;
layout(constant_id = 9) const int PS_RANGE = 4;
layout(constant_id = 10) const int GX = 1;
layout(constant_id = 11) const int NG = 1;
layout(constant_id = 12) const int RESIDUAL = 0;
layout(constant_id = 13) const int ADAPTIVE = 1;
layout(constant_id = 14) const int LOCS_CAP = 1;
// Address-table base of this plane: plane * 2 * WL entries, refs then sources.
layout(constant_id = 15) const int ADDR_BASE = 0;
layout(constant_id = 16) const float SIGMA = 0.0;
layout(constant_id = 17) const int ACC_BASE = 0;
layout(constant_id = 18) const int PMAT_BASE = 0;
// Diagnostic: TRACE != 0 writes one 28-word record per (group, centre) --
// n, kept, weight, location count and the selected group's errors/positions/
// temporal slots -- for the host to diff against the reference
// (VSFEEL_WNNM_DUMP=<frame>).
layout(constant_id = 19) const int TRACE = 0;
layout(constant_id = 20) const int TRBASE = 0;
// Floats of patch scratch per group: M*GS, plus M for the mean vector when
// -DRESIDUAL strips it (added back in the scatter).
layout(constant_id = 21) const int PMAT_STRIDE = 0;
// Element offset of this plane's per-group search-location region.
layout(constant_id = 22) const int LOCS_BASE = 0;
// Element offsets of this plane's regions in the distance and match buffers.
layout(constant_id = 23) const int DIST_BASE = 0;
layout(constant_id = 24) const int MATCH_BASE = 0;
// Slots per group in the match buffer, and whether they are a per-centre cache
// shared by the frames that consume that centre (temporal) or one set per
// output frame. RING is the fold count either way, so the two layouts differ
// only in which slot a fold reads.
layout(constant_id = 25) const int RING = 1;
layout(constant_id = 26) const int CACHE = 0;

#define M (BS * BS)
#define TEMP_C (W - BS)
#define TEMP_R (H - BS)
// Candidates per group of the largest window (the distance array's stride).
#define DIST_STRIDE                                                           \
    (min(2 * BM_RANGE + 1, TEMP_R + 1) * min(2 * BM_RANGE + 1, TEMP_C + 1))
#define WL (4 * RADIUS + 1)
#define SRC_BASE WL

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer
    PlaneRef {
    float v[];
};

layout(std430, binding = 0) readonly buffer AddrBuf { PlaneRef img[]; } addr;
// [0, W*H): weighted sums; [W*H, 2*W*H): weights.
// The accumulator is written only by atomics; the no-hardware-atomic arm
// aliases it as uint for the CAS loop, and the finish kernel always reads it
// as float.
#if defined(ENTRY_FINISH) || !defined(NO_FLOAT_ATOMICS)
layout(std430, binding = 1) coherent buffer AccBuf { float acc[]; };
#else
layout(std430, binding = 1) coherent buffer AccBuf { uint acc_u[]; };
#endif
layout(std430, binding = 2) buffer LocsBuf { uint locs[]; };
layout(std430, binding = 3) buffer PatchBuf { float pmat[]; };
#if defined(IO_U16)
layout(std430, binding = 4) writeonly buffer DstBuf { uint16_t dst[]; };
#elif defined(IO_F16)
layout(std430, binding = 4) writeonly buffer DstBuf { float16_t dst[]; };
#else
layout(std430, binding = 4) writeonly buffer DstBuf { float dst[]; };
#endif
layout(std430, binding = 5) buffer TraceBuf { uint trace[]; };
// Block matching's two halves (radius 0, group_size <= 8): every candidate's
// SSD per group, then the selected group per group.
layout(std430, binding = 6) buffer DistBuf { float dists[]; };
#if defined(ENTRY_SELECT) || defined(MATCH_ONLY)
layout(std430, binding = 7) buffer MatchBuf { uint matches[]; };
#else
layout(std430, binding = 7) readonly buffer MatchBuf { uint matches[]; };
#endif

// Temporal mode only: the output frame and the clip length, for the reference's
// VAggregate fold (its slab index is clamped at the clip boundaries, so the
// fold reads some (frame, slab) pairs more than once). `fold` names the one
// fold the match kernel is dispatched for, so a cached centre is searched once
// instead of once per frame that consumes it.
layout(push_constant) uniform Push {
    int pn;
    int frames;
    int fold;
    // Finish kernel only: a native output code is clamp(v * out_scale +
    // out_bias + 0.5, 0, PEAK), the inverse of the copy kernel's widening.
    float out_scale;
    float out_bias;
} pc;

// Final group, sorted by error. `top_t` is the temporal index in the centre
// frame's window; spatial groups are all t = 0.
shared float top_e[TOPCAP];
shared uint top_xy[TOPCAP];
shared int top_t[TOPCAP];
shared int top_n;

#if !defined(NOMATCH)
shared float cand[TFULL];
// The tile's selected list and the merge scratch of the block below.
shared float tile_e[SELCAP];
shared uint tile_xy[SELCAP];
shared int tile_n;
shared float merg_e[SELCAP];
shared uint merg_xy[SELCAP];
// The frame currently being selected (vszip's b.temporal / b.selidx list).
shared float fr_e[KMAXL];
shared uint fr_xy[KMAXL];
shared int fr_n;
shared int loc_n;     // generated search-location count
// The centre frame's spatial selection: each temporal direction restarts its
// predictive search from this list (the reference's b.center).
shared uint ctr_xy[KMAXL];
shared int ctr_n;
#endif
shared float weight;  // aggregation weight
shared int kept;      // retained singular values

shared float gm[QMAX * QMAX];
shared float vt[QMAX * QMAX];
shared float mm[QMAX * QMAX];
shared float shr[QMAX];
shared float eig[QMAX];
#if !defined(NOMATCH)
shared int seed_order[KMAXL];
#endif
// Round-robin Jacobi: the (k+1)/2 rotations of the current round, and the
// round that last rotated (the reference block_jacobi's cs/flag).
shared float jcs[QMAX + 2];
shared int jflag;

// The split matcher's search window, staged once per group. (2*bm_range + bs)^2
// floats covers bm_range up to 12 at bs 8; a larger window keeps the global
// loads, because the test folds at pipeline creation (both are spec constants).
#define WIN_MAX 1024
#define WIN_W (min(2 * BM_RANGE + BS, TEMP_C + BS))
shared float win[WIN_MAX];

// The group's reference block, packed once: every SSD compares against it, so
// staging it turns one of the two global loads per term into a shared-memory
// read (the temporal matcher's candidates are scattered positions, so there is
// no window to stage around them).
shared float refblk[BS * BS];

// SSD of the packed centre block against the block at (bx, by) of `rt`.
float block_dist_ref(PlaneRef rt, int bx, int by) {
    float acc = 0.0;
    for (int py = 0; py < BS; ++py) {
        const int rr = py * BS;
        const int rtrow = (by + py) * STRIDE + bx;
        for (int px = 0; px < BS; ++px) {
            precise float d = refblk[rr + px] - rt.v[rtrow + px];
            precise float dd = d * d;
            acc = acc + dd;
        }
    }
    return acc;
}

// SSD of two blocks inside `win`, both given by their top-left LDS offset.
float block_dist_win(int aw, int ax, int ay, int bx, int by) {
    float acc = 0.0;
    for (int py = 0; py < BS; ++py) {
        const int ar = (ay + py) * aw + ax;
        const int br = (by + py) * aw + bx;
        for (int px = 0; px < BS; ++px) {
            precise float d = win[ar + px] - win[br + px];
            precise float dd = d * d;
            acc = acc + dd;
        }
    }
    return acc;
}

// Pair `pair` of round `round` in a round-robin schedule over K (even)
// indices: every pair of indices meets exactly once per sweep and the indices
// are back in place afterwards.
void jacobi_schedule(int round, int pair, int k, out int p, out int q) {
    const int K = k + (k & 1);
    int a = round + pair;
    if (a >= K - 1) {
        a -= K - 1;
    }
    int b = round - pair;
    if (b < 0) {
        b += K - 1;
    }
    if (pair == 0) {
        b = K - 1;
    }
    p = min(a, b);
    q = max(a, b);
}

void jacobi_serial(int q) {
    const int KQ = q + (q & 1);
    if (q > 1) {
        for (int sweep = 0; sweep < 30; ++sweep) {
            float gmax = float(0);
            for (int i = 0; i < q; ++i) {
                gmax = max(gmax, gm[i * KQ + i]);
            }
            const float floor_abs = float(ETEPS) * gmax;
            bool rotated = false;
            for (int p = 0; p < q - 1; ++p) {
                for (int j = p + 1; j < q; ++j) {
                    const float apq = gm[p * KQ + j];
                    const float app = gm[p * KQ + p];
                    const float ajj = gm[j * KQ + j];
                    const float thresh =
                        max(float(ETEPS) * sqrt(max(app, float(0)) *
                                             max(ajj, float(0))),
                            floor_abs);
                    if (abs(apq) <= thresh) {
                        continue;
                    }
                    rotated = true;
                    const float theta = (ajj - app) / (float(2) * apq);
                    float t;
                    if (abs(theta) > float(ETBIG)) {
                        t = float(1) / (float(2) * theta);
                    } else {
                        const float at =
                            abs(theta) + sqrt(theta * theta + float(1));
                        t = theta >= float(0) ? float(1) / at : -float(1) / at;
                    }
                    const float cs = float(1) / sqrt(t * t + float(1));
                    const float sn = t * cs;
                    const float h = t * apq;
                    for (int i = 0; i < q; ++i) {
                        const float xp = gm[p * KQ + i];
                        const float yp = gm[j * KQ + i];
                        gm[p * KQ + i] = cs * xp - sn * yp;
                        gm[j * KQ + i] = sn * xp + cs * yp;
                    }
                    gm[p * KQ + p] = app - h;
                    gm[j * KQ + j] = ajj + h;
                    gm[p * KQ + j] = float(0);
                    gm[j * KQ + p] = float(0);
                    for (int i = 0; i < q; ++i) {
                        gm[i * KQ + p] = gm[p * KQ + i];
                        gm[i * KQ + j] = gm[j * KQ + i];
                    }
                    for (int i = 0; i < q; ++i) {
                        const float xp = vt[p * KQ + i];
                        const float yp = vt[j * KQ + i];
                        vt[p * KQ + i] = cs * xp - sn * yp;
                        vt[j * KQ + i] = sn * xp + cs * yp;
                    }
                }
            }
            if (!rotated) {
                break;
            }
        }
    }
}

// Parallel cyclic Jacobi: a round rotates a set of disjoint index pairs, so
// the rotations commute and the whole warp applies them at once; the rotations
// themselves run on the first half-warp. `gm` holds the symmetric matrix and
// receives the rotations, `vt` the eigenvectors; on return gm is diagonal. All
// threads of the workgroup must call this (it holds the barriers).
void jacobi_parallel(int k, int tid) {
    if (k < 2) {
        return;
    }
    // The round-robin schedule needs an even index count; an odd k is padded
    // with a zero row/column, which no rotation touches.
    const int KQ = k + (k & 1);
    float trace = float(0);
    for (int i = 0; i < k; ++i) {
        trace += abs(gm[i * KQ + i]);
    }
    const float floor_abs = float(ETEPS) * trace / float(k);
    const int hp = (k + (k & 1)) / 2;
    for (int sweep = 0; sweep < 30; ++sweep) {
        if (tid == 0) {
            jflag = 0;
        }
        barrier();
        for (int round = 0; round < k + (k & 1) - 1; ++round) {
            if (tid < hp) {
                int p, q;
                jacobi_schedule(round, tid, k, p, q);
                float c = float(1), sn = float(0);
                if (q < k) {
                    const float apq = gm[p * KQ + q];
                    const float app = gm[p * KQ + p];
                    const float ajj = gm[q * KQ + q];
                    const float thresh =
                        max(float(ETEPS) * sqrt(max(app, float(0)) * max(ajj, float(0))),
                            floor_abs);
                    if (abs(apq) > thresh) {
                        const float theta = (ajj - app) / (float(2) * apq);
                        float t;
                        if (abs(theta) > float(ETBIG)) {
                            t = float(1) / (float(2) * theta);
                        } else {
                            const float at =
                                abs(theta) + sqrt(theta * theta + float(1));
                            t = theta >= float(0) ? float(1) / at : -float(1) / at;
                        }
                        c = float(1) / sqrt(t * t + float(1));
                        sn = t * c;
                        jflag = round + 1;
                    }
                }
                jcs[2 * tid] = c;
                jcs[2 * tid + 1] = sn;
            }
            barrier();
            if (jflag != round + 1) {
                // No pair of this round rotates: nothing to apply. The barrier
                // stays, because the next round writes what this test reads.
                barrier();
                continue;
            }
            for (int item = tid; item < k * hp; item += WG) {
                const int row = item / hp;
                const int pair = item - row * hp;
                const float c = jcs[2 * pair];
                const float sn = jcs[2 * pair + 1];
                int p, q;
                jacobi_schedule(round, pair, k, p, q);
                if (sn != float(0)) {
                    const float vip = vt[row * k + p];
                    const float viq = vt[row * k + q];
                    vt[row * k + p] = c * vip - sn * viq;
                    vt[row * k + q] = sn * vip + c * viq;
                }
                if (row < hp) {
                    const float cr = jcs[2 * row];
                    const float sr = jcs[2 * row + 1];
                    if (sn != float(0) || sr != float(0)) {
                        int pr, qr;
                        jacobi_schedule(round, row, k, pr, qr);
                        const bool wide = q < k, tall = qr < k;
                        float a = gm[pr * KQ + p];
                        float b = wide ? gm[pr * KQ + q] : float(0);
                        float d = tall ? gm[qr * KQ + p] : float(0);
                        float e = (wide && tall) ? gm[qr * KQ + q] : float(0);
                        if (sn != float(0)) {
                            const float ap = c * a - sn * b;
                            const float aq = sn * a + c * b;
                            const float dp = c * d - sn * e;
                            const float dq = sn * d + c * e;
                            a = ap;
                            b = aq;
                            d = dp;
                            e = dq;
                        }
                        if (sr != float(0)) {
                            const float ap = cr * a - sr * d;
                            const float dp = sr * a + cr * d;
                            const float bp = cr * b - sr * e;
                            const float ep = sr * b + cr * e;
                            a = ap;
                            d = dp;
                            b = bp;
                            e = ep;
                        }
                        gm[pr * KQ + p] = a;
                        if (wide) {
                            gm[pr * KQ + q] = b;
                        }
                        if (tall) {
                            gm[qr * KQ + p] = d;
                        }
                        if (wide && tall) {
                            gm[qr * KQ + q] = e;
                        }
                    }
                }
            }
            barrier();
        }
        const int rotated = jflag;
        barrier();
        if (rotated == 0) {
            break;
        }
    }
}

uint pack_xy(int x, int y) {
    return uint(x) | (uint(y) << 16);
}
int unpack_x(uint v) {
    return int(v & 0xffffu);
}
int unpack_y(uint v) {
    return int(v >> 16);
}

#if !defined(NOMATCH)
// Stable insertion of (e, xy) into the sorted frame list.
// One tile of candidates into the running group list, in parallel: every
// candidate counts how many rank below it (error first, then arrival order,
// which is exactly the reference's stable selection) and the ones under kk
// write themselves into the tile's list, which is then merged into the running
// one. The serial insert this replaces was measured at 96% of a temporal frame.
void fr_tile(int span, int kk, bool spatial, int cx, int wleft, int wtop,
             int loc_base, int base) {
    const int tid = int(gl_LocalInvocationIndex);
    const int cap = min(kk, SELCAP);
    if (tid == 0) {
        tile_n = min(span, cap);
    }
    barrier();
    for (int i = tid; i < span; i += WG) {
        const float e = cand[i];
        int rank = 0;
        for (int j = 0; j < span; ++j) {
            const float o = cand[j];
            rank += ((o < e) || (o == e && j < i)) ? 1 : 0;
        }
        if (rank < cap) {
            const int idx = base + i;
            tile_e[rank] = e;
            tile_xy[rank] = spatial
                                ? pack_xy(wleft + idx % cx, wtop + idx / cx)
                                : locs[loc_base + idx];
        }
    }
    barrier();
    if (tid == 0) {
        const int tn = tile_n;
        int a = 0;
        int b = 0;
        int w = 0;
        while (w < cap) {
            if (a >= fr_n && b >= tn) {
                break;
            }
            const bool take = b < tn && (a >= fr_n || tile_e[b] < fr_e[a]);
            if (take) {
                merg_e[w] = tile_e[b];
                merg_xy[w] = tile_xy[b];
                ++b;
            } else {
                merg_e[w] = fr_e[a];
                merg_xy[w] = fr_xy[a];
                ++a;
            }
            ++w;
        }
        fr_n = w;
        for (int i = 0; i < w; ++i) {
            fr_e[i] = merg_e[i];
            fr_xy[i] = merg_xy[i];
        }
    }
    barrier();
}

void fr_feed(float e, uint xy, int kk) {
    if (fr_n < kk) {
        int pos = fr_n;
        while (pos > 0 && fr_e[pos - 1] > e) {
            --pos;
        }
        for (int j = fr_n; j > pos; --j) {
            fr_e[j] = fr_e[j - 1];
            fr_xy[j] = fr_xy[j - 1];
        }
        fr_e[pos] = e;
        fr_xy[pos] = xy;
        ++fr_n;
    } else if (e < fr_e[kk - 1]) {
        int pos = kk - 1;
        while (pos > 0 && fr_e[pos - 1] > e) {
            --pos;
        }
        for (int j = kk - 1; j > pos; --j) {
            fr_e[j] = fr_e[j - 1];
            fr_xy[j] = fr_xy[j - 1];
        }
        fr_e[pos] = e;
        fr_xy[pos] = xy;
    }
}

// Merge the frame list into the final list, stable on ties, capped at GS.
void top_merge(int t) {
    int a = top_n;
    int b = fr_n;
    int nout = min(a + b, GS);
    // Drop the largest from the tail first; ties drop the later list's entry,
    // which is where a stable sort of the concatenation would put it.
    for (int drop = a + b - nout; drop > 0; --drop) {
        if (a == 0) {
            --b;
        } else if (b == 0) {
            --a;
        } else if (top_e[a - 1] > fr_e[b - 1]) {
            --a;
        } else {
            --b;
        }
    }
    // Fill from the back: the larger tail belongs in the higher slot, and on a
    // tie the later list's entry goes later (stable).
    for (int i = nout - 1; i >= 0; --i) {
        if (b == 0 || (a > 0 && top_e[a - 1] > fr_e[b - 1])) {
            top_e[i] = top_e[a - 1];
            top_xy[i] = top_xy[a - 1];
            top_t[i] = top_t[a - 1];
            --a;
        } else {
            top_e[i] = fr_e[b - 1];
            top_xy[i] = fr_xy[b - 1];
            top_t[i] = t;
            --b;
        }
    }
    top_n = nout;
}

void top_from_fr(int t) {
    int nout = min(fr_n, GS);
    for (int i = 0; i < nout; ++i) {
        top_e[i] = fr_e[i];
        top_xy[i] = fr_xy[i];
        top_t[i] = t;
    }
    top_n = nout;
}

// The reference always keeps the centre block in the group, overwriting the
// best entry when the stable selection dropped it.
void top_ensure_center(int x, int y, int t) {
    bool has = false;
    for (int i = 0; i < top_n; ++i) {
        if (unpack_x(top_xy[i]) == x && unpack_y(top_xy[i]) == y &&
            top_t[i] == t) {
            has = true;
            break;
        }
    }
    if (!has) {
        top_e[0] = 0.0;
        top_xy[0] = pack_xy(x, y);
        top_t[0] = t;
    }
}

#endif
// Sequential f32 SSD, in the reference's p order (row-major patch).
float block_dist(PlaneRef rc, PlaneRef rt, int cx, int cy, int bx, int by) {
    // `precise` keeps the multiply and the add separate: the reference
    // accumulates d*d sequentially in f32 and contracts nothing, and an ulp
    // here flips which of two near-equal blocks is selected.
    float acc = 0.0;
    for (int py = 0; py < BS; ++py) {
        const int rcrow = (cy + py) * STRIDE + cx;
        const int rtrow = (by + py) * STRIDE + bx;
        for (int px = 0; px < BS; ++px) {
            precise float d = rc.v[rcrow + px] - rt.v[rtrow + px];
            precise float dd = d * d;
            acc = acc + dd;
        }
    }
    return acc;
}

#if !defined(NOMATCH)
// Union of the clipped (2*PS_RANGE+1)^2 windows around the first
// min(PS_NUM, window area) seeds, enumerated in (y, x) order exactly like
// generateSearchLocations. Thread 0 only; returns the point count.
int generate_locs(int wg, int active_ps, int loc_base) {
    const int ncent = min(active_ps, fr_n);
    int y0 = H;
    int y1 = -1;
    for (int i = 0; i < ncent; ++i) {
        const int by = unpack_y(fr_xy[i]);
        y0 = min(y0, max(by - PS_RANGE, 0));
        y1 = max(y1, min(by + PS_RANGE, TEMP_R));
    }
    if (y1 < y0) {
        return 0;
    }
    // Sort the seed indices by their window's left edge once; a row's union is
    // then a single sweep over that order.
    for (int i = 0; i < ncent; ++i) {
        const int L = max(unpack_x(fr_xy[i]) - PS_RANGE, 0);
        int pos = i;
        while (pos > 0 &&
               max(unpack_x(fr_xy[seed_order[pos - 1]]) - PS_RANGE, 0) > L) {
            seed_order[pos] = seed_order[pos - 1];
            --pos;
        }
        seed_order[pos] = i;
    }
    int count = 0;
    int cur_l = 0;
    int cur_r = -1;
    for (int yy = y0; yy <= y1; ++yy) {
        cur_l = 0;
        cur_r = -1;
        for (int s = 0; s < ncent; ++s) {
            const uint xy = fr_xy[seed_order[s]];
            const int by = unpack_y(xy);
            if (yy < max(by - PS_RANGE, 0) || yy > min(by + PS_RANGE, TEMP_R)) {
                continue;
            }
            const int L = max(unpack_x(xy) - PS_RANGE, 0);
            const int R = min(unpack_x(xy) + PS_RANGE, TEMP_C);
            if (L > cur_r + 1) {
                for (int xx = cur_l; xx <= cur_r && count < LOCS_CAP;
                     ++xx) {
                    locs[loc_base + count++] = pack_xy(xx, yy);
                }
                cur_l = L;
                cur_r = R;
            } else {
                cur_r = max(cur_r, R);
            }
        }
        for (int xx = cur_l; xx <= cur_r && count < LOCS_CAP; ++xx) {
            locs[loc_base + count++] = pack_xy(xx, yy);
        }
    }
    return count;
}

// A pixel can receive one add per selected match of every group whose window
// reaches it: ((2*(BM_RANGE+BS))/STEP + 1)^2 groups times GS matches, so a few
// thousand retries is a safe bound (the same argument as BM3D's res_add).
#endif
void add_acc(int idx, float v) {
#ifndef NO_FLOAT_ATOMICS
    atomicAdd(acc[ACC_BASE + idx], v);
#else
    uint assumed = atomicCompSwap(acc_u[ACC_BASE + idx], 0u, 0u);
    for (uint i = 0u; i < 4096u; ++i) {
        const uint old = atomicCompSwap(
            acc_u[ACC_BASE + idx], assumed,
            floatBitsToUint(uintBitsToFloat(assumed) + v));
        if (old == assumed) {
            return;
        }
        assumed = old;
    }
    atomicCompSwap(acc_u[ACC_BASE + idx], assumed,
                   floatBitsToUint(uintBitsToFloat(assumed) + v));
#endif
}

// Slots are fold-major: slot = fold * NG + group, so one fold is a contiguous
// range and the match kernel can be dispatched for a single centre.
int fold_of(uint slot) {
    return int(slot) / NG;
}

int centre_of(int fold) {
    return clamp(pc.pn - RADIUS + fold, 0, pc.frames - 1);
}

// Layer of the centre frame's first temporal position in this frame's address
// table (which covers 4*RADIUS+1 frames, n-2r..n+2r, for any fold).
int layer_base_of(int fold) {
    return centre_of(fold) - pc.pn + RADIUS;
}

// One reference block. layer_base selects the first frame of the centre frame's
// window in the address table; t_dest is the local temporal index whose patches
// go to this output frame; fold is this centre's position in the fold (the
// estimate slot offset, which can repeat when a clip boundary clamps two folds
// onto the same centre, exactly as the reference's VAggregate does).
void run_group(uint wg, int x, int y, int layer_base, int t_dest, int fold) {
    const int tid = int(gl_LocalInvocationIndex);
    const uint group_base = uint(PMAT_BASE) + wg * uint(PMAT_STRIDE);
    const int loc_base = LOCS_BASE + int(wg) * LOCS_CAP;

    PlaneRef refc = addr.img[ADDR_BASE + layer_base + RADIUS];

    // The group kernel runs at WG threads per reference block, which is fewer
    // than the block's pixels, so the centre block takes a loop.
    for (int i = tid; i < M; i += WG) {
        const int rp = i / BS;
        refblk[i] = refc.v[(y + rp) * STRIDE + x + (i - rp * BS)];
    }
    const int wtop = max(y - BM_RANGE, 0);
    const int wbottom = min(y + BM_RANGE, TEMP_R);
    const int wleft = max(x - BM_RANGE, 0);
    const int wright = min(x + BM_RANGE, TEMP_C);
    const int cx = wright - wleft + 1;
    const int area = (wbottom - wtop + 1) * cx;
    const int kk = max(GS, PS_NUM);

#if defined(NOMATCH)
    {
        // The distance and selection kernels already ran (see ENTRY_DIST /
        // ENTRY_SELECT): load this group's selected matches.
        if (tid == 0) {
            const uint base = uint(MATCH_BASE) + uint(wg) * uint(1 + 2 * GS);
            const int cnt = int(matches[base]);
            top_n = min(cnt, GS);
            for (int i = 0; i < top_n; ++i) {
                top_xy[i] = matches[base + uint(1 + 2 * i)];
                top_t[i] = 0;
            }
        }
        barrier();
    }
#else
    {
        if (tid == 0) {
            fr_n = 0;
        }
        barrier();
        for (int base = 0; base < area; base += TFULL) {
            const int span = min(TFULL, area - base);
            for (int i = tid; i < span; i += WG) {
                const int idx = base + i;
                const int bx = wleft + idx % cx;
                const int by = wtop + idx / cx;
                cand[i] = block_dist_ref(refc, bx, by);
            }
            barrier();
            if (max(GS, PS_NUM) <= SELCAP) {
                fr_tile(span, kk, true, cx, wleft, wtop, loc_base, base);
            } else {
                if (tid == 0) {
                    for (int i = 0; i < span; ++i) {
                        const int idx = base + i;
                        fr_feed(cand[i],
                                pack_xy(wleft + idx % cx, wtop + idx / cx), kk);
                    }
                }
                // The serial feed reads `cand`, which the next tile overwrites;
                // every thread must reach this barrier, not just thread 0.
                barrier();
            }
        }
        if (tid == 0) {
            ctr_n = fr_n;
            for (int i = 0; i < fr_n; ++i) {
                ctr_xy[i] = fr_xy[i];
            }
            top_from_fr(RADIUS);
        }
        barrier();
    
        if (RADIUS > 0) {
            const int active_ps = min(PS_NUM, area);
            for (int dir = -1; dir <= 1; dir += 2) {
                if (tid == 0) {
                    fr_n = ctr_n;
                    for (int i = 0; i < ctr_n; ++i) {
                        fr_xy[i] = ctr_xy[i];
                    }
                }
                barrier();
                for (int i = 1; i <= RADIUS; ++i) {
                    const int t_idx = RADIUS + dir * i;
                    PlaneRef reft = addr.img[ADDR_BASE + layer_base + t_idx];
                    if (tid == 0) {
                        loc_n = generate_locs(int(wg), active_ps, loc_base);
                        fr_n = 0;
                    }
                    barrier();
                    const int nl = loc_n;
                    for (int base = 0; base < nl; base += TFULL) {
                        const int span = min(TFULL, nl - base);
                        for (int c = tid; c < span; c += WG) {
                            const uint l = locs[loc_base + base + c];
                            cand[c] = block_dist_ref(reft, unpack_x(l),
                                                      unpack_y(l));
                        }
                        barrier();
                        if (max(GS, PS_NUM) <= SELCAP) {
                            fr_tile(span, kk, false, cx, wleft, wtop, loc_base,
                                    base);
                        } else {
                            if (tid == 0) {
                                for (int c = 0; c < span; ++c) {
                                    fr_feed(cand[c], locs[loc_base + base + c],
                                            kk);
                                }
                            }
                            // Same as the spatial pass: thread 0 reads `cand`
                            // and the whole workgroup waits here.
                            barrier();
                        }
                    }
                    if (tid == 0) {
                        top_merge(t_idx);
                    }
                    barrier();
                }
            }
        }
    }
    if (tid == 0) {
        top_ensure_center(x, y, RADIUS);
    }
    barrier();
#endif
#if defined(MATCH_ONLY)
    // The estimate runs in the split kernels (ENTRY_GRAM/SOLVE/APPLY): publish
    // this fold's selection into the centre's record, storing the position in
    // the centre's own window so the consumers can rebase it onto their own
    // address tables.
    if (tid == 0) {
        const uint ring = CACHE != 0 ? uint(centre_of(fold)) & uint(RING - 1)
                                 : uint(fold);
        const uint base = uint(MATCH_BASE) +
                          (ring * uint(NG) + wg) * uint(1 + 2 * GS);
        matches[base] = uint(top_n);
        for (int i = 0; i < top_n; ++i) {
            matches[base + uint(1 + 2 * i)] = top_xy[i];
            matches[base + uint(2 + 2 * i)] = uint(top_t[i]);
        }
        if (TRACE != 0) {
            const int tb = TRBASE + (int(wg) * (2 * RADIUS + 1) + fold) * 28;
            trace[tb + 0] = uint(top_n);
            for (int i = 0; i < 8; ++i) {
                trace[tb + 4 + i * 3 + 0] =
                    i < top_n ? floatBitsToUint(top_e[i]) : 0u;
                trace[tb + 4 + i * 3 + 1] = i < top_n ? top_xy[i] : 0u;
                trace[tb + 4 + i * 3 + 2] = i < top_n ? uint(top_t[i]) : 0u;
            }
        }
    }
    return;
#endif
    const int n = top_n;
    if (TRACE != 0 && tid == 0) {
        const int tb = TRBASE + (int(wg) * (2 * RADIUS + 1) + layer_base) * 28;
        trace[tb + 0] = uint(n);
#if defined(NOMATCH)
        trace[tb + 3] = 0u;
#else
        trace[tb + 3] = uint(loc_n);
#endif
        for (int j = 0; j < 8; ++j) {
            trace[tb + 4 + j * 3 + 0] =
                j < n ? floatBitsToUint(top_e[j]) : 0u;
            trace[tb + 4 + j * 3 + 1] = j < n ? top_xy[j] : 0u;
            trace[tb + 4 + j * 3 + 2] = j < n ? uint(top_t[j]) : 0u;
        }
    }

    // Patch matrix: column i is the source pmat of match i, column-major.
    for (int i = 0; i < n; ++i) {
        const uint xy = top_xy[i];
        const int bx = unpack_x(xy);
        const int by = unpack_y(xy);
        PlaneRef s = addr.img[ADDR_BASE + SRC_BASE + layer_base + top_t[i]];
        for (int p = tid; p < M; p += WG) {
            const int py = p / BS;
            const int px = p - py * BS;
            pmat[group_base + uint(i) * uint(M) + uint(p)] =
                s.v[(by + py) * STRIDE + bx + px];
        }
    }
    barrier();
    if (RESIDUAL != 0) {
        // Sequential f32 sum over the group, then divide and subtract, in the
        // reference's subtractMean order.
        for (int p = tid; p < M; p += WG) {
            float sum = 0.0;
            for (int i = 0; i < n; ++i) {
                sum += pmat[group_base + uint(i) * uint(M) + uint(p)];
            }
            const float mean = sum / float(n);
            pmat[group_base + uint(M) * uint(GS) + uint(p)] = mean;
            for (int i = 0; i < n; ++i) {
                pmat[group_base + uint(i) * uint(M) + uint(p)] -= mean;
            }
        }
        barrier();
    }

    // Gram matrix in f64 (fma), one thread per row, element order as the
    // reference's gramAtA / gramAAt.
    const bool tall = n <= M;
    const int q = tall ? n : M;
    if (tid < q) {
        for (int j = tid; j < q; ++j) {
            float accd = float(0);
            if (tall) {
                for (int p = 0; p < M; ++p) {
                    const float a =
                        float(pmat[group_base + uint(tid) * uint(M) + uint(p)]);
                    const float b =
                        float(pmat[group_base + uint(j) * uint(M) + uint(p)]);
                    accd = fma(a, b, accd);
                }
            } else {
                for (int i = 0; i < n; ++i) {
                    const float a =
                        float(pmat[group_base + uint(i) * uint(M) + uint(tid)]);
                    const float b =
                        float(pmat[group_base + uint(i) * uint(M) + uint(j)]);
                    accd = fma(a, b, accd);
                }
            }
            gm[tid * (q + (q & 1)) + j] = accd;
            gm[j * (q + (q & 1)) + tid] = accd;
        }
    }
    barrier();

    // Eigenvectors: identity, then the round-robin parallel Jacobi.
    for (int i = tid; i < (q + (q & 1)) * (q + (q & 1)); i += WG) {
        vt[i] = float(0);
    }
    barrier();
    for (int i = tid; i < q; i += WG) {
        vt[i * (q + (q & 1)) + i] = float(1);
    }
    barrier();
    if ((q & 1) == 0) {
        jacobi_parallel(q, tid);
        // The round-robin rotations accumulate v <- v J, so the eigenvectors
        // are its columns; the sort permutes rows and the reconstruction
        // indexes rows, so transpose the q x q block once.
        {
            const int KQ = q;
            for (int i = tid; i < q * q; i += WG) {
                const int r = i / q;
                const int c = i - r * q;
                if (r < c) {
                    const float t = vt[r * KQ + c];
                    vt[r * KQ + c] = vt[c * KQ + r];
                    vt[c * KQ + r] = t;
                }
            }
        }
    } else if (tid == 0) {
        // Odd group sizes still take the reference's serial rotation order: the
        // round-robin's padded schedule does not converge for them (see the
        // notes' Open work, where it is the next thing to fix).
        jacobi_serial(q);
    }
    barrier();
    if (tid == 0) {
        // Sorted eigenvalues, descending, with the eigenvector rows permuted.
        const int KQ = q + (q & 1);
        for (int i = 0; i < q; ++i) {
            eig[i] = max(gm[i * KQ + i], float(0));
        }
        for (int i = 0; i < q; ++i) {
            int best = i;
            for (int j = i + 1; j < q; ++j) {
                if (eig[j] > eig[best]) {
                    best = j;
                }
            }
            if (best != i) {
                const float tmp = eig[i];
                eig[i] = eig[best];
                eig[best] = tmp;
                for (int r2 = 0; r2 < q; ++r2) {
                    const float t2 = vt[i * KQ + r2];
                    vt[i * KQ + r2] = vt[best * KQ + r2];
                    vt[best * KQ + r2] = t2;
                }
            }
        }
        // Shrink factors, c = ((8*sqrt(2n))*sigma)*sigma in f32 then widened.
        const float c =
            ((8.0f * sqrt(2.0f * float(n))) * SIGMA) * SIGMA;
        const int k0 = RESIDUAL != 0 ? 0 : 1;
        int i = min(k0, q);
        for (int ii = 0; ii < i; ++ii) {
            shr[ii] = 1.0f;
        }
        for (; i < q; ++i) {
            const float lam = eig[i];
            const float tmp = lam - float(c);
            if (!(tmp > float(0))) {
                break;
            }
            const float s = sqrt(lam);
            const float sp = (s + sqrt(tmp)) * float(0.5);
            shr[i] = float(sp / s);
        }
        kept = i;
        for (int ii = i; ii < q; ++ii) {
            shr[ii] = 0.0f;
        }
        weight = (ADAPTIVE != 0 && kept > 0) ? 1.0f / float(kept) : 1.0f;
        if (TRACE != 0) {
            const int tb = TRBASE + (int(wg) * (2 * RADIUS + 1) + layer_base) * 28;
            trace[tb + 1] = uint(kept);
            trace[tb + 2] = floatBitsToUint(weight);
        }
    }
    barrier();

    // M = V diag(r) V^T in f32, applied to the pmat columns in the scatter.
    for (int idx = tid; idx < q * q; idx += WG) {
        const int a = idx / q;
        const int b = idx - a * q;
        float s = 0.0f;
        const int KQ = q + (q & 1);
        for (int i = 0; i < kept; ++i) {
            s += float(vt[i * KQ + a]) * shr[i] * float(vt[i * KQ + b]);
        }
        mm[idx] = s;
    }
    barrier();

    const float wgt = weight;
    for (int j = 0; j < n; ++j) {
        if (RADIUS > 0 && top_t[j] != t_dest) {
            continue;
        }
        const uint xy = top_xy[j];
        const int bx = unpack_x(xy);
        const int by = unpack_y(xy);
        for (int p = tid; p < M; p += WG) {
            float s = 0.0f;
            if (tall) {
                for (int k2 = 0; k2 < n; ++k2) {
                    s += pmat[group_base + uint(k2) * uint(M) + uint(p)] *
                         mm[k2 * q + j];
                }
            } else {
                for (int pp = 0; pp < q; ++pp) {
                    s += mm[p * q + pp] *
                         pmat[group_base + uint(j) * uint(M) + uint(pp)];
                }
            }
            if (RESIDUAL != 0) {
                s += pmat[group_base + uint(M) * uint(GS) + uint(p)];
            }
            const int py = p / BS;
            const int px = p - py * BS;
            const int o = (by + py) * W + bx + px;
            add_acc(o, s * wgt);
            add_acc(W * H + o, wgt);
        }
    }
    barrier();
}

// ---------------------------------------------------------------------------
// Split estimate (radius 0, group_size <= 8)
// ---------------------------------------------------------------------------
// Three kernels instead of one, so every phase runs at the width its work
// needs: the Gram and the scatter are eight-lane per group and read the image
// as consecutive words, and the eigen step is one thread per group with the
// Gram matrix, the eigenvectors and every rotation index in registers.
#if defined(ENTRY_GRAM) || defined(ENTRY_SOLVE) || defined(ENTRY_APPLY)
// Per-group scratch: the Gram matrix at [0,64), the per-pixel mean at
// [64,64+M) when residual strips it, then the aggregation weight (at 64+M, or
// 128 with the reserved 64-float slot when it does not). The host sizes
// PMAT_STRIDE from the same expression (split_stride in src/wnnm.cpp).
#define MAT_MEAN 64
#define MAT_WEIGHT (RESIDUAL != 0 ? (64 + M) : 128)

// The per-group match record of a slot. The cache keys records by centre frame,
// so the frames that consume the same centre read the same record; without it
// each fold owns a record for this output frame alone.
uint match_rec(uint slot) {
    const int fold = fold_of(slot);
    const uint ring = CACHE != 0 ? uint(centre_of(fold)) & uint(RING - 1)
                                 : uint(fold);
    return uint(MATCH_BASE) +
           (ring * uint(NG) + uint(int(slot) - fold * NG)) *
               uint(1 + 2 * GS);
}

// Patch count of a slot's record.
uint match_count(uint slot) {
    return matches[match_rec(slot)];
}

// Offset of the group's match `j` from its plane base. j >= n means the group
// has fewer columns and this one contributes zero.
int match_off(uint slot, int j, int n) {
    if (j >= n) {
        return 0;
    }
    const uint xy = matches[match_rec(slot) + uint(1 + 2 * j)];
    return unpack_y(xy) * STRIDE + unpack_x(xy);
}

// The same match's offset in the packed accumulator, whose row stride is W.
int match_out(uint slot, int j, int n) {
    if (j >= n) {
        return 0;
    }
    const uint xy = matches[match_rec(slot) + uint(1 + 2 * j)];
    return unpack_y(xy) * W + unpack_x(xy);
}

// Source layer of match `j` in this frame's address table. The record stores
// the position in the centre's own window, which is what lets a cached centre
// serve a frame whose table starts elsewhere; the spatial select stores 0.
int match_layer(uint slot, int j, int n) {
    if (j >= n || RADIUS == 0) {
        return 0;
    }
    return layer_base_of(fold_of(slot)) +
           int(matches[match_rec(slot) + uint(2 + 2 * j)]);
}

// Estimate slots: one per (lattice point, temporal fold). RADIUS is a spec
// constant, so this folds to NG for the spatial case.
uint est_count() {
    return uint(NG) * uint(2 * RADIUS + 1);
}

// The temporal fold a slot belongs to hands the output frame only the patches
// of one slab (the reference's VAggregate fold); negated, = no filter, which is
// the whole spatial case. Both indices are the same expressions the fused
// kernel uses for its fold loop.
int fold_dest(uint slot) {
    if (RADIUS == 0) {
        return -1;
    }
    const int i = fold_of(slot);
    const int slab = clamp(2 * RADIUS - i, pc.pn - pc.frames + 1 + RADIUS,
                           pc.pn + RADIUS);
    return layer_base_of(i) + slab;
}
#endif

#if defined(ENTRY_GRAM)
// One row of the lane's outer-product sum: element (I, J) is the product of
// patch I and patch J at that pixel. I and J are literals so ga stays in
// registers.
#define GROW(I)                                                               \
    ga[(I) * 8 + 0] = fma(v[(I)], v[0], ga[(I) * 8 + 0]);                     \
    ga[(I) * 8 + 1] = fma(v[(I)], v[1], ga[(I) * 8 + 1]);                     \
    ga[(I) * 8 + 2] = fma(v[(I)], v[2], ga[(I) * 8 + 2]);                     \
    ga[(I) * 8 + 3] = fma(v[(I)], v[3], ga[(I) * 8 + 3]);                     \
    ga[(I) * 8 + 4] = fma(v[(I)], v[4], ga[(I) * 8 + 4]);                     \
    ga[(I) * 8 + 5] = fma(v[(I)], v[5], ga[(I) * 8 + 5]);                     \
    ga[(I) * 8 + 6] = fma(v[(I)], v[6], ga[(I) * 8 + 6]);                     \
    ga[(I) * 8 + 7] = fma(v[(I)], v[7], ga[(I) * 8 + 7]);
#define GZ4(I)                                                                \
    ga[(I) + 0] = 0.0;                                                        \
    ga[(I) + 1] = 0.0;                                                        \
    ga[(I) + 2] = 0.0;                                                        \
    ga[(I) + 3] = 0.0;
// Sum the eight lanes' partial matrices.
#define GRED(E)                                                               \
    ga[(E)] += subgroupShuffleXor(ga[(E)], 1);                                \
    ga[(E)] += subgroupShuffleXor(ga[(E)], 2);                                \
    ga[(E)] += subgroupShuffleXor(ga[(E)], 4);
#define GST(E) pmat[gbase + uint(E)] = ga[(E)];
#endif

#if defined(ENTRY_APPLY)
// Output column J of one pixel: the 8-term dot product with that column of M,
// the mean back, and the weighted scatter of both the estimate and the weight.
#define ADOT(J, O, U)                                                         \
    if ((J) < an && (U)) {                                                           \
        const float ad =                                                     \
            fma(a7, am[56 + (J)], fma(a6, am[48 + (J)], fma(a5, am[40 + (J)],  \
                fma(a4, am[32 + (J)], fma(a3, am[24 + (J)],                   \
