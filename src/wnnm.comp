    MROW(2, f0, f1, f2, f3, f4, f5, f6, f7)
    MROW(3, f0, f1, f2, f3, f4, f5, f6, f7)
    MROW(4, f0, f1, f2, f3, f4, f5, f6, f7)
    MROW(5, f0, f1, f2, f3, f4, f5, f6, f7)
    MROW(6, f0, f1, f2, f3, f4, f5, f6, f7)
