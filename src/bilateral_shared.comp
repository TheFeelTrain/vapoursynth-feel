#version 450
#extension GL_EXT_shader_16bit_storage : require

/*
 * Bilateral filter compute shader, shared-memory (tiled) variant.
 *
 * Compile-time variants: -DIO_U16 / -DIO_F16 / -DIO_F32 select the element
 * type. Each plane is bound whole into its own binding: src is the filtered
 * source, ref the guide (bound to src when HAS_REF is 0) and dst the output
 * frame plane. All three hold native elements, so loads and stores are plain
 * coalesced accesses — no shift/mask unpacking, no dword packing, no atomics.
 *
 * -DCOLS2 additionally gives each thread two adjacent output columns. Their
 * windows overlap in 2R of 2R+1 columns, so a row is read once for both
 * accumulations (2R+2 tile reads instead of 2*(2R+1)). The host pairs it with
 * twice the tile width and half the grid, and falls back to the one-column
 * form (this file without -DCOLS2) where the wider tile does not fit. The
 * per-tap predicate that skips the second column is kept at the store, never
 * in the loop: as a per-tap select it cost 13 of the kernel's 16 points
 * (`notes/BILATERAL.md`).
 *
 * A half element is a storage width, not a precision: it widens exactly on
 * load and narrows once on store (OpFConvert, the SPIR-V default round to
 * nearest even, i.e. vszipcl's vstore_half_rte), while the LDS tile and the
 * tap arithmetic stay f32. Half LDS, half arithmetic and a half accumulator
 * were all measured slower on this code shape (`notes/BILATERAL.md`).
 *
 * WIDTH/HEIGHT/STRIDE/RADIUS/... are specialization constants so that the
 * compiler can fully unroll the tile-load loops and constant-fold all
 * clamping/indexing. STRIDE is the core's plane pitch in elements; only
 * [0, WIDTH) columns and [0, HEIGHT) rows are meaningful.
 */

#if !defined(IO_U16) && !defined(IO_F32) && !defined(IO_F16)
#define IO_U16 1
#endif

#if defined(IO_U16)
#define IO_TYPE uint16_t
#define PEAK       65535.0f
#define SCALE      (1.0f / 65535.0f)
#elif defined(IO_F16)
#define IO_TYPE float16_t
#define PEAK       1.0f
#define SCALE      1.0f
#else
#define IO_TYPE float
#define PEAK       1.0f
#define SCALE      1.0f
#endif

layout(constant_id = 0) const int WIDTH = 1920;
layout(constant_id = 1) const int HEIGHT = 1080;
layout(constant_id = 2) const int STRIDE = 1920;
layout(constant_id = 3) const float SIGMA_SPATIAL_SCALED = 0.0;
layout(constant_id = 4) const float SIGMA_COLOR_SCALED = 0.0;
layout(constant_id = 5) const int RADIUS = 9;
layout(constant_id = 6) const int HAS_REF = 0;
layout(constant_id = 7) const int TILE_X = 34;
layout(constant_id = 8) const int TILE_Y = 26;
layout(constant_id = 9) const int SHARED_FLOATS = 884;

layout(local_size_x_id = 10, local_size_y_id = 11, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SrcBuf { IO_TYPE src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { IO_TYPE dst[]; };
layout(std430, binding = 2) readonly buffer RefBuf { IO_TYPE ref[]; };

shared float buf[SHARED_FLOATS];

float load_src(int idx) {
#if defined(IO_F32)
    return src[idx];
#elif defined(IO_F16)
    return float(src[idx]);   // half -> float is exact
#else
    // direct uint16_t->float conversion chokes glslc; int() widens cleanly
    return float(int(src[idx])) * SCALE;
#endif
}

float load_ref(int idx) {
#if defined(IO_F32)
    return ref[idx];
#elif defined(IO_F16)
    return float(ref[idx]);
#else
    return float(int(ref[idx])) * SCALE;
#endif
}

void store_value(int idx, float v) {
#if defined(IO_F32)
    dst[idx] = v;
#elif defined(IO_F16)
    // OpFConvert narrows with the SPIR-V default round-to-nearest-even and no
    // saturation, i.e. the reference's vstore_half_rte
    dst[idx] = float16_t(v);
#else
    // glslc -O chokes on a direct float->uint16_t convert (OpUConvert); go
    // through uint with an explicit mask (same workaround as nlmeans/dfttest)
    dst[idx] = uint16_t(uint(v * PEAK + 0.5f) & 0xFFFFu);
#endif
}

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);
#if defined(COLS2)
    // Two adjacent output columns per thread. Their windows overlap in 2R of
    // 2R+1 columns, so one tile read per (row, tap) feeds both accumulations:
    // the LDS load count per output halves, and the scheduler gets two
    // independent exp2/accumulate streams.
    const int gx0 = int(gl_WorkGroupID.x) * (2 * int(gl_WorkGroupSize.x));
    const int x = gx0 + 2 * tx;
#else
    const int x = int(gl_GlobalInvocationID.x);
    const int gx0 = x - tx;
#endif
    const int y = int(gl_GlobalInvocationID.y);

    // the guide tile sits above the source tile; with no guide the source tile
    // is what both the weight and the value read
    const int ref_offset = HAS_REF * TILE_Y * TILE_X;

    // tile column 0 covers plane column gx0 - RADIUS
    for (int cy = ty; cy < TILE_Y; cy += int(gl_WorkGroupSize.y)) {
        const int sy = clamp(cy - ty - RADIUS + y, 0, HEIGHT - 1);
        for (int cx = tx; cx < TILE_X; cx += int(gl_WorkGroupSize.x)) {
            const int sx = clamp(gx0 - RADIUS + cx, 0, WIDTH - 1);
            buf[cy * TILE_X + cx] = load_src(sy * STRIDE + sx);
        }
    }
    if (HAS_REF == 1) {
        for (int cy = ty; cy < TILE_Y; cy += int(gl_WorkGroupSize.y)) {
            const int sy = clamp(cy - ty - RADIUS + y, 0, HEIGHT - 1);
            for (int cx = tx; cx < TILE_X; cx += int(gl_WorkGroupSize.x)) {
                const int sx = clamp(gx0 - RADIUS + cx, 0, WIDTH - 1);
                buf[ref_offset + cy * TILE_X + cx] = load_ref(sy * STRIDE + sx);
            }
        }
    }
    barrier();

    if (x >= WIDTH || y >= HEIGHT) {
        return;
    }

#if defined(COLS2)
    const int cx0 = RADIUS + 2 * tx;
    const float center0 = buf[ref_offset + (RADIUS + ty) * TILE_X + cx0];
    const float center1 = buf[ref_offset + (RADIUS + ty) * TILE_X + cx0 + 1];
    const bool second = (x + 1) < WIDTH;

    float num0 = 0.0f, den0 = 0.0f;
    float num1 = 0.0f, den1 = 0.0f;

    for (int cy = -RADIUS; cy <= RADIUS; ++cy) {
        const int sy = cy + RADIUS + ty;
        const int row = sy * TILE_X + cx0 - RADIUS;
        // k indexes the 2R+2 columns spanning both windows; the k<=2R and k>=1
        // tests fold, and each value is read once for the two outputs
        for (int k = 0; k <= 2 * RADIUS + 1; ++k) {
            const float gvalue = buf[ref_offset + row + k];
            const float value = (HAS_REF == 1) ? buf[row + k] : gvalue;
            if (k <= 2 * RADIUS) {
                const int space0 = cy * cy + (k - RADIUS) * (k - RADIUS);
                const float range0 = (gvalue - center0) * (gvalue - center0);
                const float weight0 = exp2(
                    float(space0) * SIGMA_SPATIAL_SCALED +
                    range0 * SIGMA_COLOR_SCALED);
                num0 += weight0 * value;
                den0 += weight0;
            }
            if (k >= 1) {
                const int d1 = k - 1 - RADIUS;
                const int space1 = cy * cy + d1 * d1;
                const float range1 = (gvalue - center1) * (gvalue - center1);
                const float weight1 = exp2(
                    float(space1) * SIGMA_SPATIAL_SCALED +
                    range1 * SIGMA_COLOR_SCALED);
                num1 += weight1 * value;
                den1 += weight1;
            }
        }
    }

    store_value(y * STRIDE + x, num0 / den0);
    if (second) {
        store_value(y * STRIDE + x + 1, num1 / den1);
    }
#else
    const float center = buf[ref_offset + (RADIUS + ty) * TILE_X + RADIUS + tx];

    float num = 0.0f;
    float den = 0.0f;

    for (int cy = -RADIUS; cy <= RADIUS; ++cy) {
        const int sy = cy + RADIUS + ty;
        for (int cx = -RADIUS; cx <= RADIUS; ++cx) {
            const int sx = cx + RADIUS + tx;
            float value = buf[ref_offset + sy * TILE_X + sx];
            const int space = cy * cy + cx * cx;
            const float range = (value - center) * (value - center);
            const float weight = exp2(
                float(space) * SIGMA_SPATIAL_SCALED + range * SIGMA_COLOR_SCALED);
            if (HAS_REF == 1) {
                value = buf[sy * TILE_X + sx];
            }
            num += weight * value;
            den += weight;
        }
    }

    store_value(y * STRIDE + x, num / den);
#endif
}
