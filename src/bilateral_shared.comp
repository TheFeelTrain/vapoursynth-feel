#version 450

/*
 * Bilateral filter compute shader, shared-memory (tiled) variant.
 *
 * Compile-time variants: -DBITS=16|32 selects the staging element type.
 * The staging buffer holds the raw VapourSynth plane bytes (uint16
 * integer or float32), and this kernel performs the format conversion
 * itself, so the host side only memcpys raw bytes.
 *
 * All parameters are specialization constants so that the compiler can
 * fully unroll the (2*RADIUS+1)^2 inner loop and constant-fold all
 * clamping/indexing.
 *
 * Memory layout (per plane region, raw bytes):
 *   rows [0, HEIGHT)            : source plane
 *   rows [HEIGHT, 2*HEIGHT)     : reference plane (only if HAS_REF)
 *   rows are STRIDE elements wide (only WIDTH are meaningful)
 */

#if !defined(BITS)
#define BITS 16
#endif

#if BITS == 16
#define ELEM_BYTES 2
#define ELEM_MASK  0xFFFFu
#define PEAK       65535.0f
#define SCALE      (1.0f / 65535.0f)
#else
#define ELEM_BYTES 4
#define ELEM_MASK  0xFFFFFFFFu
#define PEAK       1.0f
#define SCALE      1.0f
#endif

#define ELEM_SHIFT(byte) (8 * ((byte) & 3))

layout(constant_id = 0) const int WIDTH = 1920;
layout(constant_id = 1) const int HEIGHT = 1080;
layout(constant_id = 2) const int STRIDE = 1920;
layout(constant_id = 3) const float SIGMA_SPATIAL_SCALED = 0.0;
layout(constant_id = 4) const float SIGMA_COLOR_SCALED = 0.0;
layout(constant_id = 5) const int RADIUS = 9;
layout(constant_id = 6) const int HAS_REF = 0;
layout(constant_id = 7) const int TILE_X = 34;
layout(constant_id = 8) const int TILE_Y = 26;
layout(constant_id = 9) const int SHARED_FLOATS = 884;

layout(local_size_x_id = 10, local_size_y_id = 11, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SrcBuf { uint src_raw[]; };
layout(std430, binding = 1) buffer DstBuf { uint dst_raw[]; };

layout(push_constant) uniform PushConstants {
    int src_base;  // byte offset of this plane's source region
    int dst_base;  // byte offset of this plane's download region
} pc;

shared float buf[SHARED_FLOATS];
shared float out_tile[TILE_X * TILE_Y];

uint load_raw(int idx) {
    int byte = idx * ELEM_BYTES;
    uint word = src_raw[(pc.src_base + byte) >> 2];
    return (word >> ELEM_SHIFT(byte)) & ELEM_MASK;
}

float load_value(int idx) {
#if BITS == 32
    return uintBitsToFloat(load_raw(idx));
#else
    return float(load_raw(idx)) * SCALE;
#endif
}

void store_value(int idx, float v) {
    int byte = idx * ELEM_BYTES;
    int wi = (pc.dst_base + byte) >> 2;
#if BITS == 32
    dst_raw[wi] = floatBitsToUint(v);
#else
    dst_raw[wi] = v < 0.0f ? 0u : uint(v * PEAK + 0.5f);
#endif
}

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);

    const int ref_offset = HAS_REF * TILE_Y * TILE_X;

    for (int cy = ty; cy < TILE_Y; cy += int(gl_WorkGroupSize.y)) {
        const int sy = clamp(cy - ty - RADIUS + y, 0, HEIGHT - 1);
        for (int cx = tx; cx < TILE_X; cx += int(gl_WorkGroupSize.x)) {
            const int sx = clamp(cx - tx - RADIUS + x, 0, WIDTH - 1);
            buf[cy * TILE_X + cx] = load_value(sy * STRIDE + sx);
        }
    }
    if (HAS_REF == 1) {
        for (int cy = ty; cy < TILE_Y; cy += int(gl_WorkGroupSize.y)) {
            const int sy = clamp(cy - ty - RADIUS + y, 0, HEIGHT - 1);
            for (int cx = tx; cx < TILE_X; cx += int(gl_WorkGroupSize.x)) {
                const int sx = clamp(cx - tx - RADIUS + x, 0, WIDTH - 1);
                buf[ref_offset + cy * TILE_X + cx] = load_value((HEIGHT + sy) * STRIDE + sx);
            }
        }
    }
    barrier();

    if (x >= WIDTH || y >= HEIGHT) {
        return;
    }

    const float center = buf[ref_offset + (RADIUS + ty) * TILE_X + RADIUS + tx];

    float num = 0.0f;
    float den = 0.0f;

    for (int cy = -RADIUS; cy <= RADIUS; ++cy) {
        const int sy = cy + RADIUS + ty;
        for (int cx = -RADIUS; cx <= RADIUS; ++cx) {
            const int sx = cx + RADIUS + tx;
            float value = buf[ref_offset + sy * TILE_X + sx];
            const int space = cy * cy + cx * cx;
            const float range = (value - center) * (value - center);
            const float weight = exp2(
                float(space) * SIGMA_SPATIAL_SCALED + range * SIGMA_COLOR_SCALED);
            if (HAS_REF == 1) {
                value = buf[sy * TILE_X + sx];
            }
            num += weight * value;
            den += weight;
        }
    }

    // deposit the result into the output tile, then let the packing lane
    // write complete dwords (pairs for 16-bit) so no pre-clearing of the
    // download region is required
    out_tile[ty * TILE_X + tx] = num / den;
    barrier();

#if BITS == 32
    store_value(y * STRIDE + x, num / den);
#else
    const int PACK = 4 / ELEM_BYTES;   // 2 for 16-bit
    if ((x & (PACK - 1)) == 0) {
        uint packed = 0;
        for (int k = 0; k < PACK; ++k) {
            const float out_val = (x + k < WIDTH && tx + k < TILE_X)
                ? out_tile[ty * TILE_X + tx + k] : 0.0f;
            const uint val = out_val < 0.0f ? 0u : uint(out_val * PEAK + 0.5f);
            packed |= (val & ELEM_MASK) << (8 * ELEM_BYTES * k);
        }
        int byte = (y * STRIDE + x) * ELEM_BYTES;
        dst_raw[(pc.dst_base + byte) >> 2] = packed;
    }
#endif
}
