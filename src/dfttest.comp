// ---------------------------------------------------------------------------
// IO helpers (source frame planes)
//
// Every loader returns the internal f32 working value (the sample scaled by
// SCALE), so the fused kernel is IO-type agnostic.
// ---------------------------------------------------------------------------

// Sample `sample_idx` of temporal slice `t`'s padded plane. The padded plane is
// a lossless copy of the source (u16/f16 round-trip exactly, f32 keeps its
// bits), so this is bit-identical to reading the source plane directly.
float load_fused(int t, int sample_idx) {
#if defined(IO_U16)
    return float(int(padded16[t * pc.pad_slice + sample_idx])) * SCALE;
#elif defined(IO_F16)
    // half -> float is exact, and the *255 is exact in f32 as well
    return float(padded16[t * pc.pad_slice + sample_idx]) * SCALE;
#else
    return uintBitsToFloat(padded_raw[t * pc.pad_slice + sample_idx]) * SCALE;
#endif
}

// Sample `sample_idx` of temporal slice `t`'s source frame plane (row stride in
// elements). t is always the compile-time slice number of the pad kernel's
// unrolled slice loop, so the descriptor array index folds away.
float load_src(int t, int sample_idx) {
#if defined(IO_U16)
    return float(int(src_bufs[t].src16[sample_idx])) * SCALE;
#elif defined(IO_F16)
    return float(src_bufs[t].src16[sample_idx]) * SCALE;
#else
    return uintBitsToFloat(src_bufs[t].src_raw[sample_idx]) * SCALE;
#endif
}

// pad writes one sample of slice t into the padded plane
void store_padded(int t, int sample_idx, float v) {
#if defined(IO_U16)
    float x = v / SCALE;
    x = clamp(x + 0.5, 0.0, PEAK);
    padded16[t * pc.pad_slice + sample_idx] = uint16_t(uint(x) & ELEM_MASK);
#elif defined(IO_F16)
    padded16[t * pc.pad_slice + sample_idx] = float16_t(v / SCALE);
#else
    padded_raw[t * pc.pad_slice + sample_idx] = floatBitsToUint(v / SCALE);
#endif
}

// col2im writes the output frame plane directly
void store_sample(int sample_idx, float v) {
#if defined(IO_U16)
    float x = v / SCALE;
    x = clamp(x + 0.5, 0.0, PEAK);
    dst16[(pc.dst_base >> 1) + sample_idx] = uint16_t(uint(x) & ELEM_MASK);
#elif defined(IO_F16)
    // OpFConvert narrows to half with round-to-nearest-even, the same rounding
    // a half clip stores with; no clamp (half covers the whole range)
    dst16[(pc.dst_base >> 1) + sample_idx] = float16_t(v / SCALE);
#else
    int byte = pc.dst_base + sample_idx * ELEM_BYTES;
    dst_raw[byte >> 2] = floatBitsToUint(v / SCALE);
#endif
}


// ---------------------------------------------------------------------------
// Frequency-domain filter (matches the reference generated filter())
// ---------------------------------------------------------------------------

// binbase is the bin's y*9 + x slot in the per-slice sigma table
void filter_value(inout float re, inout float im, int binbase, int t) {
    float sigma;
    if (pc.sigma_base < 0) {
        sigma = pc.sigma;
    } else {
        sigma = wt[pc.sigma_base + t * 144 + binbase];
    }
    float sigma2 = pc.sigma2;
    float pmin = pc.pmin;
    float pmax = pc.pmax;
    float beta = pc.beta;
    float multiplier = 0.0;

    if (FILTER_TYPE == 2) {
        re *= sigma;
        im *= sigma;
        return;
    }

    float psd = re * re + im * im;

    if (FILTER_TYPE == 1) {
        if (psd < sigma) {
            re = 0.0;
            im = 0.0;
        }
        return;
    } else if (FILTER_TYPE == 3) {
        if (psd >= pmin && psd <= pmax) {
            multiplier = sigma;
        } else {
            multiplier = sigma2;
        }
    } else {
        float x0 = max((psd - sigma) / (psd + 1e-15), 0.0);
        if (FILTER_TYPE == 4) {
            multiplier = sigma * sqrt(psd * (pmax / ((psd + pmin) * (psd + pmax) + 1e-15)));
        } else if (FILTER_TYPE == 5) {
            multiplier = pow(x0, beta);
        } else if (FILTER_TYPE == 6) {
            multiplier = sqrt(x0);
        } else {
            multiplier = x0;
        }
    }

    re *= multiplier;
    im *= multiplier;
}

// One block's transformed cube is 9 x-bins x 16 y-bins x TW slices, but only
// 9 of the 16 lanes own an x-bin, so it used to live in 32*TW floats per lane
// (224 at TW=7) -- past the register budget, which made ACO spill it and cost
// radius 2/3 most of their throughput. Every lane now holds 9 bins of the cube
// (144 bins / 16 lanes), so a lane's cube is 18*TW floats, and the y-bins the
// worker lanes do not keep are exchanged through the transpose buffer once per
// slice.
//
//   cube:      d[(k * TW + t) * 2 + {0,1}]   this lane's bin k, slice t
//   transient: d[TB .. TB+31]                per-slice spatial working set
//
// Ownership: lanes 0..8 keep their own x-bin's y = 0..8, lanes 9..15 take one
// whole y-bin out of the pool (y = lane, x = k). Both halves of the table
// index (y*9 + x) then need a single select and no division.
#define BIN_BASE(k) ((lane < 9) ? ((k) * 9 + lane) : (lane * 9 + (k)))

// Manual unrolls (register pressure fix): every bin's temporal codelet runs at
// its own constant base, so the cube stays in registers.
#define TD_DFT_0(d) dft1(d,0,1); dft1(d,2,1); dft1(d,4,1); dft1(d,6,1); dft1(d,8,1); dft1(d,10,1); dft1(d,12,1); dft1(d,14,1); dft1(d,16,1);
