#define TD_IDFT_1(d) idft3(d,0,1); idft3(d,6,1); idft3(d,12,1); idft3(d,18,1); idft3(d,24,1); idft3(d,30,1); idft3(d,36,1); idft3(d,42,1); idft3(d,48,1);
#define TD_IDFT_2(d) idft5(d,0,1); idft5(d,10,1); idft5(d,20,1); idft5(d,30,1); idft5(d,40,1); idft5(d,50,1); idft5(d,60,1); idft5(d,70,1); idft5(d,80,1);
#define TD_IDFT_3(d) idft7(d,0,1); idft7(d,14,1); idft7(d,28,1); idft7(d,42,1); idft7(d,56,1); idft7(d,70,1); idft7(d,84,1); idft7(d,98,1); idft7(d,112,1);
