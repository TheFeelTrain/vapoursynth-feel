// ---------------------------------------------------------------------------
// pad: reflection-pad the tight upload rows into the device-local padded buffer
// (single-fold mirror, identical to the reference's reflect_pad kernel and the
// previous host-side reflection_padding_impl)
// ---------------------------------------------------------------------------

#if defined(ENTRY_PAD)

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int ph = calc_pad_size(pc.height, pc.block_step);
    const int pad_x = (pw - pc.width) / 2;
    const int pad_y = (ph - pc.height) / 2;
    const int tw = 2 * pc.radius + 1;
    const int up_slice = pc.height * pc.src_stride;
    const int pad_slice = pw * ph;

    for (int y = int(gl_GlobalInvocationID.y); y < ph; y += int(gl_NumWorkGroups.y) * 8) {
        for (int x = int(gl_GlobalInvocationID.x); x < pw; x += int(gl_NumWorkGroups.x) * 32) {
            int sx = x - pad_x;
            int sy = y - pad_y;
            sx = sx < 0 ? -sx : (sx >= pc.width ? 2 * (pc.width - 1) - sx : sx);
            sy = sy < 0 ? -sy : (sy >= pc.height ? 2 * (pc.height - 1) - sy : sy);
            for (int t = 0; t < tw; ++t) {
                const uint raw = load_upload(t * up_slice + sy * pc.src_stride + sx);
                store_padded(t * pad_slice + y * pw + x, to_float(raw));
            }
        }
    }
}

#endif // ENTRY_PAD

// ---------------------------------------------------------------------------
// fused: im2col + 3D DFT + filter + inverse + center-slice col
// One 16x16 block per workgroup; the 16 invocations act as the 16 lanes of
// the reference warp (the HIPRTC backend's 32-lane block with 16 active
// lanes, workgroup barriers in place of warp shuffles).
// ---------------------------------------------------------------------------

#if defined(ENTRY_FUSED)

#ifndef SUB_BLOCKS
#define SUB_BLOCKS 8   // blocks processed per workgroup (8 * 16 = 128 threads, 2 wave64 on RDNA)
#endif

shared float trans[SUB_BLOCKS * 2 * 16 * TSTRIDE];
shared float s_gf[SUB_BLOCKS];

layout(local_size_x = SUB_BLOCKS * 16, local_size_y = 1, local_size_z = 1) in;
void main() {
    const int lane = int(gl_LocalInvocationIndex) & 15;
    const int sub = int(gl_LocalInvocationIndex) >> 4;
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int ph = calc_pad_size(pc.height, pc.block_step);
    const int hn = calc_pad_num(pc.width, pc.block_step);
    const int vn = calc_pad_num(pc.height, pc.block_step);
    const int num_blocks = hn * vn;
    const int tw = TW;
    const int tsub = sub * 2 * 16 * TSTRIDE;

    for (int block_id = int(gl_WorkGroupID.x) * SUB_BLOCKS + sub;
         block_id < num_blocks;
         block_id += int(gl_NumWorkGroups.x) * SUB_BLOCKS) {
        const int ix = block_id % hn;
        const int iy = block_id / hn;

        float td[TD_SZ];
        for (int i = 0; i < TD_SZ; ++i) {
            td[i] = 0.0;
        }

        // im2col
        IM2COL_ALL(td);

        // per-slice
        SPATIAL_ALL(td);

        // temporal dft across the slices
        if (lane < 9) {
            TD_DFT_ALL(td);
        }

        // zero-mean: DC gain broadcast from lane 0
        if (ZMEAN != 0) {
            if (lane == 0) {
                s_gf[sub] = td[0] / wt[pc.wf_base];
            }
        }
        subgroupBarrier();
        float gf = 0.0;
        if (ZMEAN != 0) {
            gf = s_gf[sub];
        }

        if (lane < 9) {
            // frequency filtering
            FILTER_ALL(td);
            // temporal idft
            TD_IDFT_ALL(td);
        }

        // inverse y-transform of the center slice + transpose back to rows
        const int cbase = RADIUS * 32;
        subgroupBarrier();
        if (lane < 9) {
            idft16(td, cbase, 1);
            for (int j = 0; j < 16; ++j) {
                trans[tsub + 2 * (j * TSTRIDE + lane) + 0] = td[cbase + 2 * j];
                trans[tsub + 2 * (j * TSTRIDE + lane) + 1] = td[cbase + 2 * j + 1];
            }
        }
        subgroupBarrier();
        for (int j = 0; j < 9; ++j) {
            td[cbase + 2 * j] = trans[tsub + 2 * (lane * TSTRIDE + j) + 0];
            td[cbase + 2 * j + 1] = trans[tsub + 2 * (lane * TSTRIDE + j) + 1];
        }
        irdft16(td, cbase);
        subgroupBarrier();
        // transpose store of the row data (irdft emits the sequence reversed)
        for (int j = 0; j < 16; ++j) {
            trans[tsub + 2 * (j * TSTRIDE + lane) + 0] = td[cbase + (j == 0 ? 0 : 16 - j)];
        }
        subgroupBarrier();
        // write the block's center slice into the spatial buffer
        const int dst_base = pc.spatial_base + block_id * 256;
        for (int j = 0; j < 16; ++j) {
            spatial[dst_base + j * 16 + lane] = trans[tsub + 2 * (lane * TSTRIDE + j) + 0];
        }
    }
}

#endif // ENTRY_FUSED

// ---------------------------------------------------------------------------
// col2im: overlap-add the windowed blocks back into the final plane
// ---------------------------------------------------------------------------

#if defined(ENTRY_COL2IM)

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int ph = calc_pad_size(pc.height, pc.block_step);
            const int hn = calc_pad_num(pc.width, pc.block_step);
            const int vn = calc_pad_num(pc.height, pc.block_step);
            const int pad_x = (pw - pc.width) / 2;
    const int pad_y = (ph - pc.height) / 2;

    for (int y = int(gl_GlobalInvocationID.y); y < ph; y += int(gl_NumWorkGroups.y) * 8) {
        for (int x = int(gl_GlobalInvocationID.x); x < pw; x += int(gl_NumWorkGroups.x) * 32) {
            if (y < pad_y || y >= pad_y + pc.height || x < pad_x || x >= pad_x + pc.width) {
                continue;
            }

            float sum = 0.0;
            const int i1 = (y - 16 + pc.block_step) / pc.block_step;
            const int i2 = min(y / pc.block_step, vn - 1);
            const int j1 = (x - 16 + pc.block_step) / pc.block_step;
            const int j2 = min(x / pc.block_step, hn - 1);

            for (int i = i1; i <= i2; ++i) {
                const int offset_y = y - i * pc.block_step;
                for (int j = j1; j <= j2; ++j) {
                    const int offset_x = x - j * pc.block_step;
                    const int src_offset = ((i * hn + j) * 16 + offset_y) * 16 + offset_x;
                    const int window_offset = (pc.radius * 16 + offset_y) * 16 + offset_x;
                    sum += spatial[pc.spatial_base + src_offset] * wt[pc.wt_base + window_offset];
                }
            }

            store_sample((y - pad_y) * pc.dst_stride + (x - pad_x), sum);
        }
    }
}

#endif // ENTRY_COL2IM
