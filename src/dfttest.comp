#version 450

#if defined(IO_U16) || defined(IO_F16)
#extension GL_EXT_shader_16bit_storage : require
#endif
#extension GL_KHR_shader_subgroup_basic : require

/*
 * DFTTest — 3D block-wise frequency denoiser (Vulkan port of the vszipcu
 * dfttest.cu / vs-dfttest2 hiprtc dft_kernels.hpp + kernel.hpp reference
 * implementations).
 *
 * The reference kernels are FFTW 3.3.10 codelets (rdft/dft/idft/irdft for
 * block sizes 16 and temporal sizes 1/3/5/7) driven by a per-warp block
 * pipeline: im2col + window, 2D real DFT over the 16x16 spatial block, a
 * complex DFT over the temporal window, frequency-domain filtering, the
 * inverse transforms, and a col2im overlap-add of the windowed blocks.
 *
 * Parity notes (do not alter): the FFT codelet bodies are transcribed
 * verbatim (FMA/FMS/FNMS as plain float arithmetic, constants rounded
 * to the exact float32 values the C casts produce), the shared-memory
 * transpose uses a 17-float2 stride to avoid bank conflicts exactly like the
 * reference, the filter math (wiener / hard / multiply / bandpass / power /
 * sqrt variants) matches the generated filter() device code, and the zero-
 * mean path subtracts the window frequency response scaled by the DC gain.
 * The IO conversion follows the references: u16 input is scaled by
 * SCALE (1/256), f32 input by 255.0; integer output rounds with
 * +0.5 truncation (__float2int_rz) and clamps. The f16 path carries the same
 * 255.0 scale as f32 but stages native float16_t elements, and half is a
 * *storage* width rather than a precision: widening a half is exact and
 * multiplying it by 255 is exact in f32 (an 11-bit mantissa shifted by 8), so
 * the fused kernel sees the same f32 values the f32 path would and only the
 * final store rounds, with the same round-to-nearest-even a half clip wants.
 *
 * Compile-time variants: -DIO_U16 / -DIO_F16 / -DIO_F32 and exactly one of
 * -DENTRY_FUSED / -DENTRY_COL2IM defining the entry point.
 * Everything else
 * (radius, block_step, plane geometry, filter parameters, buffer offsets) is
 * passed per-dispatch through push constants so a single set of pipelines
 * serves every plane.
 *
 * Bindings (R80 GPU frames: pad reads the core's source frame planes and
 * col2im writes the output frame plane directly — the filter moves no bytes):
 *   0: wt[]       — window, then window_freq, then sigma, then the transposed
 *                   window copy im2col loads with vec4
 *   1: padded     — the tw padded temporal planes (pad writes, fused reads)
 *   2: spatial    — block buffer between fused/col2im (a ring of block rows)
 *   3: dst        — the output frame plane col2im writes
 *   4: src[tw]    — the tw temporal source frame planes pad reads
 *   5/6: wt2/wt4  — vec2 and vec4 views of binding 0
 */

#if !defined(IO_U16) && !defined(IO_F32) && !defined(IO_F16)
#define IO_U16 1
#endif

#if !defined(RADIUS)
#define RADIUS 1
#endif

#define TW (2 * RADIUS + 1)

#if defined(IO_U16)
#define ELEM_BYTES 2
#define ELEM_MASK  0xFFFFu
#define PEAK       65535.0
#define SCALE      (1.0 / 256.0)
#elif defined(IO_F16)
// A half element is a 2-byte transport like u16 but the sample is a float;
// the shader reads and writes native float16_t so no mask/shift applies.
#define ELEM_BYTES 2
#define PEAK       1.0
#define SCALE      255.0
#else
#define ELEM_BYTES 4
#define ELEM_MASK  0xFFFFFFFFu
#define PEAK       1.0
#define SCALE      255.0
#endif

// Fused-kernel transpose scratch, per sub-block. Two row layouts share one
// 288-float window (the phases are barrier-separated and each reads only what
// it wrote): TR_ROW_1 = 17-float rows for the 16x16 real transposes, TR_ROW_2
// = 18-float rows for the 9x16 ones (2 floats per element). Both strides keep
// each phase's lane pattern bank-conflict-free, and 288 is the tight bound
// (max offset 287): 2*16*17 = 544 floats per sub-block cost 18 432 B of LDS
// per 128-thread workgroup, 288 costs 10 240 B.
#define TR_ROW_1 17
#define TR_ROW_2 18
#define TR_SUB   288

// The fused kernel's working array: this lane's 9 cube bins (18*TW floats) plus
// a 32-float transient for the per-slice spatial transforms. RADIUS is a
// compile-time define (like the reference's `#define RADIUS`), so every index
// into it is constant and the cube stays in registers instead of spilling.
#define TB (18 * TW)
#define TD_SZ (TB + 32)

// Filter type as a specialization constant: the host bakes the filter variant
// into each pipeline so the dead filter branches (and their divisions) vanish,
// matching the reference's compile-time `#if FILTER_TYPE` selection.
layout(constant_id = 1) const int FILTER_TYPE = 0;
layout(constant_id = 2) const int ZMEAN = 1;

layout(std430, binding = 0) readonly buffer WtBuf { float wt[]; };
// Two vector views of the same table buffer: window_freq is read one (re,im)
// pair at a time and the transposed window one four-float row at a time, so a
// wide load replaces 2 and 4 scalar ones per bin.
layout(std430, binding = 5) readonly buffer Wt2Buf { vec2 wt2[]; };
layout(std430, binding = 6) readonly buffer Wt4Buf { vec4 wt4[]; };
layout(std430, binding = 2) buffer SpatialBuf { float spatial[]; };
// The tw temporal source planes the pad kernel reads, as one descriptor array:
// slice t is src_bufs[t], indexed only with the compile-time slice number the
// pad kernel's slice unroll produces.
#if defined(IO_U16)
layout(std430, binding = 1) buffer PaddedBuf { uint16_t padded16[]; };
layout(std430, binding = 3) buffer DstBuf { uint16_t dst16[]; };
layout(std430, binding = 4) readonly buffer SrcBuf { uint16_t src16[]; } src_bufs[TW];
#elif defined(IO_F16)
layout(std430, binding = 1) buffer PaddedBuf { float16_t padded16[]; };
layout(std430, binding = 3) buffer DstBuf { float16_t dst16[]; };
layout(std430, binding = 4) readonly buffer SrcBuf { float16_t src16[]; } src_bufs[TW];
#else
layout(std430, binding = 1) buffer PaddedBuf { uint padded_raw[]; };
layout(std430, binding = 3) buffer DstBuf { uint dst_raw[]; };
layout(std430, binding = 4) readonly buffer SrcBuf { uint src_raw[]; } src_bufs[TW];
#endif

layout(push_constant) uniform PushConstants {
    int spatial_base;   // float element offset into the spatial buffer
    int dst_base;       // byte offset into the output frame plane (0)
    int wt_base;        // float element offset of window[] in wt
    int wf_base;        // float element offset of window_freq[] in wt (-1 if !zmean)
    int sigma_base;     // float element offset of sigma[] in wt (-1 if scalar)
    int radius;
    int block_step;
    int width;          // frame plane width
    int height;         // frame plane height
    int wf2_base;       // vec2 element offset of window_freq[] in wt
    int win4_base;      // vec4 element offset of the transposed window[]
    int src_stride[7];  // per-slice source frame plane row stride in elements
    int dst_stride;     // output frame plane row stride in elements
    int pad_slice;      // pw * ph, the padded plane's samples per slice
    // Block rows are processed in stripes whose spatial results must stay in
    // L2: the block buffer is a ring of spatial_row_mask+1 block rows, indexed
    // by (block row & mask). block_base/block_end bound the stripe's blocks
    // (fused) and y_begin/y_end the output rows whose support is complete
    // (col2im).
    int spatial_row_mask;
    int block_base;
    int block_end;
    int y_begin;
    int y_end;
    float sigma;        // scaled scalar sigma (used when sigma_base < 0)
    float sigma2;
    float pmin;
    float pmax;
    float beta;
} pc;

int calc_pad_size(int size, int block_step) {
    int rem = size % 16;
    return size + (rem != 0 ? 16 - rem : 0) + max(16 - block_step, block_step) * 2;
}

int calc_pad_num(int size, int block_step) {
    return (calc_pad_size(size, block_step) - 16) / block_step + 1;
}

// ---------------------------------------------------------------------------
// FFTW 3.3.10 codelets, transcribed verbatim from the reference kernels.
// The dft/idft family operates on interleaved (re, im) data where complex
// element k of the sequence lives at float offsets base + 2*k*stride (stride
// in complex-element units); the rdft/irdft family operates on 16 plain
// floats at base .. base+15 (half-complex output/input in place).
// ---------------------------------------------------------------------------

#define FMA(a, b, c) (((a) * (b)) + (c))
#define FMS(a, b, c) (((a) * (b)) - (c))
#define FNMS(a, b, c) ((c) - ((a) * (b)))

