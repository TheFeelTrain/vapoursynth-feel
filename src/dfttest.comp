// The window is stored transposed ([t][lane][j], the j values this thread needs
// contiguous) for the vec4 load; the values are the same ones col2im reads
// from the scalar layout, since the window is separable and symmetric.
#define IM2COL_T(d, t) { \
    const int row0 = (iy * pc.block_step) * pw + ix * pc.block_step + lane; \
    const int w4 = pc.win4_base + (t) * 64 + lane * 4; \
    for (int q = 0; q < 4; ++q) { \
        const vec4 w = wt4[w4 + q]; \
        d[TB + 4 * q + 0] = load_fused((t), row0 + (4 * q + 0) * pw) * w.x; \
        d[TB + 4 * q + 1] = load_fused((t), row0 + (4 * q + 1) * pw) * w.y; \
        d[TB + 4 * q + 2] = load_fused((t), row0 + (4 * q + 2) * pw) * w.z; \
        d[TB + 4 * q + 3] = load_fused((t), row0 + (4 * q + 3) * pw) * w.w; \
    } \
}
#define SPATIAL_T(d) { \
    subgroupBarrier(); \
    for (int j = 0; j < 16; ++j) { trans[tsub + TR_ROW_1 * j + lane] = d[TB + j]; } \
    subgroupBarrier(); \
    for (int j = 0; j < 16; ++j) { d[TB + j] = trans[tsub + TR_ROW_1 * lane + j]; } \
    subgroupBarrier(); \
    rdft16(d, TB); \
    for (int j = 0; j < 9; ++j) { \
        trans[tsub + TR_ROW_2 * lane + 2 * j + 0] = d[TB + 2 * j]; \
        trans[tsub + TR_ROW_2 * lane + 2 * j + 1] = d[TB + 2 * j + 1]; \
    } \
    subgroupBarrier(); \
    if (lane < 9) { \
        for (int j = 0; j < 16; ++j) { \
            d[TB + 2 * j] = trans[tsub + TR_ROW_2 * j + 2 * lane + 0]; \
            d[TB + 2 * j + 1] = trans[tsub + TR_ROW_2 * j + 2 * lane + 1]; \
        } \
        dft16(d, TB, 1); \
    } \
}
#define REDISTRIBUTE(d, t) { \
    subgroupBarrier(); \
    if (lane < 9) { \
        for (int y = 0; y < 9; ++y) { \
            d[((y) * TW + (t)) * 2 + 0] = d[TB + 2 * y]; \
            d[((y) * TW + (t)) * 2 + 1] = d[TB + 2 * y + 1]; \
        } \
        for (int y = 9; y < 16; ++y) { \
            trans[tsub + ((y - 9) * 9 + lane) * 2 + 0] = d[TB + 2 * y]; \
            trans[tsub + ((y - 9) * 9 + lane) * 2 + 1] = d[TB + 2 * y + 1]; \
        } \
    } \
    subgroupBarrier(); \
    if (lane >= 9) { \
        const int yb = lane - 9; \
        for (int k = 0; k < 9; ++k) { \
            d[((k) * TW + (t)) * 2 + 0] = trans[tsub + (yb * 9 + k) * 2 + 0]; \
            d[((k) * TW + (t)) * 2 + 1] = trans[tsub + (yb * 9 + k) * 2 + 1]; \
        } \
    } \
    subgroupBarrier(); \
}
#define SLICE_1(d) IM2COL_T(d, 0) SPATIAL_T(d) REDISTRIBUTE(d, 0)
#define SLICE_3(d) SLICE_1(d) IM2COL_T(d, 1) SPATIAL_T(d) REDISTRIBUTE(d, 1) IM2COL_T(d, 2) SPATIAL_T(d) REDISTRIBUTE(d, 2)
#define SLICE_5(d) SLICE_3(d) IM2COL_T(d, 3) SPATIAL_T(d) REDISTRIBUTE(d, 3) IM2COL_T(d, 4) SPATIAL_T(d) REDISTRIBUTE(d, 4)
#define SLICE_7(d) SLICE_5(d) IM2COL_T(d, 5) SPATIAL_T(d) REDISTRIBUTE(d, 5) IM2COL_T(d, 6) SPATIAL_T(d) REDISTRIBUTE(d, 6)
#if RADIUS == 0
#define SLICE_ALL(d) SLICE_1(d)
#elif RADIUS == 1
#define SLICE_ALL(d) SLICE_3(d)
#elif RADIUS == 2
#define SLICE_ALL(d) SLICE_5(d)
#else
#define SLICE_ALL(d) SLICE_7(d)
#endif

// Frequency filter over this lane's 9 bins (binbase = y*9 + x in the tables).
#define FILTER_BIN_K(d, k, t) { \
    const int IDX = ((k) * TW + (t)) * 2; \
    const int bb = BIN_BASE(k); \
    float RE = d[IDX]; float IM = d[IDX + 1]; \
    float V1 = 0.0; float V2 = 0.0; \
    if (ZMEAN != 0) { \
        const vec2 wf = wt2[pc.wf2_base + bb + (t) * 144]; \
        V1 = gf * wf.x; \
        V2 = gf * wf.y; \
        RE -= V1; IM -= V2; \
    } \
    filter_value(RE, IM, bb, (t)); \
    if (ZMEAN != 0) { RE += V1; IM += V2; } \
    d[IDX] = RE; d[IDX + 1] = IM; \
}
