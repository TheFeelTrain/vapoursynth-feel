#version 450

#if BITS == 16
#extension GL_EXT_shader_16bit_storage : require
#endif
#extension GL_KHR_shader_subgroup_basic : require

/*
 * DFTTest — 3D block-wise frequency denoiser (Vulkan port of the vszipcu
 * dfttest.cu / vs-dfttest2 hiprtc dft_kernels.hpp + kernel.hpp reference
 * implementations).
 *
 * The reference kernels are FFTW 3.3.10 codelets (rdft/dft/idft/irdft for
 * block sizes 16 and temporal sizes 1/3/5/7) driven by a per-warp block
 * pipeline: im2col + window, 2D real DFT over the 16x16 spatial block, a
 * complex DFT over the temporal window, frequency-domain filtering, the
 * inverse transforms, and a col2im overlap-add of the windowed blocks.
 *
 * Parity notes (do not alter): the FFT codelet bodies are transcribed
 * verbatim (FMA/FMS/FNMA/FNMS as plain float arithmetic, constants rounded
 * to the exact float32 values the C casts produce), the shared-memory
 * transpose uses a 17-float2 stride to avoid bank conflicts exactly like the
 * reference, the filter math (wiener / hard / multiply / bandpass / power /
 * sqrt variants) matches the generated filter() device code, and the zero-
 * mean path subtracts the window frequency response scaled by the DC gain.
 * The IO conversion follows the references: integer input is scaled by
 * SCALE (1.0 for 8-bit, 1/256 for 16-bit), float input by 255.0; integer
 * output rounds with +0.5 truncation (__float2int_rz) and clamps.
 *
 * Compile-time variants: -DBITS=8|16|32, exactly one of -DENTRY_PAD /
 * -DENTRY_FUSED / -DENTRY_COL2IM defining the entry point. Everything else
 * (radius, block_step, plane geometry, filter parameters, buffer offsets) is
 * passed per-dispatch through push constants so a single triple of pipelines
 * serves every plane.
 *
 * Bindings:
 *   0: wt[]       — window weights, then window_freq, then the sigma array
 *   1: staging    — tight upload planes (pad reads) + final output (write)
 *   2: spatial    — device-local float block buffer between fused/col2im
 *   3: padded     — device-local padded source planes (pad writes, fused reads)
 */

#if !defined(BITS)
#define BITS 16
#endif

#if !defined(RADIUS)
#define RADIUS 1
#endif

#define TW (2 * RADIUS + 1)

#if BITS == 8
#define ELEM_BYTES 1
#define ELEM_MASK  0xFFu
#define PEAK       255.0
#define SCALE      1.0
#elif BITS == 16
#define ELEM_BYTES 2
#define ELEM_MASK  0xFFFFu
#define PEAK       65535.0
#define SCALE      (1.0 / 256.0)
#else
#define ELEM_BYTES 4
#define ELEM_MASK  0xFFFFFFFFu
#define PEAK       1.0
#define SCALE      255.0
#endif

#define TSTRIDE 17   // (16 + 1) transpose stride, matches the reference

// The fused kernel's working array holds tw * 32 floats (tw temporal slices of
// one complex 16-bin row). RADIUS is a compile-time define (like the
// reference's `#define RADIUS`), so the temporal loops unroll and the array
// stays in registers instead of spilling to scratch.
#define TD_SZ (TW * 32)

// Filter type as a specialization constant: the host bakes the filter variant
// into each pipeline so the dead filter branches (and their divisions) vanish,
// matching the reference's compile-time `#if FILTER_TYPE` selection.
layout(constant_id = 1) const int FILTER_TYPE = 0;
layout(constant_id = 2) const int ZMEAN = 1;

layout(std430, binding = 0) readonly buffer WtBuf { float wt[]; };
#if BITS == 16
layout(std430, binding = 1) buffer StagingBuf { uint16_t staging16[]; };
layout(std430, binding = 3) buffer PaddedBuf { uint16_t padded16[]; };
#else
layout(std430, binding = 1) buffer StagingBuf { uint staging_raw[]; };
layout(std430, binding = 3) buffer PaddedBuf { uint padded_raw[]; };
#endif
layout(std430, binding = 2) buffer SpatialBuf { float spatial[]; };

layout(push_constant) uniform PushConstants {
    int padded_base;    // byte offset of the padded source region in padded buffer
    int spatial_base;   // float element offset into the spatial buffer
    int dst_base;       // byte offset of the download region in staging
    int src_base;       // byte offset of the upload region in staging
    int wt_base;        // float element offset of window[] in wt
    int wf_base;        // float element offset of window_freq[] in wt (-1 if !zmean)
    int sigma_base;     // float element offset of sigma[] in wt (-1 if scalar)
    int radius;
    int block_step;
    int width;          // frame plane width
    int height;         // frame plane height
    int src_stride;     // upload plane row stride in elements
    int dst_stride;     // frame plane row stride in elements
    int filter_type;    // runtime fallback (unused when FILTER_TYPE is defined at build time)
    float sigma;        // scaled scalar sigma (used when sigma_base < 0)
    float sigma2;
    float pmin;
    float pmax;
    float beta;
} pc;

int calc_pad_size(int size, int block_step) {
    int rem = size % 16;
    return size + (rem != 0 ? 16 - rem : 0) + max(16 - block_step, block_step) * 2;
}

int calc_pad_num(int size, int block_step) {
    return (calc_pad_size(size, block_step) - 16) / block_step + 1;
}

// ---------------------------------------------------------------------------
// FFTW 3.3.10 codelets, transcribed verbatim from the reference kernels.
// The dft/idft family operates on interleaved (re, im) data where complex
// element k of the sequence lives at float offsets base + 2*k*stride (stride
// in complex-element units); the rdft/irdft family operates on 16 plain
// floats at base .. base+15 (half-complex output/input in place).
// ---------------------------------------------------------------------------

#define FMA(a, b, c) (((a) * (b)) + (c))
#define FMS(a, b, c) (((a) * (b)) - (c))
#define FNMA(a, b, c) (- (((a) * (b)) + (c)))
#define FNMS(a, b, c) ((c) - ((a) * (b)))

