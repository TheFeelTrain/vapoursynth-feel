// ---------------------------------------------------------------------------
// pad: reflection-pad every temporal source plane of this frame (single-fold
// mirror, identical to the reference's reflect_pad kernel) into this frame's
// padded buffer, in one dispatch: each invocation writes one padded pixel of
// all tw slices, so the tw source planes are read as one descriptor array with
// a compile-time slice index and the launches collapse to one.
// ---------------------------------------------------------------------------

#if defined(ENTRY_PAD)

#define PAD_SLICE(t) { \
    store_padded((t), y * pw + x, \
                 load_src((t), sy * pc.src_stride[(t)] + sx)); \
}

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int ph = calc_pad_size(pc.height, pc.block_step);
    const int pad_x = (pw - pc.width) / 2;
    const int pad_y = (ph - pc.height) / 2;

    for (int y = int(gl_GlobalInvocationID.y); y < ph; y += int(gl_NumWorkGroups.y) * 8) {
        for (int x = int(gl_GlobalInvocationID.x); x < pw; x += int(gl_NumWorkGroups.x) * 32) {
            // one fold per side, so abs() is the whole reflection
            const int sx = pc.width - 1 - abs(pc.width - 1 - abs(x - pad_x));
            const int sy = pc.height - 1 - abs(pc.height - 1 - abs(y - pad_y));
#if TW > 0
            PAD_SLICE(0)
#endif
#if TW > 1
            PAD_SLICE(1)
#endif
#if TW > 2
            PAD_SLICE(2)
#endif
#if TW > 3
            PAD_SLICE(3)
#endif
#if TW > 4
            PAD_SLICE(4)
#endif
#if TW > 5
            PAD_SLICE(5)
#endif
#if TW > 6
            PAD_SLICE(6)
#endif
        }
    }
}

#undef PAD_SLICE

#endif // ENTRY_PAD

// ---------------------------------------------------------------------------
// fused: im2col + 3D DFT + filter + inverse + center-slice col
// One 16x16 block per 16 invocations; the 16 invocations act as the 16 lanes of
// the reference warp (the HIPRTC backend's 32-lane block with 16 active
// lanes, workgroup barriers in place of warp shuffles).
// ---------------------------------------------------------------------------

#if defined(ENTRY_FUSED)

#ifndef SUB_BLOCKS
// Blocks per workgroup: 8 * 16 = 128 threads. The host requires a subgroup size
// that is a multiple of 16 (32 on the target GPU, so four subgroups), which is
// what keeps a 16-lane tile inside one subgroup for the subgroupBarrier below.
#define SUB_BLOCKS 8
#endif

shared float trans[SUB_BLOCKS * TR_SUB];
shared float s_gf[SUB_BLOCKS];

layout(local_size_x = SUB_BLOCKS * 16, local_size_y = 1, local_size_z = 1) in;
void main() {
    const int lane = int(gl_LocalInvocationIndex) & 15;
    const int sub = int(gl_LocalInvocationIndex) >> 4;
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int hn = calc_pad_num(pc.width, pc.block_step);
    const int tsub = sub * TR_SUB;

    for (int block_id = pc.block_base + int(gl_WorkGroupID.x) * SUB_BLOCKS + sub;
         block_id < pc.block_end;
         block_id += int(gl_NumWorkGroups.x) * SUB_BLOCKS) {
        const int ix = block_id % hn;
        const int iy = block_id / hn;

        float td[TD_SZ];

        // im2col + spatial DFT per slice, straight into this lane's cube slots
        SLICE_ALL(td);

        // temporal DFT across the slices, per bin
        TD_DFT_ALL(td);

        // zero-mean: DC gain broadcast from lane 0 (bin 0, slice 0)
        if (ZMEAN != 0) {
            if (lane == 0) {
                s_gf[sub] = td[0] / wt[pc.wf_base];
            }
        }
        subgroupBarrier();
        float gf = 0.0;
        if (ZMEAN != 0) {
            gf = s_gf[sub];
        }

        // frequency filtering and temporal idft, per bin
        FILTER_ALL(td);
        TD_IDFT_ALL(td);

        // gather the 16 y-bins of x-bin `lane` back into one lane for the
        // inverse: its own y = 0..8, plus y = 9..15 held by lanes 9..15
        subgroupBarrier();
        for (int k = 0; k < 9; ++k) {
            trans[tsub + (lane * 9 + k) * 2 + 0] = td[(k * TW + RADIUS) * 2 + 0];
            trans[tsub + (lane * 9 + k) * 2 + 1] = td[(k * TW + RADIUS) * 2 + 1];
        }
        subgroupBarrier();
        if (lane < 9) {
            for (int y = 0; y < 16; ++y) {
                const int slot = (y < 9) ? (lane * 9 + y) : (y * 9 + lane);
                td[TB + 2 * y] = trans[tsub + slot * 2 + 0];
                td[TB + 2 * y + 1] = trans[tsub + slot * 2 + 1];
            }
            idft16(td, TB, 1);
            for (int j = 0; j < 16; ++j) {
                trans[tsub + TR_ROW_2 * j + 2 * lane + 0] = td[TB + 2 * j];
                trans[tsub + TR_ROW_2 * j + 2 * lane + 1] = td[TB + 2 * j + 1];
            }
        }
        subgroupBarrier();
        for (int j = 0; j < 9; ++j) {
            td[TB + 2 * j] = trans[tsub + TR_ROW_2 * lane + 2 * j + 0];
            td[TB + 2 * j + 1] = trans[tsub + TR_ROW_2 * lane + 2 * j + 1];
        }
        irdft16(td, TB);
        subgroupBarrier();
        for (int j = 0; j < 16; ++j) {
            trans[tsub + TR_ROW_1 * j + lane] = td[TB + (j == 0 ? 0 : 16 - j)];
        }
        subgroupBarrier();
        // write the block's center slice into the spatial buffer ring
        const int dst_base =
            pc.spatial_base + ((iy & pc.spatial_row_mask) * hn + ix) * 256;
        for (int j = 0; j < 16; ++j) {
            spatial[dst_base + j * 16 + lane] = trans[tsub + TR_ROW_1 * lane + j];
        }
    }
}

#endif // ENTRY_FUSED

// ---------------------------------------------------------------------------
// col2im: overlap-add the windowed blocks back into the final plane
// ---------------------------------------------------------------------------

#if defined(ENTRY_COL2IM)

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
void main() {
    const int pw = calc_pad_size(pc.width, pc.block_step);
    const int ph = calc_pad_size(pc.height, pc.block_step);
            const int hn = calc_pad_num(pc.width, pc.block_step);
            const int vn = calc_pad_num(pc.height, pc.block_step);
            const int pad_x = (pw - pc.width) / 2;
    const int pad_y = (ph - pc.height) / 2;

    for (int y = pc.y_begin + int(gl_GlobalInvocationID.y); y <= pc.y_end;
         y += int(gl_NumWorkGroups.y) * 8) {
        for (int x = int(gl_GlobalInvocationID.x); x < pw; x += int(gl_NumWorkGroups.x) * 32) {
            if (y < pad_y || y >= pad_y + pc.height || x < pad_x || x >= pad_x + pc.width) {
                continue;
            }

            float sum = 0.0;
            const int i1 = (y - 16 + pc.block_step) / pc.block_step;
            const int i2 = min(y / pc.block_step, vn - 1);
            const int j1 = (x - 16 + pc.block_step) / pc.block_step;
            const int j2 = min(x / pc.block_step, hn - 1);

            for (int i = i1; i <= i2; ++i) {
                const int offset_y = y - i * pc.block_step;
                for (int j = j1; j <= j2; ++j) {
                    const int offset_x = x - j * pc.block_step;
                    const int src_offset =
                        (((i & pc.spatial_row_mask) * hn + j) * 16 + offset_y) * 16 + offset_x;
                    const int window_offset = (pc.radius * 16 + offset_y) * 16 + offset_x;
                    sum += spatial[pc.spatial_base + src_offset] * wt[pc.wt_base + window_offset];
                }
            }

            store_sample((y - pad_y) * pc.dst_stride + (x - pad_x), sum);
        }
    }
}

#endif // ENTRY_COL2IM
