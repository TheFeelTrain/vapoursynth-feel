// ---------------------------------------------------------------------------
// IO helpers (raw staging / padded-buffer access)
// ---------------------------------------------------------------------------

float to_float(uint raw) {
#if BITS == 32
    return uintBitsToFloat(raw) * SCALE;
#else
    return float(raw) * SCALE;
#endif
}

// the fused kernel reads the padded source from the device-local padded buffer
uint load_raw(int sample_idx) {
#if BITS == 16
    return uint(padded16[(pc.padded_base >> 1) + sample_idx]);
#else
    int byte = pc.padded_base + sample_idx * ELEM_BYTES;
    uint word = padded_raw[byte >> 2];
    return (word >> (8 * (byte & 3))) & ELEM_MASK;
#endif
}

// the pad kernel reads the tight upload rows from the staging buffer
uint load_upload(int sample_idx) {
#if BITS == 16
    return uint(staging16[(pc.src_base >> 1) + sample_idx]);
#else
    int byte = pc.src_base + sample_idx * ELEM_BYTES;
    uint word = staging_raw[byte >> 2];
    return (word >> (8 * (byte & 3))) & ELEM_MASK;
#endif
}

void store_sample(int sample_idx, float v) {
#if BITS == 32
    int byte = pc.dst_base + sample_idx * ELEM_BYTES;
    staging_raw[byte >> 2] = floatBitsToUint(v / SCALE);
#else
    float x = v / SCALE;
    x = clamp(x + 0.5, 0.0, PEAK);
    staging16[(pc.dst_base >> 1) + sample_idx] = uint16_t(uint(x) & ELEM_MASK);
#endif
}

// the pad kernel writes the padded source into the device-local buffer
void store_padded(int sample_idx, float v) {
#if BITS == 32
    int byte = pc.padded_base + sample_idx * ELEM_BYTES;
    padded_raw[byte >> 2] = floatBitsToUint(v / SCALE);
#else
    float x = v / SCALE;
    x = clamp(x + 0.5, 0.0, PEAK);
    padded16[(pc.padded_base >> 1) + sample_idx] = uint16_t(uint(x) & ELEM_MASK);
#endif
}

// ---------------------------------------------------------------------------
// Frequency-domain filter (matches the reference generated filter())
// ---------------------------------------------------------------------------

void filter_value(inout float re, inout float im, int x, int y, int t) {
    float sigma;
    if (pc.sigma_base < 0) {
        sigma = pc.sigma;
    } else {
        sigma = wt[pc.sigma_base + (t * 16 + y) * 9 + x];
    }
    float sigma2 = pc.sigma2;
    float pmin = pc.pmin;
    float pmax = pc.pmax;
    float beta = pc.beta;
    float multiplier = 0.0;

    if (FILTER_TYPE == 2) {
        re *= sigma;
        im *= sigma;
        return;
    }

    float psd = re * re + im * im;

    if (FILTER_TYPE == 1) {
        if (psd < sigma) {
            re = 0.0;
            im = 0.0;
        }
        return;
    } else if (FILTER_TYPE == 3) {
        if (psd >= pmin && psd <= pmax) {
            multiplier = sigma;
        } else {
            multiplier = sigma2;
        }
    } else {
        float x0 = max((psd - sigma) / (psd + 1e-15), 0.0);
        if (FILTER_TYPE == 4) {
            multiplier = sigma * sqrt(psd * (pmax / ((psd + pmin) * (psd + pmax) + 1e-15)));
        } else if (FILTER_TYPE == 5) {
            multiplier = pow(x0, beta);
        } else if (FILTER_TYPE == 6) {
            multiplier = sqrt(x0);
        } else {
            multiplier = x0;
        }
    }

    re *= multiplier;
    im *= multiplier;
}

void temporal_dft(inout float data[TD_SZ], int base) {
#if RADIUS == 0
    dft1(data, base, 16);
#elif RADIUS == 1
    dft3(data, base, 16);
#elif RADIUS == 2
    dft5(data, base, 16);
#else
    dft7(data, base, 16);
#endif
}

void temporal_idft(inout float data[TD_SZ], int base) {
#if RADIUS == 0
    idft1(data, base, 16);
#elif RADIUS == 1
    idft3(data, base, 16);
#elif RADIUS == 2
    idft5(data, base, 16);
#else
    idft7(data, base, 16);
#endif
}

