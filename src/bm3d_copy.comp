#version 450
#extension GL_EXT_shader_16bit_storage : require

/*
 * The source ring's copy kernel for an integer input clip: widens the plane's
 * native samples into the ring's float working domain while copying it.
 *
 * The widening is the reference's Int2Float (gain 1/65535, plus the chroma
 * neutral), so an integer clip reaches the estimator as exactly the numbers a
 * float clip of the same content would, and the two depths share one
 * estimation kernel. A YUV chroma plane is centred on 32768, which the
 * reference's float chroma domain puts at zero, so pc.center carries that
 * neutral code there and 0 on luma and RGB; without it a constant 0.5 rides
 * into the thresholded/scaled DC term.
 *
 * It has to happen here, once per source sample, rather than on load in the
 * matcher: the matcher reads each source sample once per candidate origin (a
 * few hundred times per 8x8 block), the whole search window is L1-resident, so
 * a load-time conversion buys no DRAM traffic back and costs a permanent
 * widening per candidate. Doing it at copy time replaces the fp32 path's
 * 8-byte-per-sample transfer with 2 bytes in and 4 bytes out.
 *
 * The ring is a flat per-plane copy: the host keeps the destination stride
 * equal to the source's element stride (see record_src_copies), so the copy is
 * one linear range with no row arithmetic, exactly like the buffer copy the
 * float path uses.
 */

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SrcBuf { uint16_t src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { float dst[]; };

layout(push_constant) uniform PushConstants {
    uint dst_off; // first destination element of this plane
    uint count;   // elements to convert
    int center;   // 32768 on a YUV chroma plane, 0 otherwise
} pc;

void main() {
    // The grid folds into Y when the element count exceeds the device's X
    // workgroup limit, so the element index is ID.y * NumWorkGroups.x + ID.x
    // (the host sizes the grid the same way); ID.x alone would leave the fold
    // unwritten. See vsfeel_fold_grid.
    const uint i = (uint(gl_WorkGroupID.y) * uint(gl_NumWorkGroups.x) +
                    uint(gl_WorkGroupID.x)) *
                       256u +
                   uint(gl_LocalInvocationIndex);
    if (i >= pc.count) {
        return;
    }
    dst[pc.dst_off + i] =
        (float(int(src[i])) - float(pc.center)) * (1.0f / 65535.0f);
}
