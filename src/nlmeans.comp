#version 450

/*
 * NLMeans (KNLMeansCL-style spatio-temporal non-local means), ported from the
 * vszipcl/vszipcu reference kernels. One .comp file, three entry points
 * selected at build time:
 *
 *   -DENTRY_WEIGHT  nlmWeight      patch-distance + separable box-sum + weight
 *   -DENTRY_ACC     nlmAccumulation per-pixel +q/-q accumulation
 *   -DENTRY_FINISH  nlmFinish      final weighted average
 *
 * -DBITS=16|32 selects the io element type of u1/u1z (raw VapourSynth plane
 * bytes; 16-bit int or 32-bit float). Everything that is fixed per filter
 * instance (dims, strides, d/a/s, ref mode, channels, wmode, h/wref) arrives
 * as specialization constants so each pipeline compiles to its cheapest form.
 *
 * Do not reorder/re-associate: math, tap order, zero-border and the
 * q-batched sweep order are part of the result (see reference nlmeans.zig).
 */

#if !defined(BITS)
#define BITS 16
#endif

#if BITS == 16
#extension GL_EXT_shader_16bit_storage : require
#define PEAK       65535.0f
#define SCALE      (1.0f / 65535.0f)
#else
#define PEAK       1.0f
#define SCALE      1.0f
#endif

layout(constant_id = 0)  const int VI_DIM_X = 640;
layout(constant_id = 1)  const int VI_DIM_Y = 360;
layout(constant_id = 2)  const int STRIDE = 640;
layout(constant_id = 3)  const int PSTRIDE = 656;
layout(constant_id = 4)  const int PAD = 2;
layout(constant_id = 5)  const int PH = 368;
layout(constant_id = 6)  const int NLM_S = 4;
layout(constant_id = 7)  const int NLM_D = 1;
layout(constant_id = 8)  const int NLM_REF = 0;
layout(constant_id = 9)  const int NLM_CHANNELS = 1;
layout(constant_id = 10) const int WMODE = 0;
layout(constant_id = 11) const float NLM_H = 1.2;
layout(constant_id = 12) const float WREF = 1.0;
layout(constant_id = 13) const float H2_INV_NORM = 1.0;

#define U1_LAYER  (PSTRIDE * PH)             /* io elements per zero-padded layer */
#define U1_PLANE  ((2*NLM_D+1) * U1_LAYER)   /* io elements per channel */
#define U4_LAYER  (STRIDE * VI_DIM_Y)        /* floats per weight slot */
#define NPIX      (STRIDE * VI_DIM_Y)        /* io elements per output channel */

#ifndef ENTRY_PAD
layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
#endif

#if BITS == 16
layout(std430, binding = 0) buffer SrcBuf   { uint16_t src_raw[]; };
layout(std430, binding = 1) readonly buffer GuideBuf { uint16_t guide_raw[]; };
layout(std430, binding = 2) writeonly buffer DstBuf  { uint16_t dst_raw[]; };
#else
layout(std430, binding = 0) buffer SrcBuf   { float src_raw[]; };
layout(std430, binding = 1) readonly buffer GuideBuf { float guide_raw[]; };
layout(std430, binding = 2) writeonly buffer DstBuf  { float dst_raw[]; };
#endif
layout(std430, binding = 3) buffer AccBuf { float u2[]; };
layout(std430, binding = 4) buffer WeightBuf { float u4a[]; };
layout(std430, binding = 5) buffer MaxBuf { float u5[]; };
layout(std430, binding = 6) readonly buffer WQBuf { int wq[]; };
layout(std430, binding = 7) readonly buffer AQBuf { int aq[]; };
// per-frame layer->slot-base table: [c*layers + t] source, [C*layers + c*layers + t]
// guide (element offsets of the padded tile holding that channel-layer this
// frame), followed by {dst_base, src_base} element pairs for the pad kernel
layout(std430, binding = 8) readonly buffer SlotTable { int slot_table[]; };
// compact upload staging (pad kernel source)
#if BITS == 16
layout(std430, binding = 9) readonly buffer UpBuf { uint16_t up_raw[]; };
#else
layout(std430, binding = 9) readonly buffer UpBuf { float up_raw[]; };
#endif

layout(push_constant) uniform PushConstants {
    int pc0;
    int pc1;
    int pc2;
} pc;

#define LAYERS (2*NLM_D+1)
#define GT_OFF (NLM_CHANNELS * LAYERS)

float load_src(int idx) {
#if BITS == 32
    return src_raw[idx];
#else
    return float(int(src_raw[idx])) * SCALE;
#endif
}

float load_guide(int idx) {
#if BITS == 32
    return guide_raw[idx];
#else
    return float(int(guide_raw[idx])) * SCALE;
#endif
}

void store_value(int idx, float v) {
#if BITS == 32
    dst_raw[idx] = v;
#else
    // glslc -O chokes on a direct float->uint16_t convert (OpUConvert);
    // go through uint with an explicit mask (same workaround as DFTTest)
    dst_raw[idx] = uint16_t(uint(v * PEAK + 0.5f) & 0xFFFFu);
#endif
}

#ifdef ENTRY_PAD
// Zero-pad one compact upload tile into its cache slot. Workgroup z picks
// the tile; its {slot_base, compact_base} element pair lives in the slot
// table after the layer table (region 2*NLM_CHANNELS*LAYERS ints).
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
void main() {
#if BITS == 16
#define UP_VAL(i) (float(int(up_raw[i])) * SCALE)
#else
#define UP_VAL(i) up_raw[i]
#endif
    const int pi = 2*NLM_CHANNELS*LAYERS + int(gl_WorkGroupID.z)*2;
    const int dstb = slot_table[pi];
    const int srcb = slot_table[pi+1];
    for (int y = int(gl_GlobalInvocationID.y); y < PH;
         y += int(gl_NumWorkGroups.y) * 8) {
        for (int x = int(gl_GlobalInvocationID.x); x < PSTRIDE;
             x += int(gl_NumWorkGroups.x) * 32) {
            float v = 0.0f;
            if (x >= PAD && x < PAD+VI_DIM_X && y >= PAD && y < PAD+VI_DIM_Y) {
                v = UP_VAL(srcb + (y-PAD)*VI_DIM_X + (x-PAD));
            }
#if BITS == 16
            src_raw[dstb + y*PSTRIDE + x] =
                uint16_t(uint(v * PEAK + 0.5f) & 0xFFFFu);
#else
            src_raw[dstb + y*PSTRIDE + x] = v;
#endif
        }
    }
#undef UP_VAL
}
#endif /* ENTRY_PAD */

/* Joint multi-channel patch distance for the center pixel (xx,y) vs the
 * candidate (xx+qx, y+qy). aK/bK are the element bases of channel K's slot
 * tiles for the reference / candidate layer; the +-a margin of each padded
 * tile realizes the zero border. Constants and operand order match the
 * reference nlm_pix_dist exactly. The REF branches fold per pipeline. */
float nlm_pix_dist(int a0, int a1, int a2, int b0, int b1, int b2,
                   int xx, int y, int qx, int qy) {
    const int rc = (y+PAD)*PSTRIDE + (xx+PAD);
    const int cc = (y+qy+PAD)*PSTRIDE + (xx+qx+PAD);
    if (NLM_REF == 0) {          /* LUMA */
        const float d0 = load_guide(a0 + rc) - load_guide(b0 + cc);
        return 3.0f * (d0 * d0);
    } else if (NLM_REF == 1) {   /* CHROMA (U,V) */
        const float du = load_guide(a0 + rc) - load_guide(b0 + cc);
        const float dv = load_guide(a1 + rc) - load_guide(b1 + cc);
        return 1.5f * (du*du + dv*dv);
    } else if (NLM_REF == 2) {   /* YUV (4:4:4 only) */
        const float dy = load_guide(a0 + rc) - load_guide(b0 + cc);
        const float du = load_guide(a1 + rc) - load_guide(b1 + cc);
        const float dv = load_guide(a2 + rc) - load_guide(b2 + cc);
        return dy*dy + du*du + dv*dv;
    } else {                     /* RGB */
        const float ar = load_guide(a0 + rc), br = load_guide(b0 + cc);
        const float dr = ar - br;
        const float dg = load_guide(a1 + rc) - load_guide(b1 + cc);
        const float db = load_guide(a2 + rc) - load_guide(b2 + cc);
        const float m_red = (ar + br) / 6.0f;
        return (2.0f/3.0f + m_red) * (dr*dr) + (4.0f/3.0f) * (dg*dg) + (1.0f - m_red) * (db*db);
    }
}

#ifdef ENTRY_WEIGHT

// Workgroup tile geometry (matches the reference launch config).
#define BX        16
#define BY        8
#define VRT_RESULT 3
// Exact per-instance LDS sizing: NLM_S is a specialization constant, so the
// pipeline allocates precisely what this instance needs (occupancy). Even
// strides like the OpenCL reference (gfx11 has no bank-conflict penalty here).
#define DIST_W (BX + 2*NLM_S)
#define HSUM_W (BX)

shared float dist[VRT_RESULT*BY + 2*NLM_S][DIST_W];
shared float hsum[VRT_RESULT*BY + 2*NLM_S][HSUM_W];

void main() {
    // Q-batched: workgroup z picks the pass whose (t,qx,qy,qz,slot) row comes
    // from the create()-time sweep table wq (stride-8 rows).
    const int prow = (pc.pc0 + int(gl_WorkGroupID.z)) * 8;
    const int t = wq[prow+0], qx = wq[prow+1], qy = wq[prow+2], qz = wq[prow+3];
    const int slot = wq[prow+4];

    // guide slot bases for layers t (reference) and t+qz (candidate)
    const int gt = GT_OFF + t;
    const int gt_c = GT_OFF + t + qz;
    const int a0 = slot_table[gt],      b0 = slot_table[gt_c];
    const int a1 = slot_table[gt + LAYERS],   b1 = slot_table[gt_c + LAYERS];
    const int a2 = slot_table[gt + 2*LAYERS], b2 = slot_table[gt_c + 2*LAYERS];

    const int lx = int(gl_LocalInvocationID.x);
    const int ly = int(gl_LocalInvocationID.y);
    const int gx0 = int(gl_WorkGroupID.x) * BX;
    const int gy0 = int(gl_WorkGroupID.y) * (VRT_RESULT*BY);

#undef DIST_CELL
#define DIST_CELL(RY, CX) { \
    const int xx_c = gx0 - NLM_S + (CX); \
    const int yy_c = gy0 - NLM_S + (RY); \
    dist[RY][CX] = (xx_c >= 0 && xx_c < VI_DIM_X && yy_c >= 0 && yy_c < VI_DIM_Y) \
                   ? nlm_pix_dist(a0, a1, a2, b0, b1, b2, xx_c, yy_c, qx, qy) : 0.0f; }
#undef DIST_CHUNK
#define DIST_CHUNK(RYBASE) { \
    const int ry_g = (RYBASE); \
    if (ry_g < VRT_RESULT*BY + 2*NLM_S) { \
        if (lx < 2*NLM_S) { \
            DIST_CELL(ry_g, lx) \
            DIST_CELL(ry_g, lx + BX) \
        } else { \
            DIST_CELL(ry_g, lx) \
        } \
    } }

    // 1) per-pixel distance over the tile + halo; OOB -> 0.0f (zero border).
    // Written out as straight-line code (at most 5 strided rows per thread,
    // at most 2 columns): keeps all pixel loads in flight simultaneously the
    // way the reference compiler's full unroll does.
    DIST_CHUNK(ly)
    DIST_CHUNK(ly + BY)
    DIST_CHUNK(ly + 2*BY)
    DIST_CHUNK(ly + 3*BY)
    DIST_CHUNK(ly + 4*BY)
#undef DIST_CHUNK
#undef DIST_CELL
    barrier();
    // 2) horizontal box-sum: hsum[ry][lx] = sum dist[ry][lx..lx+2S] (ascending x).
    for (int ry = ly; ry < VRT_RESULT*BY + 2*NLM_S; ry += BY) {
        float sh = 0.0f;
        for (int i = 0; i <= 2*NLM_S; ++i) sh += dist[ry][lx + i];
        hsum[ry][lx] = sh;
    }
    barrier();
    // 3) vertical box-sum + weight transform, VRT_RESULT output rows per thread.
    const int x = gx0 + lx;
    if (x >= VI_DIM_X) return;
    int y = gy0 + ly, lc = ly;
    for (int r = 0; r < VRT_RESULT; ++r, y += BY, lc += BY) {
        if (y >= VI_DIM_Y) return;
        float sum = 0.0f;
        for (int i = 0; i <= 2*NLM_S; ++i) sum += hsum[lc + i][lx];
        const float arg = sum * H2_INV_NORM;
        float w;
        if (WMODE == 0) {
            w = exp(-arg);
        } else if (WMODE == 1) {
            w = max(1.0f - arg, 0.0f);            // fdimf(1, arg)
        } else if (WMODE == 2) {
            float c = max(1.0f - arg, 0.0f); w = c*c;
        } else {
            float c = max(1.0f - arg, 0.0f); c = c*c; c = c*c; w = c*c;
        }
        u4a[slot*U4_LAYER + y*STRIDE + x] = w;
    }
}

#endif /* ENTRY_WEIGHT */

#ifdef ENTRY_ACC

void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= VI_DIM_X || y >= VI_DIM_Y) return;
    const int g = y*STRIDE + x;
    const int cx = x+PAD, cy = y+PAD;
    const int q_base = pc.pc0, nb = pc.pc1;
    // first batch starts from constants (replaces u2/u5 zero-fills)

    float u5v = pc.pc2 != 0 ? 1.1920929e-7f : u5[g];
    // Accumulate both +q and -q per entry: weight(p,p+q)==weight(p,p-q).
    // Per pixel the loop walks the batch's q's in sweep order (rows of the
    // aq table: qx, qy, qz, center slot, mirror slot).
    if (NLM_CHANNELS == 1) {
        float acc0 = pc.pc2 != 0 ? 0.0f : u2[2*g], accw = pc.pc2 != 0 ? 0.0f : u2[2*g+1];
        for (int b = 0; b < nb; ++b) {
            const int r = (q_base + b) * 8;
            const int qx = aq[r+0], qy = aq[r+1], qz = aq[r+2];
            const int sc = aq[r+3], sm = aq[r+4];
            const float u4 = u4a[sc*U4_LAYER + g];
            const int xm = x-qx, ym = y-qy;
            const float u4_mq = (xm < 0 || xm >= VI_DIM_X || ym < 0 || ym >= VI_DIM_Y)
                                ? 0.0f : u4a[sm*U4_LAYER + ym*STRIDE + xm];
            u5v = max(u4, max(u4_mq, u5v));
            const int pqc = slot_table[NLM_D+qz] + (cy+qy)*PSTRIDE + (cx+qx);
            const int mqc = slot_table[NLM_D-qz] + (cy-qy)*PSTRIDE + (cx-qx);
            const float pq0 = load_src(pqc), mq0 = load_src(mqc);
            acc0 += (u4*pq0) + (u4_mq*mq0);
            accw += (u4 + u4_mq);
        }
        u2[2*g] = acc0; u2[2*g+1] = accw;
    } else if (NLM_CHANNELS == 2) {
        float acc0 = pc.pc2 != 0 ? 0.0f : u2[3*g];
        float acc1 = pc.pc2 != 0 ? 0.0f : u2[3*g+1];
        float accw = pc.pc2 != 0 ? 0.0f : u2[3*g+2];
        for (int b = 0; b < nb; ++b) {
            const int r = (q_base + b) * 8;
            const int qx = aq[r+0], qy = aq[r+1], qz = aq[r+2];
            const int sc = aq[r+3], sm = aq[r+4];
            const float u4 = u4a[sc*U4_LAYER + g];
            const int xm = x-qx, ym = y-qy;
            const float u4_mq = (xm < 0 || xm >= VI_DIM_X || ym < 0 || ym >= VI_DIM_Y)
                                ? 0.0f : u4a[sm*U4_LAYER + ym*STRIDE + xm];
            u5v = max(u4, max(u4_mq, u5v));
            const int pq0b = slot_table[NLM_D+qz]     + (cy+qy)*PSTRIDE + (cx+qx);
            const int mq0b = slot_table[NLM_D-qz]     + (cy-qy)*PSTRIDE + (cx-qx);
            const int pq1b = slot_table[LAYERS+NLM_D+qz] + (cy+qy)*PSTRIDE + (cx+qx);
            const int mq1b = slot_table[LAYERS+NLM_D-qz] + (cy-qy)*PSTRIDE + (cx-qx);
            const float pq0 = load_src(pq0b), mq0 = load_src(mq0b);
            const float pq1 = load_src(pq1b), mq1 = load_src(mq1b);
            acc0 += (u4*pq0) + (u4_mq*mq0);
            acc1 += (u4*pq1) + (u4_mq*mq1);
            accw += (u4 + u4_mq);
        }
        u2[3*g] = acc0; u2[3*g+1] = acc1; u2[3*g+2] = accw;
    } else {
        float acc0 = pc.pc2 != 0 ? 0.0f : u2[4*g];
        float acc1 = pc.pc2 != 0 ? 0.0f : u2[4*g+1];
        float acc2 = pc.pc2 != 0 ? 0.0f : u2[4*g+2];
        float accw = pc.pc2 != 0 ? 0.0f : u2[4*g+3];
        for (int b = 0; b < nb; ++b) {
            const int r = (q_base + b) * 8;
            const int qx = aq[r+0], qy = aq[r+1], qz = aq[r+2];
            const int sc = aq[r+3], sm = aq[r+4];
            const float u4 = u4a[sc*U4_LAYER + g];
            const int xm = x-qx, ym = y-qy;
            const float u4_mq = (xm < 0 || xm >= VI_DIM_X || ym < 0 || ym >= VI_DIM_Y)
                                ? 0.0f : u4a[sm*U4_LAYER + ym*STRIDE + xm];
            u5v = max(u4, max(u4_mq, u5v));
            const int pq0b = slot_table[NLM_D+qz]        + (cy+qy)*PSTRIDE + (cx+qx);
            const int mq0b = slot_table[NLM_D-qz]        + (cy-qy)*PSTRIDE + (cx-qx);
            const int pq1b = slot_table[LAYERS+NLM_D+qz]    + (cy+qy)*PSTRIDE + (cx+qx);
            const int mq1b = slot_table[LAYERS+NLM_D-qz]    + (cy-qy)*PSTRIDE + (cx-qx);
            const int pq2b = slot_table[2*LAYERS+NLM_D+qz]  + (cy+qy)*PSTRIDE + (cx+qx);
            const int mq2b = slot_table[2*LAYERS+NLM_D-qz]  + (cy-qy)*PSTRIDE + (cx-qx);
            const float pq0 = load_src(pq0b), mq0 = load_src(mq0b);
            const float pq1 = load_src(pq1b), mq1 = load_src(mq1b);
            const float pq2 = load_src(pq2b), mq2 = load_src(mq2b);
            acc0 += (u4*pq0) + (u4_mq*mq0);
            acc1 += (u4*pq1) + (u4_mq*mq1);
            acc2 += (u4*pq2) + (u4_mq*mq2);
            accw += (u4 + u4_mq);
        }
        u2[4*g] = acc0; u2[4*g+1] = acc1; u2[4*g+2] = acc2; u2[4*g+3] = accw;
    }
    u5[g] = u5v;
}

#endif /* ENTRY_ACC */

#ifdef ENTRY_FINISH

// out = (center*m + weighted_sum) / (m + weight_sum), m = wref*maxweight.
// den==0 unguarded: u5 seeded with FLT_EPS keeps den > 0 (matches KNL).
void main() {
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x >= VI_DIM_X || y >= VI_DIM_Y) return;
    const int g = y*STRIDE + x;
    const float m = WREF * u5[g];
    const int uc = slot_table[NLM_D] + (y+PAD)*PSTRIDE + (x+PAD);

    if (NLM_CHANNELS == 1) {
        const float acc0 = u2[2*g], accw = u2[2*g+1];
        const float den = m + accw;
        store_value(g, (load_src(uc)*m + acc0) / den);
    } else if (NLM_CHANNELS == 2) {
        const float acc0 = u2[3*g], acc1 = u2[3*g+1], accw = u2[3*g+2];
        const float den = m + accw;
        store_value(g,               (load_src(uc)*m                          + acc0) / den);
        store_value(NPIX + g,        (load_src(slot_table[LAYERS+NLM_D]       + (y+PAD)*PSTRIDE + (x+PAD))*m + acc1) / den);
    } else {
        const float acc0 = u2[4*g], acc1 = u2[4*g+1], acc2 = u2[4*g+2], accw = u2[4*g+3];
        const float den = m + accw;
        store_value(g,               (load_src(uc)*m                          + acc0) / den);
        store_value(NPIX + g,        (load_src(slot_table[LAYERS+NLM_D]       + (y+PAD)*PSTRIDE + (x+PAD))*m + acc1) / den);
        store_value(2*NPIX + g,      (load_src(slot_table[2*LAYERS+NLM_D]     + (y+PAD)*PSTRIDE + (x+PAD))*m + acc2) / den);
    }
}

#endif /* ENTRY_FINISH */
