#version 450
/*
 * EEDI3 — full-pel edge-directed line interpolation (Vulkan port).
 *
 * Semantic target: family A (eedi3m, the original HolyWu implementation;
 * eedi3vk2 is the same family and the closest GPU cross-check). This is a
 * from-scratch implementation that reproduces eedi3m's per-column math:
 *
 *   - connection costs s0/s1/s2 over a (2*nrad+1)-tap window with the
 *     corrected validity gates (all loads stay inside the 12-column mirrored
 *     pad margin; eedi3m's scalar s2 gate is looser and reads out of bounds)
 *   - per-column direction clamp umax = min(x, W-1-x, mdis)
 *   - DP predecessor window umax2 = min(x-1, W-x, mdis), relax over
 *     v in [max(-umax2,u-1), min(umax2,u+1)], ascending-v strict-< tie break
 *   - pbt stores RELATIVE predecessor deltas (int8, idx - u; backtracking
 *     accumulates)
 *   - masked columns (mclip) carry the previous column's path costs and
 *     backtrack rows with the two extreme fixups (eedi3m semantics)
 *   - interpolate: 4-tap cubic along the direction when the guard holds, else
 *     2-tap average; masked columns -> vertical cubic, direction 0
 *   - vcheck (single workgroup per plane, serialized row walk): the modified
 *     previous interp row is carried in a shared ping-pong buffer quantized to
 *     the io type, exactly like eedi3vk2's vcheck kernel.
 *
 * The host uploads eedi3m's exact padded plane (copyPad) in the NATIVE io
 * type (u16 stays u16, f32 stays f32): u16 values are exact integers < 2^24,
 * so float arithmetic on them reproduces the integer cost/interp math
 * bit-exactly (u16 io is only (re)quantized at stores and for vcheck's pixel
 * reads, where eedi3m does the same). f32 io passes through the pad unchanged.
 *
 * ENTRY_ROW runs the DP in per-lane REGISTERS with subgroup shuffles (see the
 * comment at the kernel): one 32-lane workgroup per interpolated row, each
 * lane owns K = ceil(TPITCH/32) directions, no workgroup barriers in the
 * column loop. Masked columns (mclip) are near-free register copies. The host
 * must request requiredSubgroupSize = 32 on this pipeline.
 *
 * Buffers (one subrange per plane per binding; the base element offsets of
 * each plane region are push constants because each binding's descriptor
 * range spans the whole buffer):
 *   b0 pad    float, padded plane (padStride x padHeight), MARGIN offsets
 *   b1 dst    io type, rows x WIDTH (tight) interpolated rows
 *   b2 pbt    int8, rows x WIDTH x TPITCH RELATIVE predecessor delta per
 *             (col,u) (idx - u; backtracking accumulates)
 *   b3 dmap   int8, rows x WIDTH direction per pixel (only VCHECK > 0)
 *   b4 bmask  uint8, rows x WIDTH dilated mclip mask (optional)
 *   b5 sclip  io type, rows x WIDTH (only VCHECK > 0 && HAS_SCLIP)
 *   b6 cint   io type, rows x WIDTH vertical cubic per pixel (only when
 *             VCHECK > 0 && !HAS_SCLIP)
 *
 * ENTRY_ROW grid (1, rows): one workgroup per interpolated row.
 * ENTRY_VCHECK grid (1, 1): one workgroup per plane; serial row walk. With
 * VCHECK_PARA the grid is (1, rows): one workgroup per row.
 *
 * Spec constants: 0 WIDTH, 1 NRAD, 2 MDIS, 3 HAS_MCLIP, 4 HAS_SCLIP,
 * 5 VCHECK_MODE, 6 local_size_row, 7 local_size_vcheck.
 */

#if !defined(BITS)
#define BITS 16
#endif

#if BITS == 16
#define IO_TYPE uint16_t
#define PEAK 65535.0f
#else
#define IO_TYPE float
#define PEAK 1.0f
#endif

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#if defined(ENTRY_ROW)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model
#endif

const float FLT_MAX_09 = 3.0616170017461927e+38f;  // FLT_MAX * 0.9
const float FLT_MAX_V = 3.402823466e+38f;          // FLT_MAX

layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int NRAD = 2;
layout(constant_id = 2) const int MDIS = 20;
layout(constant_id = 3) const int HAS_MCLIP = 0;
layout(constant_id = 4) const int HAS_SCLIP = 0;
layout(constant_id = 5) const int VCHECK_MODE = 2;

const int TPITCH = 2 * MDIS + 1;
const int CENTER = MDIS;
const int MARGIN_H = 12;
const int MARGIN_V = 4;

// backtrack + interpolate tile width (columns)
const int BT_TILE = 32;
// Diagnostics-only ablation level (0 = full kernel; 1 = store a zero pbt; 2 =
// return after the mask pack/span scan; 3 = return at entry; 4 = skip the pbt
// stores entirely; 5 = return after the DP, no backtrack; 6 = backtrack reads
// the previous row's pbt, i.e. no same-workgroup store->load dependency).
// 7 = the real walk PLUS a second, discarded walk over the PREVIOUS row's pbt
// (same dependent-load chain, but its lines were written by another workgroup,
// so it never hits a freshly-issued store). Output is unchanged, so it costs
// exactly one extra non-hazardous serial walk: if that is cheap, the cost of
// the real walk is the same-workgroup store visibility, not the chain latency.
// 8 = the same extra walk but with an f-INDEPENDENT address, so its loads can
// issue ahead of the chain. 7 vs 8 costs the dependent-address chain alone.
// 9 = keep the DP but store every column to the same 41 bytes (no store
// traffic, same instruction count) -> separates DP compute from store cost.
// 10 = 8's walk with an explicit 4x unroll so independent loads can overlap.
// 12 = like 2 but dmap is filled with a realistic direction pattern first, so
// the downstream vcheck's branch mix matches the real kernel.
// There is no PROBE 11 (the numbering skips it); 13 and above are unused.
// Kept as a tuning instrument. NOTE (round 20): the entry guard used to be
// `PROBE >= 3`, so levels 4-7 silently compiled to an EMPTY kernel (1656 B of
// SPIR-V, against 43720 B for PROBE=0) and the old "only 2/4/6 produced the
// cost model" claim is void for 4 and 6. Always `stat` the built .spv size
// after building a probe variant. The round-20 model used 2/5/6/7/8/9/10/12.
#ifndef PROBE
#define PROBE 0
#endif

// vcheck d2p source (see the ENTRY_VCHECK section): 1 = carry the modified
// previous interp row in shared memory, 0 = read it back from vout.
#ifndef VCHECK_LDS
#define VCHECK_LDS 0
#endif
// Parallel vcheck: the d2p term never reads a vcheck write, so rows have no
// ordering dependence and one workgroup owns each row. VCHECK_PARA picks how
// the d2p term is formed (each extra step costs more work and drifts less):
//   1 = the un-vchecked previous row (dst);
//   2..6 = + that many Jacobi steps (the predecessor's own parallel value).
#ifndef VCHECK_PARA
#define VCHECK_PARA 0
#endif
#if VCHECK_LDS && VCHECK_PARA
#error "VCHECK_LDS and VCHECK_PARA are mutually exclusive"
#endif
// Compile-time max plane width the LDS ping-pong can hold (per row buffer).
// CMake passes -DMAXW (EEDI3_MAXW); the host's fit check reads the same value.
#ifndef MAXW
#define MAXW 4096
#endif

// Entry points that touch only the raw/pad buffers, not the row-kernel
// helpers (pad_get/conn_cost/...), so those helpers must not be compiled in.
#if defined(ENTRY_PAD) || defined(ENTRY_XPOSE) || defined(ENTRY_COMPOSE) || \
    defined(ENTRY_ASSEMBLEV) || defined(ENTRY_BLIT) || \
    defined(ENTRY_MASKPACK) || defined(ENTRY_MASKDILATE)
#define ENTRY_NO_HELPERS 1
#endif

// Mask preparation compile-time configuration (the two mclip kernels only).
// The mask plane is read straight from the core's GPU frame, so its element
// type and the source layout are compile-time properties; CMake compiles one
// variant per mask format (and, for the dilate kernel, per source layout). The
// column step (1 under dh, else 2) is runtime -- it varies per frame with the
// interleaving field -- and arrives as pc.src_step.
#ifndef MASK_BITS
#define MASK_BITS 8
#endif
#ifndef MASK_TRANS
#define MASK_TRANS 0
#endif

// LDS staging type: 16-bit shared storage needs GL_EXT_shader_explicit_
// arithmetic_types_int16, so the u16 build stages through uint (the values are
// exact either way) and the f32 build through float.
#if BITS == 16
#define SHARED_T uint
#else
#define SHARED_T float
#endif

#if defined(ENTRY_XPOSE)
// EEDI3H/Horizontal transpose: the source plane is read in frame order with its
// own row pitch (binding 0) and written as the pad builder's packed layout R'
// (`rows` rows of WIDTH elements, binding 1): R'[k][y] = src[y][first+step*k].
// Each 16x16 tile goes through LDS so both the global load and the global store
// stay coalesced; the interior of the pad kernel's own layout is unchanged.
layout(std430, binding = 0) readonly buffer XposeSrc {
#if BITS == 16
    uint16_t xsrc[];
#else
    float xsrc[];
#endif
};
layout(std430, binding = 1) writeonly buffer XposeDst {
#if BITS == 16
    uint16_t xdst[];
#else
    float xdst[];
#endif
};
#elif defined(ENTRY_COMPOSE)
// Horizontal output assembly: reassemble the frame-order output plane (written
// through binding 2, an output frame plane with `dst_stride`) from the
// transposed kept rows (R', binding 0) and the interpolated values (binding 1:
// vout, or the row kernel's dst when there is no vcheck; VCHECK_MODE selects).
// In the EEDI3AA fused path (comp_fuse) binding 3 is the device-local home of
// the first sub-pass's O_0 plane that the second sub-pass merges against.
layout(std430, binding = 0) readonly buffer CompRt {
#if BITS == 16
    uint16_t crt[];
#else
    float crt[];
#endif
};
layout(std430, binding = 1) readonly buffer CompIn {
#if BITS == 16
    uint16_t cout[];
#else
    float cout[];
#endif
};
layout(std430, binding = 2) writeonly buffer CompOut {
#if BITS == 16
    uint16_t cout2[];
#else
    float cout2[];
#endif
};
layout(std430, binding = 3) buffer CompO0 {
#if BITS == 16
    uint16_t cdst[];
#else
    float cdst[];
#endif
};
#elif defined(ENTRY_ASSEMBLEV)
// EEDI3AA vertical merge: v[y] = (src[y] + vout_{y&1}[y>>1] + 1) >> 1 for u16
// (f32 averages 0.5*a + 0.5*b, which is std.Merge bitwise). The source row is
// read from the input frame plane directly (binding 0, pitch `src_stride`);
// binding 1/2 are the two sub-passes' vout rows and binding 3 the merged frame.
layout(std430, binding = 0) readonly buffer AsmSrc { IO_TYPE asm_src[]; };
layout(std430, binding = 1) readonly buffer AsmVout { IO_TYPE asm_vout[]; };
layout(std430, binding = 2) readonly buffer AsmVout2 { IO_TYPE asm_vout2[]; };
layout(std430, binding = 3) writeonly buffer AsmOut { IO_TYPE asm_out[]; };
#elif defined(ENTRY_PAD)
// ENTRY_PAD expands the mirror margins into the built pad (binding 1). Its
// source (binding 0) is either the input frame plane read in frame order with
// `src_stride` (vertical) or the packed R' ENTRY_XPOSE produced (horizontal);
// PAD_SRC_PITCHED selects, so the mirror logic itself never changes.
layout(std430, binding = 0) readonly buffer PadSrc {
#if BITS == 16
    uint16_t pdsrc[];
#else
    float pdsrc[];
#endif
};
layout(std430, binding = 1) writeonly buffer PadOutBuf {
#if BITS == 16
    uint16_t padOut[];
#else
    float padOut[];
#endif
};
#elif defined(ENTRY_MASKPACK)
// Horizontal mask preparation: transpose the mask plane's predicate bits.
// binding 0 is the mask plane in frame order (element type per MASK_BITS, row
// pitch `src_stride`); binding 1 is the packed transposed bit matrix (one u32
// per 32 source rows per output row). ENTRY_MASKDILATE then dilates each row.
layout(std430, binding = 0) readonly buffer MaskSrc {
#if MASK_BITS == 8
    uint8_t msk8[];
#elif MASK_BITS == 16
    uint16_t msk16[];
#else
    float msk32[];
#endif
};
layout(std430, binding = 1) writeonly buffer PredOut { uint predout[]; };
#elif defined(ENTRY_MASKDILATE)
// Mask dilation: `out[x] = OR over |t| <= MDIS of predicate(src[x+t])`, the
// per-interp-row copyMask dilation. binding 0 is either the raw mask plane (one
// element per column, MASK_TRANS == 0) or the packed transposed predicate
// matrix ENTRY_MASKPACK produced (MASK_TRANS == 1); binding 1 is the row
// kernel's packed u32 mask row.
layout(std430, binding = 0) readonly buffer DilSrc {
#if MASK_TRANS == 1
    uint dilsrc_bits[];
#else
#if MASK_BITS == 8
    uint8_t dilsrc8[];
#elif MASK_BITS == 16
    uint16_t dilsrc16[];
#else
    float dilsrc32[];
#endif
#endif
};
layout(std430, binding = 1) writeonly buffer DilOut { uint dilout[]; };
#elif defined(ENTRY_BLIT)
// Output-plane writer: every row of the output frame plane (binding 2, pitch
// `dst_stride`) is either an interpolated row (binding 0: vout, or the row
// kernel's dst when there is no vcheck) or a kept source row (binding 1, the
// input frame plane with `src_stride`). Writing kept rows here instead of
// copying the source plane keeps the whole output in one dispatch.
layout(std430, binding = 0) readonly buffer BlitIn { IO_TYPE blit_in[]; };
layout(std430, binding = 1) readonly buffer BlitSrc { IO_TYPE blit_src[]; };
layout(std430, binding = 2) writeonly buffer BlitOut { IO_TYPE blit_out[]; };
#else
layout(std430, binding = 0) readonly buffer PadBuf {
#if BITS == 16
    // Native u16 pad (built by ENTRY_PAD from the source plane). Every value is
    // < 2^16 so float() is exact and all downstream cost/interp math is
    // bit-identical to the host-built float pad.
    uint16_t pad[];
#else
    float pad[];
#endif
};
layout(std430, binding = 1) buffer DstBuf { IO_TYPE dst[]; };
layout(std430, binding = 2) buffer PbtBuf { int8_t pbt[]; };
layout(std430, binding = 3) buffer DmapBuf { int8_t dmap[]; };
// Packed dilated mask row (one u32 per 32 columns), built by ENTRY_MASKDILATE.
layout(std430, binding = 4) readonly buffer BmaskBuf { uint bmask[]; };
// vcheck sclip source: the sclip plane read in frame order at pitch
// `sclip_stride` (vertical) or the packed transposed B' (horizontal; HORIZ
// selects, and the base is then r*WIDTH+x).
layout(std430, binding = 5) readonly buffer SclipBuf { IO_TYPE sclip[]; };
layout(std430, binding = 6) buffer CintBuf { IO_TYPE cint[]; };
layout(std430, binding = 7) buffer VoutBuf { IO_TYPE vout[]; };
#endif

layout(push_constant) uniform PC {
    // per-plane element bases into each binding's descriptor range
    int pad_base;     // pad elements into b0 (padded plane)
    int dst_base;     // io elements into b1 (interp rows)
    int pbt_base;     // int8 elements into b2
    int dmap_base;    // int8 elements into b3
    int bmask_base;   // uint words into b4
    int sclip_base;   // io elements into b5
    int cint_base;    // io elements into b6
    int vout_base;    // io elements into b7 (vcheck output rows)
    int pad_stride;   // padded plane row pitch in pad elements
    int pad_height;   // padded plane height in rows
    int field;        // parity of the interpolated dst rows (0/1)
    int rows;         // number of interpolated rows (== kept source rows)
    float alpha;      // raw alpha / 3 (cost3 always on)
    float beta;
    float gamma;
    float rw;         // 1 - raw alpha - raw beta
    float vth0r;
    float vth1r;
    float vth2r;
    float vth2;
    // ENTRY_PAD / ENTRY_XPOSE / ENTRY_BLIT / ENTRY_ASSEMBLEV: element base and
    // row pitch (in elements) of the SOURCE frame plane. ENTRY_BLIT also uses
    // src_stride for its kept rows.
    int raw_base;
    int rempty_base;  // int8 base of the per-row empty flags
    // ENTRY_BLIT / ENTRY_COMPOSE: row pitch of the OUTPUT frame plane.
    int dst_stride;
    int src_stride;   // source plane pitch, in elements
    int sclip_stride; // ENTRY_VCHECK only: sclip plane pitch (vertical)
    int src_first;    // ENTRY_XPOSE/ENTRY_PAD: first kept source column/row
    int src_step;     // ENTRY_XPOSE/ENTRY_PAD: kept parity step (1 under dh)
    // ENTRY_COMPOSE / ENTRY_ASSEMBLEV only: element base of the assembled plane.
    int out_base;
    // ENTRY_ASSEMBLEV only: io-element base of the second sub-pass's vout rows.
    int vout2_base;
    // ENTRY_COMPOSE only, EEDI3AA fused horizontal output:
    //   0 = one plane per sub-pass (write O to the output frame directly);
    //   1 = first sub-pass: park the assembled O_0 plane in binding 3;
    //   2 = second sub-pass: read O_0 from binding 3, assemble O_1 and write
    //       the 50/50 merge of the two straight to the output frame.
    int comp_fuse;
    // ENTRY_PAD only: 1 when the source is the packed R' (horizontal).
    int pad_src_pitched;
} pc;

// Padded-plane access at OUTPUT dst-row coordinates. copyPad places every
// kept source row at pad row MARGIN_V + <output dst row> (dh=0: 1:1; dh=1:
// kept output dst rows of parity 1-field come from source rows in order), so
// interp rows (parity `field`) read their +/-1, +/-3 taps (kept rows) at
// pad row MARGIN_V + dy +/- {1,3} — always in bounds thanks to the mirrored
// vertical margins the host builds (same for the horizontal margins).
// (Not compiled into ENTRY_PAD/ENTRY_XPOSE/ENTRY_COMPOSE: those entries only
// have the raw/pad buffers.)
#if !defined(ENTRY_NO_HELPERS)
float pad_get(int dst_row, int col) {
#if BITS == 16
    // Widen via int (int(uint16) already compiles under the 16-bit storage
    // extension; a direct float(uint16) would need int16 arithmetic); exact.
    return float(int(pad[pc.pad_base + (MARGIN_V + dst_row) * pc.pad_stride + MARGIN_H + col]));
#else
    return pad[pc.pad_base + (MARGIN_V + dst_row) * pc.pad_stride + MARGIN_H + col];
#endif
}

float load_dst_val(int r, int x) {
#if BITS == 16
    return float(int(dst[pc.dst_base + r * WIDTH + x]));
#else
    return dst[pc.dst_base + r * WIDTH + x];
#endif
}

float load_sclip_val(int r, int x) {
    // Vertical: the sclip plane read in frame order at interp row field+2r.
    // Horizontal: the packed transposed B' the xpose pass produced, one row of
    // WIDTH per interp row. HORIZ folds the choice away at pipeline creation.
    const int i = (pc.pad_src_pitched != 0)
        ? (pc.sclip_base + r * WIDTH + x)
        : (pc.sclip_base + (pc.field + 2 * r) * pc.sclip_stride + x);
#if BITS == 16
    return float(int(sclip[i]));
#else
    return sclip[i];
#endif
}

// io store: u16 rounds half-up + clamps to [0, peak], which reproduces
// eedi3m's integer (X + 8) >> 4 / (a + b + 1) >> 1 arithmetic evaluated on
// exact float taps (see design notes); f32 stores pass through unchanged.
void store_dst_val(int r, int x, float v) {
#if BITS == 16
    dst[pc.dst_base + r * WIDTH + x] = IO_TYPE(uint(clamp(floor(v + 0.5f), 0.0f, PEAK)));
#else
    dst[pc.dst_base + r * WIDTH + x] = v;
#endif
}

// Vertical 4-tap cubic at column x of interp dst row dy (kept rows dy +/- 1
// and dy +/- 3). Integer formats reproduce the clamp/round of the int cubic
// through store_dst_val / the cint quantizer; float uses exact weights.
float cubic_float(int dy, int x) {
    return 0.5625f * (pad_get(dy - 1, x) + pad_get(dy + 1, x))
         - 0.0625f * (pad_get(dy - 3, x) + pad_get(dy + 3, x));
}

// Connection cost for interp dst row dy, column x, direction u.
// u16: s0/s1/s2/v are integer SAD sums accumulated in float (exact, terms
// stay below 2^24). Cost combine matches eedi3m's float order.
float conn_cost(int dy, int x, int u) {
    const int u2 = 2 * u;
    float s0 = 0.0f;
    float s1 = 0.0f;
    float s2 = 0.0f;
    const bool s1_ok = (u >= 0 && x >= u2) || (u <= 0 && x < WIDTH + u2);
    const bool s2_ok = (u <= 0 && x >= -u2) || (u >= 0 && x < WIDTH - u2);

    for (int k = -NRAD; k <= NRAD; ++k) {
        s0 += abs(pad_get(dy - 3, x + u + k) - pad_get(dy - 1, x - u + k))
            + abs(pad_get(dy - 1, x + u + k) - pad_get(dy + 1, x - u + k))
            + abs(pad_get(dy + 1, x + u + k) - pad_get(dy + 3, x - u + k));
        if (s1_ok) {
            s1 += abs(pad_get(dy - 3, x + k) - pad_get(dy - 1, x - u2 + k))
                + abs(pad_get(dy - 1, x + k) - pad_get(dy + 1, x - u2 + k))
                + abs(pad_get(dy + 1, x + k) - pad_get(dy + 3, x - u2 + k));
        }
        if (s2_ok) {
            s2 += abs(pad_get(dy - 3, x + u2 + k) - pad_get(dy - 1, x + k))
                + abs(pad_get(dy - 1, x + u2 + k) - pad_get(dy + 1, x + k))
                + abs(pad_get(dy + 1, x + u2 + k) - pad_get(dy + 3, x + k));
        }
    }
    const float S1 = s1_ok ? s1 : (s2_ok ? s2 : s0);
    const float S2 = s2_ok ? s2 : S1;

    // cost3 is always on (GPU family semantics: eedi3vk2/vszip* have no
    // cost3 switch and always divide alpha by 3 and sum s0+s1+s2).
    // ip is the inner 2-tap average. eedi3m computes it in INTEGER domain
    // ((a + b + 1) >> 1 == round-half-up on the exact mean) for integer
    // formats, which feeds an integer |x - ip| difference — for odd sums the
    // plain float midpoint (a+b)/2 differs by 0.5, shifting the v penalty by
    // up to 1 and flipping near-tie argmins (seen at nrad=3). Reproduce the
    // integer v exactly. Float formats use the exact midpoint.
#if BITS == 16
    const float t1 = pad_get(dy - 1, x + u);
    const float t2 = pad_get(dy + 1, x - u);
    const float ip = floor((t1 + t2 + 1.0f) * 0.5f);
    const float c1 = pad_get(dy - 1, x);
    const float c2 = pad_get(dy + 1, x);
    const float v = abs(c1 - ip) + abs(c2 - ip);
#else
    const float ip = (pad_get(dy - 1, x + u) + pad_get(dy + 1, x - u)) * 0.5f;
    const float v = abs(pad_get(dy - 1, x) - ip) + abs(pad_get(dy + 1, x) - ip);
#endif

    return pc.alpha * (s0 + S1 + S2) + pc.beta * float(abs(u)) + pc.rw * v;
}

// ---------------------------------------------------------------------------
// Rolling connection costs (the hot path).
//
// Each of s0/s1/s2 is a (2*NRAD+1)-term window sum over k of a per-(x,u)
// leading term. Sliding x by +1 shifts every window by one term, so advancing
// a window costs ONE new leading-term eval (9 pad loads) instead of the full
// (2*NRAD+1)-term recompute (~90 loads). Measured: full conn_cost per
// (column, direction) is ~70% of row-kernel time (zeroing it took vcheck=0
// full-DP 2160p from 116 -> 278 fps). For u16 the pad values are exact
// integers < 2^24 so window sums are exact regardless of accumulation order;
// f32 may differ from the reference in rounding order by ~ulp (acceptable).
//
// The three windows of cost3 (cost3 is always on):
//   s0(x,u) = sum_k A(x+u+k, x-u+k)
//   s1(x,u) = sum_k A(x+k,   x-2u+k)
//   s2(x,u) = sum_k A(x+2u+k, x+k)
// with A(i,j) = |p3(i)-p1(j)| + |p1(i)-n1(j)| + |n1(i)-n3(j)| over the four
// kept rows around the interpolated dst row (p3 = dy-3 ... n3 = dy+3).
const int RING_CAP = 7;   // >= 2*NRAD+1 for NRAD <= 3 (fixed bound -> registers)
#define RN (2 * NRAD + 1)

float rowA(int dy, int i, int j) {
    return abs(pad_get(dy - 3, i) - pad_get(dy - 1, j))
         + abs(pad_get(dy - 1, i) - pad_get(dy + 1, j))
         + abs(pad_get(dy + 1, i) - pad_get(dy + 3, j));
}

// Seed the three windows at column x (fresh full evaluation, k ascending).
void roll_seed(int dy, int x, int u, out float s0, out float s1, out float s2,
               inout float r0[RING_CAP], inout float r1[RING_CAP],
               inout float r2[RING_CAP]) {
    s0 = 0.0f; s1 = 0.0f; s2 = 0.0f;
    for (int k = 0; k < RING_CAP; ++k) {
        if (k >= RN) break;
        const float t0 = rowA(dy, x + u + k - NRAD, x - u + k - NRAD);
        const float t1 = rowA(dy, x + k - NRAD, x - 2 * u + k - NRAD);
        const float t2 = rowA(dy, x + 2 * u + k - NRAD, x + k - NRAD);
        r0[k] = t0; r1[k] = t1; r2[k] = t2;
        s0 += t0; s1 += t1; s2 += t2;
    }
}

// Advance the seeded windows from column x to column x+1.
void roll_push(int dy, int x, int u, inout float s0, inout float s1, inout float s2,
               inout float r0[RING_CAP], inout float r1[RING_CAP],
               inout float r2[RING_CAP]) {
    const float l0 = rowA(dy, x + u + NRAD + 1, x - u + NRAD + 1);
    const float l1 = rowA(dy, x + NRAD + 1, x - 2 * u + NRAD + 1);
    const float l2 = rowA(dy, x + 2 * u + NRAD + 1, x + NRAD + 1);
    s0 += l0 - r0[0];
    s1 += l1 - r1[0];
    s2 += l2 - r2[0];
    for (int k = 0; k < RING_CAP - 1; ++k) {
        if (k >= RN - 1) break;
        r0[k] = r0[k + 1]; r1[k] = r1[k + 1]; r2[k] = r2[k + 1];
    }
    r0[RN - 1] = l0; r1[RN - 1] = l1; r2[RN - 1] = l2;
}

// Combined cost (cost3 semantics, mirroring conn_cost's tail) from window
// sums that are all valid (interior columns: every gate holds).
float combine_interior(int dy, int x, int u, float s0, float s1, float s2) {
    const float S1 = s1;
    const float S2 = s2;
#if BITS == 16
    const float t1 = pad_get(dy - 1, x + u);
    const float t2 = pad_get(dy + 1, x - u);
    const float ip = floor((t1 + t2 + 1.0f) * 0.5f);
    const float c1 = pad_get(dy - 1, x);
    const float c2 = pad_get(dy + 1, x);
    const float v = abs(c1 - ip) + abs(c2 - ip);
#else
    const float ip = (pad_get(dy - 1, x + u) + pad_get(dy + 1, x - u)) * 0.5f;
    const float v = abs(pad_get(dy - 1, x) - ip) + abs(pad_get(dy + 1, x) - ip);
#endif
    return pc.alpha * (s0 + S1 + S2) + pc.beta * float(abs(u)) + pc.rw * v;
}
#endif  // !ENTRY_PAD
#if defined(ENTRY_ROW)

// Per-interp-row DP in REGISTERS with subgroup shuffles (eedi3vk2 structure):
// one workgroup of SGSIZE lanes per interpolated row, each lane owns
// K = ceil(TPITCH / SGSIZE) consecutive directions in private registers, so
// the per-column relax reads its +-1 predecessor window from the other lanes'
// registers via subgroupShuffleUp/Down — zero workgroup barriers in the column
// loop. Masked columns (mclip) are near-free: cur = pp register copy + pumax
// fixups + one pbt byte per lane. Backtrack/interpolate happens tile-by-tile
// (BT_TILE columns per tile) from a shared copy of the relative-delta pbt
// rows, exactly like eedi3vk2.
//
// pbt stores RELATIVE predecessor deltas (idx - u, int8), so backtracking
// accumulates: fpath[x] = fpath[x+1] + pbt[x][CENTER + fpath[x+1]].
//
// Connection costs keep the rolling window sums per direction (s0/s1/s2 +
// RING_CAP term rings per owned direction). Rolling is only valid across
// consecutive unmasked interior columns; a masked column or a column outside
// the direction's interior band invalidates the state (next interior column
// reseeds with the full window). This matches the barrier version's cost math
// bit-for-bit (same roll_seed/roll_push/combine_interior), so u16 stays
// bit-exact vs eedi3vk2 and f32 keeps its ~1 ulp measured band.
//
// The workgroup is a single 32-lane subgroup; each workgroup processes one
// interpolated row. The host requests requiredSubgroupSize = 32 for this
// pipeline (RDNA3's native 64-lane wavefront is split via the subgroup size
// control feature). NOTE (round 6): a 2-subgroup x 2-row-per-WG variant was
// tried and measured SLOWER on the mclip workload (see notes) — keep 1 row/WG.
const int SGSIZE = 32;                       // == workgroup size (host sets it)
const int K = (TPITCH + SGSIZE - 1) / SGSIZE;  // directions per lane

// pbt column layout. The relative predecessor delta is -1/0/+1, so when each
// lane owns exactly two directions (MDIS 17..31, i.e. K == 2, which includes
// the mdis=20 default) the whole column packs into one nibble per lane -- 16
// bytes instead of TPITCH=41, a 2.6x cut in the row kernel's store traffic
// (measured worth ~10% of the frame ungated; PROBE=4). Even lanes combine their
// odd neighbour's nibble through a shuffle and store one byte, so the packing
// adds no barrier. Other K keep the plain int8 column.
const bool PB_PACK = (K == 2);
const int PB_STRIDE = PB_PACK ? (SGSIZE / 2) : TPITCH;   // bytes per column

int pbt_delta(const int base, const int x, const int e) {
    if (PB_PACK) {
        const uint b = uint(pbt[base + x * PB_STRIDE + (e >> 2)]);
        return int((b >> uint((e & 3) * 2)) & 3u) - 1;
    }
    return int(pbt[base + x * PB_STRIDE + e]);
}

// Packed store: lane `lane` owns directions 2*lane and 2*lane+1, one nibble.
// The odd lane's nibble reaches its even partner through a shuffle, so a single
// even lane writes the whole byte and there is no write-write race.
void pbt_store_pair(const int base, const int x, const int lane, const int c0, const int c1) {
    const uint nib = (uint(c0 + 1) & 3u) | ((uint(c1 + 1) & 3u) << 2);
    const uint hi = subgroupShuffleXor(nib, 1u) & 0xFu;
    if ((lane & 1) == 0) {
        pbt[base + x * PB_STRIDE + (lane >> 1)] = int8_t(nib | (hi << 4));
    }
}

void pbt_store_one(const int base, const int x, const int e, const int v) {
    pbt[base + x * PB_STRIDE + e] = int8_t(v);
}

// tileF carries the per-column direction from the lane-0 backtrack walk to the
// parallel interpolate lanes. (The old tileSh staging buffer is gone: the walk
// now reads pbt directly from global — see the backtrack comment.)
shared int8_t tileF[BT_TILE];
shared uint bmaskSh[(WIDTH + 31) / 32];
// First unmasked column of this row (WIDTH = fully masked). Written by lane
// 0 after the pack loop, read by all lanes after a barrier.
shared int rowXmin;

layout(local_size_x_id = 6) in;

// Shared packed-bit test of the current row's mask (bmaskSh filled by the
// pack loop in main). HAS_MCLIP == 0 pipelines return true (nothing masked).
bool bmask_local(int x) {
    if (HAS_MCLIP == 0) return true;
    return (bmaskSh[x >> 5] & (1u << (x & 31))) != 0u;
}

void main() {
    const int lane = int(gl_SubgroupInvocationID);
    const int r = int(gl_WorkGroupID.y);
    const int dy = pc.field + 2 * r;
    const int pbt_row = pc.pbt_base + r * (WIDTH * PB_STRIDE);
    const int laneBase = lane * K;

#if PROBE == 3
    if (lane == 0) dmap[pc.rempty_base + r] = int8_t(0);
    return;
#endif
    if (HAS_MCLIP != 0) {
        // The host uploads this row's dilated mask PRE-PACKED (one uint per
        // 32 columns); burst-copy the words to shared instead of packing
        // bytes here (8x less upload + no per-bit work).
        for (int i = lane; i < (WIDTH + 31) / 32; i += SGSIZE)
            bmaskSh[i] = bmask[pc.bmask_base + r * ((WIDTH + 31) / 32) + i];
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        // Span scan: first unmasked column of this row (lane 0 walks the
        // packed words; ~WIDTH/32 iterations of trivial ops, negligible next
        // to the 3840-iteration serial column loop it lets us shorten).
        // Lets the DP jump over the fully-masked left tail [1, xmin):
        // masked columns only CARRY the cost row (cur = pp, values never
        // change) so the seed at xmin-1 is analytically exact (all zeros
        // after the xd==1 zeroing; pRel adjusted below for the fixups).
        if (lane == 0) {
            int first = WIDTH;
            for (int i = 0; i < (WIDTH + 31) / 32; ++i) {
                const uint w = bmaskSh[i];
                if (w != 0u) {
                    first = i * 32 + findLSB(w);
                    break;
                }
            }
            rowXmin = first;
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }
    const int xmin = (HAS_MCLIP != 0) ? rowXmin : 0;

    // Per-row empty flag for the vcheck split (lane 0; uniform, no
    // divergence): fully-masked rows skip the serial vcheck walk.
    if (lane == 0)
        dmap[pc.rempty_base + r] = int8_t(xmin >= WIDTH ? 1 : 0);
#if PROBE == 12
    // Faithful "no row kernel" ablation: the DP/backtrack/interpolate are all
    // skipped, but dmap is filled with a REALISTIC direction pattern (0 on
    // masked columns, nonzero on the DP columns) so the downstream vcheck takes
    // the same branch mix it takes on the real kernel. PROBE 2 returns with
    // dmap stale, which leaves the vcheck on its dirc==0 fast branch and
    // therefore overstates the row kernel's share.
    for (int x = lane; x < WIDTH; x += SGSIZE)
        dmap[pc.dmap_base + r * WIDTH + x] = int8_t((x >= xmin) ? 1 : 0);
    return;
#endif
#if PROBE == 2
    return;
#endif

    if (xmin >= WIDTH) {
        // Fully-masked row (measured ~53% of rows in the AA workload): every
        // pixel interpolates the vertical cubic with direction 0, so the
        // whole serial DP/carry/backtrack is pure waste. Parallel cubic over
        // all lanes instead — bit-exact vs the masked_x branch below.
        for (int x = lane; x < WIDTH; x += SGSIZE) {
            const float oval = cubic_float(dy, x);
            if (VCHECK_MODE > 0) {
                dmap[pc.dmap_base + r * WIDTH + x] = int8_t(0);
                if (HAS_SCLIP == 0) {
#if BITS == 16
                    cint[pc.cint_base + r * WIDTH + x] =
                        IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                    cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
                }
            }
            store_dst_val(r, x, oval);
        }
        return;
    }

    // Per-direction DP state (registers). u = laneBase + j - CENTER.
    float pp[K];   // previous column's path costs
    int pRel[K];   // previous column's relative backtrack delta (mclip copy)
    float s0[K], s1[K], s2[K];          // rolling window sums
    float r0[K][RING_CAP], r1[K][RING_CAP], r2[K][RING_CAP];  // term rings
    bool rolled[K];                     // rolling state valid (unmasked interior run)

    for (int j = 0; j < K; j++) {
        pp[j] = 0.0f;
        pRel[j] = 0;
        s0[j] = 0.0f; s1[j] = 0.0f; s2[j] = 0.0f;
        rolled[j] = false;
    }

    // Column 0: only u == 0 carries its connection cost. A masked column 0 is
    // pinned to 0 (eedi3m would read uninitialized memory; eedi3vk2 pins 0).
    for (int j = 0; j < K; j++) {
        if (laneBase + j == CENTER && (HAS_MCLIP == 0 || bmask_local(0))) {
            pp[j] = conn_cost(dy, 0, 0);
        }
    }

    if (HAS_MCLIP != 0 && xmin > 1) {
        // Analytic predecessor seed for the jump over the masked left tail
        // [1, xmin): columns 0-1 are masked (else xmin <= 1), so xd==1 would
        // have zeroed pRel to -u; each later masked column xd applies fixups
        // cRel = +/-1 at lanes u = -/+(pumax) with pumax = min(xd-1, WIDTH-xd)
        // (values pp stay all zeros — masked columns only copy them). The
        // last fixup hit wins; both ramps give the same value (-sign(u)), so
        // pRel[u] = -sign(u) iff some xd in [2, xmin) has min(xd-1, WIDTH-xd)
        // == |u| (rising ramp: xd = |u|+1 < xmin; falling ramp: xd = WIDTH-|u|,
        // only reachable when the span starts in the last |u| columns).
        // Bit-exact vs running the skipped iterations (verified in tests).
        for (int j = 0; j < K; j++) {
            const int i = laneBase + j;
            if (i < TPITCH) {
                const int u = i - CENTER;
                const int au = abs(u);
                if (au >= 1 && au <= MDIS) {
                    const bool hit = (au <= xmin - 2) ||
                        (xmin > WIDTH - au && au <= WIDTH - 2);
                    pRel[j] = hit ? ((u > 0) ? -1 : 1) : -u;
                } else {
                    pRel[j] = -u;
                }
            }
        }
    }

    const int xstart = max(1, xmin);
    for (int xd = xstart; xd < WIDTH; xd++) {
        const int umax = min(min(xd, WIDTH - 1 - xd), MDIS);
        const bool masked = (HAS_MCLIP != 0 && !bmask_local(xd));

        float cur[K];
        // Sized for the packed store, which reads both entries when K == 2;
        // K == 1 still indexes cRel[0] only.
        int cRel[K > 1 ? K : 2];

        if (masked) {
            // Masked column: cost row + backtrack row carry from the previous
            // column (eedi3m semantics); the two extreme entries get fixups so
            // the path stays inside the narrower reachable set. Rolling state
            // is invalid (windows could not advance over this column).
            if (xd == 1) {
                // ccosts at column 1 were never computed (pinned 0); backtrack
                // pointers zeroed (absolute v = 0 -> rel = -u).
                for (int j = 0; j < K; j++) {
                    cur[j] = 0.0f;
                    cRel[j] = -(laneBase + j - CENTER);
                    rolled[j] = false;
                }
            } else {
                const int pumax = min(xd - 1, WIDTH - xd);
                for (int j = 0; j < K; j++) {
                    const int i = laneBase + j;
                    cur[j] = pp[j];
                    cRel[j] = pRel[j];
                    rolled[j] = false;
                    if (pumax < MDIS) {
                        if (i == CENTER - pumax)
                            cRel[j] = (1 - pumax) - (i - CENTER);
                        else if (i == CENTER + pumax)
                            cRel[j] = (pumax - 1) - (i - CENTER);
                    }
                }
            }
            if (PB_PACK) {
                pbt_store_pair(pbt_row, xd - 1, lane, cRel[0], cRel[1]);
            } else {
                for (int j = 0; j < K; j++) {
                    if (laneBase + j < TPITCH) {
#if PROBE == 1
                        pbt_store_one(pbt_row, xd - 1, laneBase + j, 0);
#elif PROBE == 4
                        ;  // diagnostics: no pbt store at all (traffic ablation)
#elif PROBE == 9
                        // diagnostics: keep the DP, write every column to the
                        // SAME bytes (no xd in the address) -> ~zero traffic.
                        pbt_store_one(pbt_row, 0, laneBase + j, cRel[j]);
#else
                        pbt_store_one(pbt_row, xd - 1, laneBase + j, cRel[j]);
#endif
                    }
                }
            }
        } else {
            // Unmasked column: gather the previous column's path costs
            // [laneBase - 1, laneBase + K] from the subgroup's registers (the
            // +-1 neighbour window of the relax), then per-direction cost + DP.
            float ext[K + 2];
            for (int e = 0; e < K + 2; e++) {
                const int idx = e - 1;   // relative to laneBase
                if (idx < 0) {
                    const int q = (-idx + K - 1) / K;
                    ext[e] = subgroupShuffleUp(pp[idx + q * K], q);
                } else if (idx >= K) {
                    const int q = (idx - K) / K + 1;
                    ext[e] = subgroupShuffleDown(pp[idx - q * K], q);
                } else {
                    ext[e] = pp[idx];
                }
            }

            const int umax2 = min(min(xd - 1, WIDTH - xd), MDIS);

            for (int j = 0; j < K; j++) {
                const int i = laneBase + j;
                const int u = i - CENTER;
                const int au = abs(u);
                const bool laneActive = (i < TPITCH && au <= umax);

                cur[j] = pp[j];
                cRel[j] = pRel[j];

                if (laneActive) {
                    float ccost;
                    {
                        // Rolling windows are used on BOTH the mclip and the
                        // no-mclip path (round 15: the old "rolling with mclip
                        // buys nothing" verdict came from the all-zero-mask
                        // benchmark, where no column was ever unmasked, so the
                        // rolling path never ran). With mclip the state simply
                        // dies at each masked column and reseeds at the next
                        // unmasked interior one, which still costs one 9-load
                        // seed instead of a ~51-load full conn_cost recompute
                        // per unmasked direction.
                        const bool interior = (xd >= 2 * au && xd <= WIDTH - 1 - 2 * au);
                        if (interior) {
                            if (!rolled[j]) {
                                roll_seed(dy, xd, u, s0[j], s1[j], s2[j],
                                          r0[j], r1[j], r2[j]);
                                rolled[j] = true;
                            } else {
                                roll_push(dy, xd - 1, u, s0[j], s1[j], s2[j],
                                          r0[j], r1[j], r2[j]);
                            }
                            ccost = combine_interior(dy, xd, u, s0[j], s1[j], s2[j]);
                        } else {
                            rolled[j] = false;
                            ccost = conn_cost(dy, xd, u);
                        }
                    }

                    // DP relax over v in [u-1, u+1] (subset of |v| <= umax2 by
                    // construction), ascending v, strict < keeps the lowest v
                    // on ties. ext[e] = pp of direction laneBase + e - 1.
                    float bval = FLT_MAX_V;
                    int idx = 0;
                    for (int dd = -1; dd <= 1; dd++) {
                        const int v = u + dd;
                        if (abs(v) <= umax2) {
                            const float z = ext[j + 1 + dd] + pc.gamma * float(abs(dd));
                            const float cc = min(z, FLT_MAX_09);
                            if (cc < bval) {
                                bval = cc;
                                idx = v;
                            }
                        }
                    }
                    const float pcost = min(bval + ccost, FLT_MAX_09);
                    cur[j] = pcost;
                    cRel[j] = idx - u;
                }
                if (PB_PACK) {
                    // Both of this lane's deltas now exist; the packed form
                    // stores once per lane pair, so it sits outside the loop.
                    pbt_store_pair(pbt_row, xd - 1, lane, cRel[0], cRel[1]);
                } else {
                    for (int j = 0; j < K; j++) {
                        if (laneBase + j < TPITCH) {
#if PROBE == 1
                            pbt_store_one(pbt_row, xd - 1, laneBase + j, 0);
#elif PROBE == 4
                            ;  // diagnostics: no pbt store at all (traffic ablation)
#elif PROBE == 9
                            pbt_store_one(pbt_row, 0, laneBase + j, cRel[j]);
#else
                            pbt_store_one(pbt_row, xd - 1, laneBase + j, cRel[j]);
#endif
                        }
                    }
                }
            }
        }

        for (int j = 0; j < K; j++) {
            pp[j] = cur[j];
            pRel[j] = cRel[j];
        }
    }

    // Make the pbt writes visible to this subgroup's backtrack reads.
    subgroupMemoryBarrier();
    subgroupBarrier();

    // The rightmost column always takes direction 0 (fpath[WIDTH-1] == 0);
    // direction 0 interpolates to the vertical cubic (ucubic always on).
    if (lane == 0) {
        const int x = WIDTH - 1;
        const float oval = cubic_float(dy, x);
        if (VCHECK_MODE > 0) {
            dmap[pc.dmap_base + r * WIDTH + x] = int8_t(0);
            if (HAS_SCLIP == 0) {
#if BITS == 16
                cint[pc.cint_base + r * WIDTH + x] =
                    IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
            }
        }
        store_dst_val(r, x, oval);
    }
    subgroupBarrier();

    // Backtrack from the right in tiles (relative deltas accumulate); lane 0
    // walks each tile backwards from fcarry. Tiles entirely left of the
    // first unmasked column need no walk: nothing left of xmin reads
    // directions (all masked -> cubic), so stop there (bit-exact: the walk
    // right of xmin is untouched, fcarry propagates identically).
#if PROBE == 5
    // Diagnostics: DP + pbt stores only, no backtrack/interpolate.
    return;
#endif
    int fcarry = 0;  // fpath[x0 + n]; starts at fpath[WIDTH - 1] == 0
#if PROBE == 6
    // Diagnostics: read the PREVIOUS row's pbt so the backtrack has no
    // same-workgroup store->load dependency on the DP stores above. This is
    // the probe that isolated the round-15 finding: uncoupled 718/606 fps
    // (vc0/vc2) versus 308/264 coupled, while the DP+stores alone and the
    // backtrack alone are each ~free.
    const int pbt_src = (r >= 1) ? (pbt_row - WIDTH * PB_STRIDE) : pbt_row;
#else
    const int pbt_src = pbt_row;
#endif
    for (int x0 = ((WIDTH - 2) / BT_TILE) * BT_TILE; x0 >= 0; x0 -= BT_TILE) {
        const int n = min(BT_TILE, WIDTH - 1 - x0);
        if (x0 + n <= xmin) {
            // Tile entirely left of the first DP column: no walk is needed
            // (nothing here reads a direction), but the vertical cubic MUST
            // still be written. Skipping it left `dst` stale for every column
            // below the first DP column — uninitialized memory on the first
            // frame and a recycled resource's previous contents afterwards.
            // That was the structured-mclip nondeterminism (round 15/16): a
            // mask whose first processed column is far enough right that a
            // whole tile gets skipped, which is why an all-zero mask (xmin =
            // WIDTH, handled by the parallel-cubic branch), an all-white mask
            // (xmin = 0) and the noise-clip half/half mask never showed it.
            for (int x = lane; x < n; x += SGSIZE) {
                const int xt = x0 + x;
                const float oval = cubic_float(dy, xt);
                if (VCHECK_MODE > 0) {
                    dmap[pc.dmap_base + r * WIDTH + xt] = int8_t(0);
                    if (HAS_SCLIP == 0) {
#if BITS == 16
                        cint[pc.cint_base + r * WIDTH + xt] =
                            IO_TYPE(uint(clamp(floor(cubic_float(dy, xt) + 0.5f), 0.0f, PEAK)));
#else
                        cint[pc.cint_base + r * WIDTH + xt] = cubic_float(dy, xt);
#endif
                    }
                }
                store_dst_val(r, xt, oval);
            }
            // No shared state is touched here, so the tile barrier can be
            // skipped: every lane passed the previous iteration's end barrier.
            continue;
        }

        if (lane == 0) {
            // Walk only down to xmin: columns left of it are all masked
            // (their directions are discarded for cubic), and their pbt was
            // never written (the DP loop starts at xmin).
            //
            // The walk reads pbt DIRECTLY from global memory: it consumes one
            // byte per column (index CENTER + f), so staging the full TPITCH
            // bytes of every column into LDS first would pull ~41x more data
            // through the DP's store->load dependency for nothing. The tile
            // loop still bounds the serial chain and lets the whole workgroup
            // interpolate each tile in parallel. Measured at vc0/mdis=20
            // (2000f, ns=8): 326 -> 368 fps versus the LDS staging form.
            int f = fcarry;
            const int xlo = max(x0, xmin);
            for (int x = x0 + n - 1; x >= xlo; --x) {
                f += pbt_delta(pbt_src, x, CENTER + f);
                tileF[x - x0] = int8_t(f);
            }
            fcarry = f;
#if PROBE == 7 || PROBE == 8 || PROBE == 10
            // Diagnostics: one extra identical walk over the PREVIOUS row's
            // pbt row (written by another workgroup, so no same-workgroup
            // store->load hazard), result discarded. Same chain latency and
            // same load count as the real walk; pure extra cost. PROBE 7 keeps
            // the f-dependent address (serial chain intact); PROBE 8 makes the
            // address f-independent (loads can issue ahead / MLP), so 7 vs 8
            // isolates the cost of the dependent-address chain itself.
            {
                const int pbt_old = (r >= 1) ? (pbt_row - WIDTH * PB_STRIDE) : pbt_row;
                int f2 = 0;
#if PROBE == 7
                for (int x = x0 + n - 1; x >= xlo; --x)
                    f2 += pbt_delta(pbt_old, x, CENTER + f2);
#elif PROBE == 8
                for (int x = x0 + n - 1; x >= xlo; --x)
                    f2 += pbt_delta(pbt_old, x, CENTER);
#else
                // PROBE 10: f-independent address AND explicitly unrolled by 4, so
                // four independent loads issue back-to-back (memory-level
                // parallelism). 8 vs 10 answers "is the walk latency-bound?".
                int x = x0 + n - 1;
                for (; x >= xlo + 3; x -= 4) {
                    const int a = pbt_delta(pbt_old, x, CENTER);
                    const int b = pbt_delta(pbt_old, x - 1, CENTER);
                    const int c = pbt_delta(pbt_old, x - 2, CENTER);
                    const int d = pbt_delta(pbt_old, x - 3, CENTER);
                    f2 += a + b + c + d;
                }
                for (; x >= xlo; --x)
                    f2 += pbt_delta(pbt_old, x, CENTER);
#endif
                // Consume f2 without touching the output. The old form wrote 0
                // to the empty-row flag when `f2 == pc.pbt_base` -- a value no
                // walk can produce, so it only fired by accident, and when it
                // did it cleared the flag the vcheck reads and silently changed
                // the ablation. The probe's cost is its load chain, not the
                // flag store, so a read-only sink keeps the chain live and is
                // byte-identical to the real kernel.
                if (f2 == dmap[pc.rempty_base + r]) {
                    rowXmin = f2;
                }
            }
#endif
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        if (lane < n) {
            const int x = x0 + lane;
            // Columns left of xmin (only in the leftmost processed tile) are
            // masked: vertical cubic, direction 0, no tileF read.
            if (x < xmin) {
                const float oval = cubic_float(dy, x);
                if (VCHECK_MODE > 0) {
                    dmap[pc.dmap_base + r * WIDTH + x] = int8_t(0);
                    if (HAS_SCLIP == 0) {
#if BITS == 16
                        cint[pc.cint_base + r * WIDTH + x] =
                            IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                        cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
                    }
                }
                store_dst_val(r, x, oval);
            } else {
            const int dir = int(tileF[lane]);
            const bool masked_x = (HAS_MCLIP != 0 && !bmask_local(x));
            float oval;
            int dval = dir;
            if (masked_x) {
                // masked pixels interpolate the vertical cubic, direction 0
                dval = 0;
                oval = cubic_float(dy, x);
            } else {
                // ucubic always on: 4-tap cubic along the direction when the
                // 3*|dir| taps stay in the frame, else the 2-tap average.
                const int ad3 = abs(3 * dir);
                if (x >= ad3 && x <= WIDTH - 1 - ad3) {
                    oval = 0.5625f * (pad_get(dy - 1, x + dir) + pad_get(dy + 1, x - dir))
                         - 0.0625f * (pad_get(dy - 3, x + 3 * dir) + pad_get(dy + 3, x - 3 * dir));
                } else {
                    oval = (pad_get(dy - 1, x + dir) + pad_get(dy + 1, x - dir)) * 0.5f;
                }
            }
            if (VCHECK_MODE > 0) {
                dmap[pc.dmap_base + r * WIDTH + x] = int8_t(dval);
                if (HAS_SCLIP == 0) {
#if BITS == 16
                    cint[pc.cint_base + r * WIDTH + x] =
                        IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                    cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
                }
            }
            store_dst_val(r, x, oval);
            } // (x >= xmin) dir/backtrack path
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();   // tileF reads done before the next (leftward) tile overwrites it
    }
}

#endif  // ENTRY_ROW

#if defined(ENTRY_VCHECK)

// vcheck walks the interp rows top-down in the serial form (row r reads the
// MODIFIED row r-1 as its d2p term) and writes each vchecked row to vout (b7).
// All taps except d2p come from dst (b1), which the row kernel wrote and vcheck
// never modifies, so:
//   - row r / r+1 taps (dCi/dCp/dm/dNm): dst, always the plain row-kernel
//     output — no in-place race;
//   - d2p (row r-1): vout row r-1, written last iteration, L2-hot.
// One barrier per row orders vout row r before iteration r+1 reads it.
// No shared-memory staging (matches vszipcl's vcheck; the LDS ping-pong was
// measurably slower). Non-vcheckable rows (kept rows / edges) pass the plain
// dst value through to vout unchanged.
//
// VCHECK_LDS selects where the d2p term reads the MODIFIED previous interp row
// from: 1 = a shared-memory ping-pong holding the last two rows (the
// reference eedi3vk2's structure, quantized through the pixel format exactly
// like the frame read-back did), 0 = back from vout in global memory. The LDS
// form removes one global (staging, when vout is not device-local) read per
// dirc != 0 pixel; it needs a compile-time max width and the host only picks
// it when width <= MAXW and the device's shared-memory limit fits 2*MAXW
// floats, otherwise the global form runs unchanged.
layout(local_size_x_id = 7) in;

// Quantized vcheck output as an integer-valued float (u16 rounds half-up and
// clamps; f32 passes through). 16-bit types cannot be a function return type
// here, so every store converts at the assignment instead.
float vc_quant(float v) {
#if BITS == 16
    return clamp(floor(v + 0.5f), 0.0f, PEAK);
#else
    return v;
#endif
}

// Store one quantized value into the global vout row.
void vout_store(int r, int x, float q) {
#if BITS == 16
    vout[pc.vout_base + r * WIDTH + x] = IO_TYPE(uint(q));
#else
    vout[pc.vout_base + r * WIDTH + x] = q;
#endif
}

#if VCHECK_LDS
shared float tlineSh[2][MAXW];
int g_cur, g_prev;
void vc_store(int x, float q) { tlineSh[g_cur][x] = q; }
#else
int g_row;
void vc_store(int x, float q) { vout_store(g_row, x, q); }
// The stored (so already quantized) vout value of interp row r, column x: what
// a serial walk reads back as its d2p term.
float vc_read_vout(int r, int x) {
#if BITS == 16
    return float(int(vout[pc.vout_base + r * WIDTH + x]));
#else
    return vout[pc.vout_base + r * WIDTH + x];
#endif
}
#endif

// The dirc == 0 result: the vertical cubic, or the caller's sclip.
float vc_cint_s(int r, int x) {
#if BITS == 16
    return HAS_SCLIP != 0
        ? load_sclip_val(r, x)
        : float(int(cint[pc.cint_base + r * WIDTH + x]));
#else
    return HAS_SCLIP != 0
        ? load_sclip_val(r, x)
        : cint[pc.cint_base + r * WIDTH + x];
#endif
}

// One pixel's blend. The caller has already established do_row, dirc != 0 and
// the direction test; `pr` is the d2p term.
float vc_blend(int r, int x, float pr) {
    const int yf = pc.field + 2 * r;
    const int dirc = int(dmap[pc.dmap_base + r * WIDTH + x]);
    const int dn = (r + 1 < pc.rows) ? (r + 1) : r;
    const float cint_s = vc_cint_s(r, x);
#if BITS == 16
    const int dCi = int(load_dst_val(r, x));
    const int dCp = int(load_dst_val(r, x + dirc));
    const int dm  = int(load_dst_val(r, x - dirc));
    const int dNm = int(load_dst_val(dn, x - dirc));
    const int v1px = int(pad_get(yf - 1, x + dirc));
    const int v1nx = int(pad_get(yf + 1, x - dirc));
    const int v1p0 = int(pad_get(yf - 1, x));
    const int v1n0 = int(pad_get(yf + 1, x));
    const int p = int(pr);
    const int it = (p + dm + 1) >> 1;
    const int ib = (dCp + dNm + 1) >> 1;
    const int vt = abs(p - v1px) + abs(dCp - v1px);
    const int vb = abs(dNm - v1nx) + abs(dm - v1nx);
    const int vc = abs(dCi - v1p0) + abs(dCi - v1n0);
    const int d0 = abs(it - v1p0);
    const int d1 = abs(ib - v1n0);
    const int d2 = abs(vt - vc);
    const int d3 = abs(vb - vc);
    int mdiff0, mdiff1;
    if (VCHECK_MODE == 1) {
        mdiff0 = min(d0, d1);
        mdiff1 = min(d2, d3);
    } else if (VCHECK_MODE == 2) {
        mdiff0 = (d0 + d1 + 1) >> 1;
        mdiff1 = (d2 + d3 + 1) >> 1;
    } else {
        mdiff0 = max(d0, d1);
        mdiff1 = max(d2, d3);
    }
    const float a0 = float(mdiff0) * pc.vth0r;
    const float a1 = float(mdiff1) * pc.vth1r;
    const float a2 = max((pc.vth2 - float(abs(dirc))) * pc.vth2r, 0.0f);
    const float a = min(max(a0, max(a1, a2)), 1.0f);
    const float blend = (1.0f - a) * float(dCi) + a * cint_s;
    return float(min(max(int(blend), 0), 65535));
#else
    const float dCi = load_dst_val(r, x);
    const float dCp = load_dst_val(r, x + dirc);
    const float dm  = load_dst_val(r, x - dirc);
    const float dNm = load_dst_val(dn, x - dirc);
    const float v1px = pad_get(yf - 1, x + dirc);
    const float v1nx = pad_get(yf + 1, x - dirc);
    const float v1p0 = pad_get(yf - 1, x);
    const float v1n0 = pad_get(yf + 1, x);
    const float it = (pr + dm) * 0.5f;
    const float ib = (dCp + dNm) * 0.5f;
    const float vt = abs(pr - v1px) + abs(dCp - v1px);
    const float vb = abs(dNm - v1nx) + abs(dm - v1nx);
    const float vc = abs(dCi - v1p0) + abs(dCi - v1n0);
    const float d0 = abs(it - v1p0);
    const float d1 = abs(ib - v1n0);
    const float d2 = abs(vt - vc);
    const float d3 = abs(vb - vc);
    float mdiff0, mdiff1;
    if (VCHECK_MODE == 1) {
        mdiff0 = min(d0, d1);
        mdiff1 = min(d2, d3);
    } else if (VCHECK_MODE == 2) {
        mdiff0 = (d0 + d1) * 0.5f;
        mdiff1 = (d2 + d3) * 0.5f;
    } else {
        mdiff0 = max(d0, d1);
        mdiff1 = max(d2, d3);
    }
    const float a0 = mdiff0 * pc.vth0r;
    const float a1 = mdiff1 * pc.vth1r;
    const float a2 = max((pc.vth2 - float(abs(dirc))) * pc.vth2r, 0.0f);
    const float a = min(max(a0, max(a1, a2)), 1.0f);
    return (1.0f - a) * dCi + a * cint_s;
#endif
}

// One pixel: the early-out decisions live here, the blend math in vc_blend.
// PR_EXPR is the d2p term and is evaluated only where it is actually used.
#define DEF_VC_EVAL(NAME, PR_EXPR)                                        \
float NAME(int r, int x) {                                                \
    const int y = MARGIN_V + pc.field + 2 * r;                            \
    if (!(y >= 6 && y < pc.pad_height - 6)) {                             \
        return load_dst_val(r, x);                                        \
    }                                                                     \
    const int dirc = int(dmap[pc.dmap_base + r * WIDTH + x]);             \
    if (dirc == 0) {                                                      \
        return vc_cint_s(r, x);                                           \
    }                                                                     \
    const int dr = (r >= 1) ? (r - 1) : 0;                                \
    const int dn = (r + 1 < pc.rows) ? (r + 1) : r;                       \
    const int dirt = int(dmap[pc.dmap_base + dr * WIDTH + x]);            \
    const int dirb = int(dmap[pc.dmap_base + dn * WIDTH + x]);            \
    if (max(dirc * dirt, dirc * dirb) < 0 || (dirt == dirb && dirt == 0)) { \
        return vc_cint_s(r, x);                                           \
    }                                                                     \
    const float pr = (r >= 1) ? (PR_EXPR) : 0.0f;                         \
    return vc_blend(r, x, pr);                                            \
}

#if VCHECK_PARA
// The stored form of a parallel evaluation: exactly what a serial walk would
// have read back from vout one pass earlier.
float vc_para_quant(float v) {
#if BITS == 16
    return float(uint(vc_quant(v)));
#else
    return v;
#endif
}
// Each extra step feeds the predecessor row's own (one-step-less) parallel
// value as the d2p term. Pixels whose predecessor's blend was already fully
// determined (a == 1 -> cint_s) then see exactly the serial value, which is
// where most of the drift lives, so a few steps decay it geometrically.
#define DEF_VC_EVAL_J(NAME, PREV) \
    DEF_VC_EVAL(NAME, vc_para_quant(PREV(r - 1, x + dirc)))
DEF_VC_EVAL(vc_eval_0, load_dst_val(r - 1, x + dirc))
#if VCHECK_PARA >= 2
DEF_VC_EVAL_J(vc_eval_1, vc_eval_0)
#endif
#if VCHECK_PARA >= 3
DEF_VC_EVAL_J(vc_eval_2, vc_eval_1)
#endif
#if VCHECK_PARA >= 4
DEF_VC_EVAL_J(vc_eval_3, vc_eval_2)
#endif
#if VCHECK_PARA >= 5
DEF_VC_EVAL_J(vc_eval_4, vc_eval_3)
#endif
#if VCHECK_PARA >= 6
DEF_VC_EVAL_J(vc_eval_5, vc_eval_4)
#endif
#if VCHECK_PARA >= 6
#define VC_PARA_EVAL vc_eval_5
#elif VCHECK_PARA >= 5
#define VC_PARA_EVAL vc_eval_4
#elif VCHECK_PARA >= 4
#define VC_PARA_EVAL vc_eval_3
#elif VCHECK_PARA >= 3
#define VC_PARA_EVAL vc_eval_2
#elif VCHECK_PARA >= 2
#define VC_PARA_EVAL vc_eval_1
#else
#define VC_PARA_EVAL vc_eval_0
#endif
float vc_eval(int r, int x) { return VC_PARA_EVAL(r, x); }
#else
#if VCHECK_LDS
#define VC_PR_EXPR tlineSh[g_prev][x + dirc]
#else
#define VC_PR_EXPR vc_read_vout(r - 1, x + dirc)
#endif
DEF_VC_EVAL(vc_eval, VC_PR_EXPR)
#endif

// One interp row. The serial form calls this once per row from a top-down walk;
// VCHECK_PARA calls it once per workgroup, so nothing here may assume ordering.
void vc_row(int r) {
    const int tid = int(gl_LocalInvocationID.x);
    const int lsz = int(gl_WorkGroupSize.x);
    for (int x = tid; x < WIDTH; x += lsz) {
        vc_store(x, vc_quant(vc_eval(r, x)));
    }
}

#if VCHECK_PARA
// One workgroup per interp row; the rows are independent (the d2p term never
// reads a vcheck write).
void main() {
    const int r = int(gl_WorkGroupID.y);
    if (r >= pc.rows) return;
    g_row = r;
    vc_row(r);
}
#else
void main() {
    const int tid = int(gl_LocalInvocationID.x);
    const int lsz = int(gl_WorkGroupSize.x);

    for (int r = 0; r < pc.rows; ++r) {
#if VCHECK_LDS
        // Every row must advance the LDS chain, so there is no empty-row skip
        // on this path (and the host does not dispatch ENTRY_VCOPY): an empty
        // row's pixels all have dirc == 0 and take the cint_s branch below,
        // which is exactly what vcopy wrote for them.
        g_cur = r & 1;
        g_prev = 1 - g_cur;
#else
        // Empty (fully-masked, dmap-0) rows were already copied by ENTRY_VCOPY
        // and need no ordering: skip them AND their barrier (this is the whole
        // win — ~2/3 of the 1080 serial barriers disappear). Uniform branch:
        // every lane reads the same flag byte.
        if (dmap[pc.rempty_base + r] != int8_t(0))
            continue;
        g_row = r;
#endif
        vc_row(r);
#if VCHECK_LDS
        // The previous row is final now: flush it to vout. The barrier below
        // orders this flush (and the row it came from) before the next
        // iteration reuses that ping-pong buffer.
        if (r >= 1) {
            for (int x = tid; x < WIDTH; x += lsz) {
                vout_store(r - 1, x, tlineSh[g_prev][x]);
            }
        }
#endif
        groupMemoryBarrier();
        barrier();
    }
#if VCHECK_LDS
    if (pc.rows >= 1) {
        const int r = pc.rows - 1;
        for (int x = tid; x < WIDTH; x += lsz) {
            vout_store(r, x, tlineSh[r & 1][x]);
        }
    }
#endif
}
#endif  // VCHECK_PARA

#endif  // ENTRY_VCHECK

#if defined(ENTRY_VCOPY)

// Parallel copy for fully-masked (dmap-0) rows: vout = cint (or sclip) on
// vcheckable rows, dst passthrough otherwise — exactly what the serial walk
// computes for dirc == 0 rows (empty rows always have dmap 0). The walk then
// iterates only non-empty rows, dropping ~2/3 of its serial barriers.
layout(local_size_x = 256) in;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const int total = pc.rows * WIDTH;
    if (int(i) >= total) return;
    const int r = int(i) / WIDTH;
    const int x = int(i) % WIDTH;
    if (dmap[pc.rempty_base + r] == int8_t(0)) return;
    const int y = MARGIN_V + pc.field + 2 * r;
    const bool do_row = (y >= 6 && y < pc.pad_height - 6);
    float oval;
    if (!do_row) {
        oval = load_dst_val(r, x);
    } else {
#if BITS == 16
        oval = HAS_SCLIP != 0
            ? load_sclip_val(r, x)
            : float(int(cint[pc.cint_base + r * WIDTH + x]));
#else
        oval = HAS_SCLIP != 0
            ? load_sclip_val(r, x)
            : cint[pc.cint_base + r * WIDTH + x];
#endif
    }
#if BITS == 16
    vout[pc.vout_base + r * WIDTH + x] = IO_TYPE(uint(clamp(floor(oval + 0.5f), 0.0f, PEAK)));
#else
    vout[pc.vout_base + r * WIDTH + x] = oval;
#endif
}

#endif  // ENTRY_VCOPY

#if defined(ENTRY_PAD)

// Mirror-pad builder: expands the kept rows into the full padded plane
// (stride pad_stride, pad_height rows) with eedi3m's exact mirror rules.
//
// The source (binding 0) is either the input frame plane read in frame order
// with `src_stride` -- kept rows are `src_first + src_step*kk`, i.e. field+2k
// vertically or k under dh -- or, horizontally, the packed R' the xpose pass
// produced (one row of WIDTH per kept index). pad_src_pitched picks, and the
// mirror logic below never changes.
//
// Vertical mapping replicates copyPad in pad space: interior kept rows sit at
// MARGIN_V + off + 2k (off = 1-field); top margins reflect around pad row
// MARGIN_V (qy = 2*MARGIN_V - qy) and bottom margins replay the loop's
// qy -= 2 + 2*off + 4k step. Rows at the other parity (and stride-padding
// lanes past pad_w) are never read downstream; their indices are clamped so
// every access stays in bounds and deterministic.
// Horizontal mapping replicates the row mirrors: sx = -ix on the left,
// sx = ix - 2*(px - (pad_w - MARGIN_H) + 1) on the right, clamped.
layout(local_size_x = 256) in;

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    const int total = pc.pad_stride * pc.pad_height;
    if (int(idx) >= total) return;
    const int py = int(idx) / pc.pad_stride;
    const int px = int(idx) % pc.pad_stride;
    const int off = 1 - pc.field;
    const int pad_w = WIDTH + 2 * MARGIN_H;

    // pad_get is only ever called at pad rows MARGIN_V + dst_row with
    // dst_row = field + 2r +/- {1,3}, so every row that is READ has parity
    // (MARGIN_V + field + 1) & 1 == (field + 1) & 1. Rows of the other parity
    // are written and never read: skip them (halves the pad kernel's stores and
    // mirror math). The buffer keeps stale values there, which nothing reads.
    if ((py & 1) == (pc.field & 1)) return;

    int qy = py;
    if (qy < MARGIN_V) {
        qy = 2 * MARGIN_V - qy;
    } else if (qy >= MARGIN_V + 2 * pc.rows) {
        const int y0 = pc.pad_height - MARGIN_V + off;
        const int k = (qy - y0) / 2;
        qy = qy - (2 + 2 * off + 4 * k);
    }
    int kk = (qy - MARGIN_V - off) / 2;
    kk = clamp(kk, 0, pc.rows - 1);

    const int ix = px - MARGIN_H;
    int sx;
    if (ix < 0) sx = -ix;
    else if (ix >= WIDTH) sx = ix - 2 * (px - (pad_w - MARGIN_H) + 1);
    else sx = ix;
    sx = clamp(sx, 0, WIDTH - 1);

    if (pc.pad_src_pitched != 0) {
        const int sy = pc.src_first + pc.src_step * kk;
        padOut[pc.pad_base + py * pc.pad_stride + px] =
            pdsrc[pc.raw_base + sy * pc.src_stride + sx];
    } else {
        padOut[pc.pad_base + py * pc.pad_stride + px] =
            pdsrc[pc.raw_base + kk * WIDTH + sx];
    }
}

#endif  // ENTRY_PAD

#if defined(ENTRY_MASKPACK)

// Horizontal mask preparation: the row kernel needs the mask dilated along the
// TRANSPOSED row (i.e. along the source column), so build the transposed
// predicate bit matrix here in one tiled pass. Each 32x32 workgroup reads the
// mask rows coalesced (lane = column) into shared, and each thread emits one
// transposed word (bit ty = source row y0+ty). Only the columns of the interp
// parity `src_first + src_step*k` map to output rows; the other columns'
// threads do not store.
//
// The predicate must match the reference Gray8 conversion exactly: a u16 mask
// is nonzero-after-conversion iff v >= 129, a full-range float iff v > 0.5/255
// (strict; >= is off by one ULP), a byte iff != 0.
layout(local_size_x = 32) in;

shared uint tile[32];

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int x0 = int(gl_WorkGroupID.x) * 32;
    const int y0 = int(gl_WorkGroupID.y) * 32;
    const int mask_w = pc.rows * pc.src_step;   // == the mask plane's width
    const int x = x0 + tx;

    if (tx == 0) {
        for (int i = 0; i < 32; ++i) tile[i] = 0u;
    }
    barrier();

    // Coalesced load: the 32 lanes cover 32 consecutive columns of one row.
    for (int ty = 0; ty < 32; ++ty) {
        const int y = y0 + ty;
        uint bit = 0u;
        if (x < mask_w && y < WIDTH) {
            const int i = y * pc.src_stride + x;
#if MASK_BITS == 8
            bit = (msk8[i] != 0) ? 1u : 0u;
#elif MASK_BITS == 16
            bit = (int(msk16[i]) >= 129) ? 1u : 0u;
#else
            bit = (msk32[i] > (0.5f / 255.0f)) ? 1u : 0u;
#endif
        }
        if (bit != 0u) atomicOr(tile[ty], 1u << tx);
    }
    barrier();

    // Transpose: thread tx extracts bit tx from every row and packs the 32
    // bits into the output word for the row that column x maps to.
    if (x < mask_w && x >= pc.src_first &&
        ((x - pc.src_first) % pc.src_step) == 0) {
        const int k = (x - pc.src_first) / pc.src_step;
        if (k < pc.rows) {
            uint v = 0u;
            for (int ty = 0; ty < 32; ++ty) {
                v |= ((tile[ty] >> tx) & 1u) << ty;
            }
            predout[pc.raw_base + k * ((WIDTH + 31) / 32) + (y0 >> 5)] = v;
        }
    }
}

#endif  // ENTRY_MASKPACK

#if defined(ENTRY_MASKDILATE)

// Per-interp-row copyMask dilation: out[x] = OR over |t| <= MDIS of
// predicate(src[x+t]). With MASK_TRANS == 0 the source is the raw mask plane
// (row src_first + src_step*r, pitch src_stride, element type per MASK_BITS);
// with MASK_TRANS == 1 it is the packed transposed predicate matrix that
// ENTRY_MASKPACK produced (row r of (WIDTH+31)/32 u32 words).
//
// One workgroup per row, one output u32 word per thread. The five source words
// around the output word hold the whole MDIS window (+-40 columns = +-2 words),
// and the doubling composition (radius 1,2,4,8,16,rest; every shift is <= 16
// so 32-bit words are enough) runs entirely in registers, so the row costs one
// barrier.
layout(local_size_x = 64) in;

// Source predicate bits for word i of row r (32 columns starting at 32*i).
uint row_word(int r, int i) {
    if (i < 0 || i >= (WIDTH + 31) / 32) return 0u;
#if MASK_TRANS == 1
    return dilsrc_bits[pc.raw_base + r * ((WIDTH + 31) / 32) + i];
#else
    uint w = 0u;
    const int base = (pc.src_first + pc.src_step * r) * pc.src_stride + i * 32;
    for (int b = 0; b < 32; ++b) {
        const int x = i * 32 + b;
        if (x >= WIDTH) break;
#if MASK_BITS == 8
        if (dilsrc8[base + b] != 0) w |= (1u << b);
#elif MASK_BITS == 16
        if (int(dilsrc16[base + b]) >= 129) w |= (1u << b);
#else
        if (dilsrc32[base + b] > (0.5f / 255.0f)) w |= (1u << b);
#endif
    }
    return w;
#endif
}

void main() {
    const int r = int(gl_WorkGroupID.x);
    const int tid = int(gl_LocalInvocationID.x);
    const int lsz = int(gl_WorkGroupSize.x);
    const int nwords = (WIDTH + 31) / 32;
    const int base = pc.bmask_base + r * nwords;

    for (int i = tid; i < nwords; i += lsz) {
        // L[0..4] cover words i-2..i+2; the output word is L[2].
        uint p[5], s[5];
        for (int j = 0; j < 5; ++j) {
            p[j] = row_word(r, i - 2 + j);
            s[j] = p[j];
        }
        int radius = 0;
        for (int step = 1; radius < MDIS; step <<= 1) {
            const int sh = min(step, MDIS - radius);
            uint np[5], ns[5];
            for (int j = 0; j < 5; ++j) {
                np[j] = p[j] | (p[j] << sh) | ((j > 0) ? (p[j - 1] >> (32 - sh)) : 0u);
                ns[j] = s[j] | (s[j] >> sh) | ((j < 4) ? (s[j + 1] << (32 - sh)) : 0u);
            }
            for (int j = 0; j < 5; ++j) {
                p[j] = np[j];
                s[j] = ns[j];
            }
            radius += sh;
        }
        uint res = p[2] | s[2];
        // The predicate never sets bits past WIDTH, but the dilation shifts
        // bits up into them and the row kernel's span scan reads every stored
        // word, so clear them on the last word of the row.
        if (i == nwords - 1 && (WIDTH & 31) != 0) {
            res &= (1u << (WIDTH & 31)) - 1u;
        }
        dilout[base + i] = res;
    }
}

#endif  // ENTRY_MASKDILATE

#if defined(ENTRY_BLIT)

// Output-plane writer: every row of the output frame plane (binding 2, pitch
// `dst_stride`) is either an interpolated row (binding 0 = the interp rows,
// vout when vcheck > 0 else dst) or a kept source row (binding 1 = the input
// frame plane at `src_stride`). Writing the kept rows here instead of copying
// the source plane keeps the whole output in one dispatch.
layout(local_size_x = 256) in;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const int total = 2 * pc.rows * WIDTH;
    if (int(i) >= total) return;
    const int y = int(i) / WIDTH;
    const int x = int(i) % WIDTH;
    const int off = 1 - pc.field;
    if (((y - pc.field) & 1) == 0) {
        const int r = (y - pc.field) >> 1;
        // A GLSL `if` on a specialization constant folds at pipeline creation;
        // `#if` would evaluate the identifier as 0 instead.
        if (VCHECK_MODE > 0) {
            blit_out[y * pc.dst_stride + x] = blit_in[pc.vout_base + r * WIDTH + x];
        } else {
            blit_out[y * pc.dst_stride + x] = blit_in[pc.dst_base + r * WIDTH + x];
        }
    } else {
        // Kept output row y holds source row y (dh=0, where the kept parity is
        // 1:1) or source row (y-off)/2 (dh=1, kept and interp rows interleave).
        const int sy = (pc.src_step == 1) ? ((y - off) >> 1) : y;
        blit_out[y * pc.dst_stride + x] = blit_src[pc.raw_base + sy * pc.src_stride + x];
    }
}

#endif  // ENTRY_BLIT

#if defined(ENTRY_XPOSE)

// Horizontal kept-row transpose: the source plane is read in frame order
// (binding 0, pitch `src_stride`) and written as the pad builder's packed
// layout R' (binding 1, `rows` rows of WIDTH elements): R'[k][y] =
// src[y][src_first + src_step*k]. Plain 16x16 tiled transpose with an LDS stage so
// both the global load and the global store are coalesced; the interior of
// the pad kernel's own layout is unchanged, so nothing downstream changes.
layout(local_size_x = 16, local_size_y = 16) in;

shared SHARED_T xposeTile[16][17];

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);
    const int bx = int(gl_WorkGroupID.x) * 16;   // K column (kept index)
    const int by = int(gl_WorkGroupID.y) * 16;   // K row (source row index)

    // load: this thread reads K(k = bx+tx, y = by+ty)
    {
        const int k = bx + tx;
        const int y = by + ty;
        SHARED_T v = SHARED_T(0);
        if (k < pc.rows && y < WIDTH) {
            v = SHARED_T(xsrc[pc.raw_base + y * pc.src_stride +
                              pc.src_first + pc.src_step * k]);
        }
        xposeTile[ty][tx] = v;
    }
    barrier();
    // store: this thread writes R'(k = bx+ty, y = by+tx)
    {
        const int k = bx + ty;
        const int y = by + tx;
        if (k < pc.rows && y < WIDTH) {
            xdst[pc.pad_base + k * WIDTH + y] = IO_TYPE(xposeTile[tx][ty]);
        }
    }
}

#endif  // ENTRY_XPOSE

#if defined(ENTRY_COMPOSE)

// EEDI3H output assembly: the output plane O (WIDTH rows of 2*rows columns)
// transposed back into frame order from R' (kept, binding 9) and vout
// (interpolated, binding 7):  O[y][2k+p] = (p == field) ? vout[k][y] : R'[k][y].
// Both sources are read with y (the fast axis of the output) varying across
// the lanes, and the output is written with x varying, so a plain transpose
// via LDS: load into shV/shR indexed by [k][y], store from [k][y] with the
// thread roles swapped between the phases. The assembled plane goes out
// through binding 10 (the staging download), so the sources are untouched.
layout(local_size_x = 16, local_size_y = 16) in;

shared SHARED_T compV[16][17];
shared SHARED_T compR[16][17];

// std.Merge's default 50/50: u16 is (a+b+1)>>1 (== _mm256_avg_epu16), f32 is
// 0.5f*a + 0.5f*b in the same association order the CPU merge used.
SHARED_T merge_avg(const SHARED_T a, const SHARED_T b) {
#if BITS == 16
    return (a + b + 1u) >> 1;
#else
    return 0.5f * a + 0.5f * b;
#endif
}

void main() {
    const int tx = int(gl_LocalInvocationID.x);
    const int ty = int(gl_LocalInvocationID.y);
    const int bx = int(gl_WorkGroupID.x) * 16;   // interp index k
    const int by = int(gl_WorkGroupID.y) * 16;   // frame row y

    // load: this thread reads vout/R'(k = bx+ty, y = by+tx)
    {
        const int k = bx + ty;
        const int y = by + tx;
        SHARED_T vv = SHARED_T(0), vr = SHARED_T(0);
        if (k < pc.rows && y < WIDTH) {
            vv = (VCHECK_MODE > 0)
                ? SHARED_T(cout[pc.vout_base + k * WIDTH + y])
                : SHARED_T(cdst[pc.dst_base + k * WIDTH + y]);
            vr = SHARED_T(crt[pc.pad_base + k * WIDTH + y]);
        }
        compV[ty][tx] = vv;
        compR[ty][tx] = vr;
    }
    barrier();
    // store: this thread writes O[y][2k + p] for (k = bx+tx, y = by+ty)
    {
        const int k = bx + tx;
        const int y = by + ty;
        if (k < pc.rows && y < WIDTH) {
            // Frame-order output offset (pitch `dst_stride`) and the packed
            // o0 offset (2*rows elements per row).
            const int o = y * pc.dst_stride + 2 * k;
            const int o0 = y * (2 * pc.rows) + 2 * k;
            if (pc.comp_fuse == 1) {
                // First AA horizontal sub-pass: park the assembled plane in the
                // device-local binding so the second sub-pass can merge against
                // it without a round trip.
                cdst[pc.out_base + o0 + pc.field] = IO_TYPE(compV[tx][ty]);
                cdst[pc.out_base + o0 + (1 - pc.field)] = IO_TYPE(compR[tx][ty]);
            } else if (pc.comp_fuse == 2) {
                // Second AA horizontal sub-pass: O_1 is assembled here and
                // averaged 50/50 with O_0 (in cdst) exactly like std.Merge's
                // u16 (a+b+1)>>1 / f32 0.5a+0.5b, then written straight into
                // the output frame.
                cout2[o + pc.field] = IO_TYPE(merge_avg(
                    SHARED_T(cdst[pc.out_base + o0 + pc.field]), compV[tx][ty]));
                cout2[o + (1 - pc.field)] = IO_TYPE(merge_avg(
                    SHARED_T(cdst[pc.out_base + o0 + (1 - pc.field)]), compR[tx][ty]));
            } else {
                cout2[o + pc.field] = IO_TYPE(compV[tx][ty]);
                cout2[o + (1 - pc.field)] = IO_TYPE(compR[tx][ty]);
            }
        }
    }
}

#endif  // ENTRY_COMPOSE

#if defined(ENTRY_ASSEMBLEV)

// EEDI3AA vertical merge: one dispatch per plane, one thread per output
// element. `pc.field` is the FIRST sub-pass's interp parity; a row whose parity
// matches it takes that sub-pass's vout rows and vice versa. The source row is
// read from the input frame plane directly (binding 0, pitch `src_stride`).
// `pc.rows` is the vertical pass's interp-row count, so the output plane has
// 2*pc.rows rows (dh is not supported on this path).
layout(local_size_x = 256) in;

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    const int total = 2 * pc.rows * WIDTH;
    if (int(idx) >= total) return;
    const int y = int(idx) / WIDTH;
    const int x = int(idx) % WIDTH;
    const int p = y & 1;
    const int r = y >> 1;
    // vout comes from the sub-pass whose interp parity IS p; the source value
    // is just row y of the input frame.
    const int vout_base = (p == pc.field) ? pc.vout_base : pc.vout2_base;
    const int i = pc.raw_base + y * pc.src_stride + x;
    const int j = vout_base + r * WIDTH + x;
#if BITS == 16
    asm_out[pc.out_base + int(idx)] =
        IO_TYPE((int(asm_src[i]) + int(asm_vout[j]) + 1) >> 1);
#else
    asm_out[pc.out_base + int(idx)] = 0.5f * asm_src[i] + 0.5f * asm_vout[j];
#endif
}

#endif  // ENTRY_ASSEMBLEV
