#version 450
/*
 * EEDI3 — full-pel edge-directed line interpolation (Vulkan port).
 *
 * Semantic target: family A (eedi3m, the original HolyWu implementation;
 * eedi3vk2 is the same family and the closest GPU cross-check). This is a
 * from-scratch implementation that reproduces eedi3m's per-column math:
 *
 *   - connection costs s0/s1/s2 over a (2*nrad+1)-tap window with the
 *     corrected validity gates (all loads stay inside the 12-column mirrored
 *     pad margin; eedi3m's scalar s2 gate is looser and reads out of bounds)
 *   - per-column direction clamp umax = min(x, W-1-x, mdis)
 *   - DP predecessor window umax2 = min(x-1, W-x, mdis), relax over
 *     v in [max(-umax2,u-1), min(umax2,u+1)], ascending-v strict-< tie break
 *   - pbt stores RELATIVE predecessor deltas (int8, idx - u; backtracking
 *     accumulates)
 *   - masked columns (mclip) carry the previous column's path costs and
 *     backtrack rows with the two extreme fixups (eedi3m semantics)
 *   - interpolate: 4-tap cubic along the direction when the guard holds, else
 *     2-tap average; masked columns -> vertical cubic, direction 0
 *   - vcheck (single workgroup per plane, serialized row walk): the modified
 *     previous interp row is carried in a shared ping-pong buffer quantized to
 *     the io type, exactly like eedi3vk2's vcheck kernel.
 *
 * The host uploads eedi3m's exact padded plane (copyPad) as FLOAT for both
 * bit depths: u16 values are exact integers < 2^24, so float arithmetic on
 * them reproduces the integer cost/interp math bit-exactly (u16 io is only
 * (re)quantized at stores and for vcheck's pixel reads, where eedi3m does
 * the same). f32 io passes through the pad unchanged.
 *
 * ENTRY_ROW runs the DP in per-lane REGISTERS with subgroup shuffles (see the
 * comment at the kernel): one 32-lane workgroup per interpolated row, each
 * lane owns K = ceil(TPITCH/32) directions, no workgroup barriers in the
 * column loop. Masked columns (mclip) are near-free register copies. The host
 * must request requiredSubgroupSize = 32 on this pipeline.
 *
 * Buffers (one subrange per plane per binding; the base element offsets of
 * each plane region are push constants because each binding's descriptor
 * range spans the whole buffer):
 *   b0 pad    float, padded plane (padStride x padHeight), MARGIN offsets
 *   b1 dst    io type, rows x WIDTH (tight) interpolated rows
 *   b2 pbt    int8, rows x WIDTH x TPITCH RELATIVE predecessor delta per
 *             (col,u) (idx - u; backtracking accumulates)
 *   b3 dmap   int8, rows x WIDTH direction per pixel (only VCHECK > 0)
 *   b4 bmask  uint8, rows x WIDTH dilated mclip mask (optional)
 *   b5 sclip  io type, rows x WIDTH (only VCHECK > 0 && HAS_SCLIP)
 *   b6 cint   io type, rows x WIDTH vertical cubic per pixel (only when
 *             VCHECK > 0 && !HAS_SCLIP)
 *
 * ENTRY_ROW grid (1, rows): one workgroup per interpolated row.
 * ENTRY_VCHECK grid (1, 1): one workgroup per plane; serial row walk.
 *
 * Spec constants: 0 WIDTH, 1 NRAD, 2 MDIS, 3 HAS_MCLIP, 4 HAS_SCLIP,
 * 5 VCHECK_MODE, 6 local_size_row, 7 local_size_vcheck.
 */

#if !defined(BITS)
#define BITS 16
#endif

#if BITS == 16
#define IO_TYPE uint16_t
#define PEAK 65535.0f
#else
#define IO_TYPE float
#define PEAK 1.0f
#endif

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#if defined(ENTRY_ROW)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model
#endif

const float FLT_MAX_09 = 3.0616170017461927e+38f;  // FLT_MAX * 0.9
const float FLT_MAX_V = 3.402823466e+38f;          // FLT_MAX

layout(constant_id = 0) const int WIDTH = 640;
layout(constant_id = 1) const int NRAD = 2;
layout(constant_id = 2) const int MDIS = 20;
layout(constant_id = 3) const int HAS_MCLIP = 0;
layout(constant_id = 4) const int HAS_SCLIP = 0;
layout(constant_id = 5) const int VCHECK_MODE = 2;

const int TPITCH = 2 * MDIS + 1;
const int CENTER = MDIS;
const int MARGIN_H = 12;
const int MARGIN_V = 4;

// backtrack + interpolate tile width (columns)
const int BT_TILE = 32;

layout(std430, binding = 0) readonly buffer PadBuf { float pad[]; };
layout(std430, binding = 1) buffer DstBuf { IO_TYPE dst[]; };
layout(std430, binding = 2) buffer PbtBuf { int8_t pbt[]; };
layout(std430, binding = 3) buffer DmapBuf { int8_t dmap[]; };
layout(std430, binding = 4) readonly buffer BmaskBuf { uint8_t bmask[]; };
layout(std430, binding = 5) readonly buffer SclipBuf { IO_TYPE sclip[]; };
layout(std430, binding = 6) buffer CintBuf { IO_TYPE cint[]; };
layout(std430, binding = 7) buffer VoutBuf { IO_TYPE vout[]; };

layout(push_constant) uniform PC {
    // per-plane element bases into each binding's descriptor range
    int pad_base;     // float elements into b0 (padded plane)
    int dst_base;     // io elements into b1 (interp rows)
    int pbt_base;     // int8 elements into b2
    int dmap_base;    // int8 elements into b3
    int bmask_base;   // uint8 elements into b4
    int sclip_base;   // io elements into b5
    int cint_base;    // io elements into b6
    int vout_base;    // io elements into b7 (vcheck output rows)
    int pad_stride;   // padded plane row pitch in float elements
    int pad_height;   // padded plane height in rows
    int field;        // parity of the interpolated dst rows (0/1)
    int rows;         // number of interpolated rows
    float alpha;      // raw alpha / 3 (cost3 always on)
    float beta;
    float gamma;
    float rw;         // 1 - raw alpha - raw beta
    float vth0r;
    float vth1r;
    float vth2r;
    float vth2;
} pc;

// Padded-plane access at OUTPUT dst-row coordinates. copyPad places every
// kept source row at pad row MARGIN_V + <output dst row> (dh=0: 1:1; dh=1:
// kept output dst rows of parity 1-field come from source rows in order), so
// interp rows (parity `field`) read their +/-1, +/-3 taps (kept rows) at
// pad row MARGIN_V + dy +/- {1,3} — always in bounds thanks to the mirrored
// vertical margins the host builds (same for the horizontal margins).
float pad_get(int dst_row, int col) {
    return pad[pc.pad_base + (MARGIN_V + dst_row) * pc.pad_stride + MARGIN_H + col];
}

float load_dst_val(int r, int x) {
#if BITS == 16
    return float(int(dst[pc.dst_base + r * WIDTH + x]));
#else
    return dst[pc.dst_base + r * WIDTH + x];
#endif
}

float load_sclip_val(int r, int x) {
#if BITS == 16
    return float(int(sclip[pc.sclip_base + r * WIDTH + x]));
#else
    return sclip[pc.sclip_base + r * WIDTH + x];
#endif
}

// io store: u16 rounds half-up + clamps to [0, peak], which reproduces
// eedi3m's integer (X + 8) >> 4 / (a + b + 1) >> 1 arithmetic evaluated on
// exact float taps (see design notes); f32 stores pass through unchanged.
void store_dst_val(int r, int x, float v) {
#if BITS == 16
    dst[pc.dst_base + r * WIDTH + x] = IO_TYPE(uint(clamp(floor(v + 0.5f), 0.0f, PEAK)));
#else
    dst[pc.dst_base + r * WIDTH + x] = v;
#endif
}

bool bmask_at(int r, int x) {
    if (HAS_MCLIP == 0) return true;
    return bmask[pc.bmask_base + r * WIDTH + x] != uint8_t(0);
}

// Vertical 4-tap cubic at column x of interp dst row dy (kept rows dy +/- 1
// and dy +/- 3). Integer formats reproduce the clamp/round of the int cubic
// through store_dst_val / the cint quantizer; float uses exact weights.
float cubic_float(int dy, int x) {
    return 0.5625f * (pad_get(dy - 1, x) + pad_get(dy + 1, x))
         - 0.0625f * (pad_get(dy - 3, x) + pad_get(dy + 3, x));
}

// Connection cost for interp dst row dy, column x, direction u.
// u16: s0/s1/s2/v are integer SAD sums accumulated in float (exact, terms
// stay below 2^24). Cost combine matches eedi3m's float order.
float conn_cost(int dy, int x, int u) {
    const int u2 = 2 * u;
    float s0 = 0.0f;
    float s1 = 0.0f;
    float s2 = 0.0f;
    const bool s1_ok = (u >= 0 && x >= u2) || (u <= 0 && x < WIDTH + u2);
    const bool s2_ok = (u <= 0 && x >= -u2) || (u >= 0 && x < WIDTH - u2);

    for (int k = -NRAD; k <= NRAD; ++k) {
        s0 += abs(pad_get(dy - 3, x + u + k) - pad_get(dy - 1, x - u + k))
            + abs(pad_get(dy - 1, x + u + k) - pad_get(dy + 1, x - u + k))
            + abs(pad_get(dy + 1, x + u + k) - pad_get(dy + 3, x - u + k));
        if (s1_ok) {
            s1 += abs(pad_get(dy - 3, x + k) - pad_get(dy - 1, x - u2 + k))
                + abs(pad_get(dy - 1, x + k) - pad_get(dy + 1, x - u2 + k))
                + abs(pad_get(dy + 1, x + k) - pad_get(dy + 3, x - u2 + k));
        }
        if (s2_ok) {
            s2 += abs(pad_get(dy - 3, x + u2 + k) - pad_get(dy - 1, x + k))
                + abs(pad_get(dy - 1, x + u2 + k) - pad_get(dy + 1, x + k))
                + abs(pad_get(dy + 1, x + u2 + k) - pad_get(dy + 3, x + k));
        }
    }
    const float S1 = s1_ok ? s1 : (s2_ok ? s2 : s0);
    const float S2 = s2_ok ? s2 : S1;

    // cost3 is always on (GPU family semantics: eedi3vk2/vszip* have no
    // cost3 switch and always divide alpha by 3 and sum s0+s1+s2).
    // ip is the inner 2-tap average. eedi3m computes it in INTEGER domain
    // ((a + b + 1) >> 1 == round-half-up on the exact mean) for integer
    // formats, which feeds an integer |x - ip| difference — for odd sums the
    // plain float midpoint (a+b)/2 differs by 0.5, shifting the v penalty by
    // up to 1 and flipping near-tie argmins (seen at nrad=3). Reproduce the
    // integer v exactly. Float formats use the exact midpoint.
#if BITS == 16
    const float t1 = pad_get(dy - 1, x + u);
    const float t2 = pad_get(dy + 1, x - u);
    const float ip = floor((t1 + t2 + 1.0f) * 0.5f);
    const float c1 = pad_get(dy - 1, x);
    const float c2 = pad_get(dy + 1, x);
    const float v = abs(c1 - ip) + abs(c2 - ip);
#else
    const float ip = (pad_get(dy - 1, x + u) + pad_get(dy + 1, x - u)) * 0.5f;
    const float v = abs(pad_get(dy - 1, x) - ip) + abs(pad_get(dy + 1, x) - ip);
#endif

    return pc.alpha * (s0 + S1 + S2) + pc.beta * float(abs(u)) + pc.rw * v;
}

// ---------------------------------------------------------------------------
// Rolling connection costs (the hot path).
//
// Each of s0/s1/s2 is a (2*NRAD+1)-term window sum over k of a per-(x,u)
// leading term. Sliding x by +1 shifts every window by one term, so advancing
// a window costs ONE new leading-term eval (9 pad loads) instead of the full
// (2*NRAD+1)-term recompute (~90 loads). Measured: full conn_cost per
// (column, direction) is ~70% of row-kernel time (zeroing it took vcheck=0
// full-DP 2160p from 116 -> 278 fps). For u16 the pad values are exact
// integers < 2^24 so window sums are exact regardless of accumulation order;
// f32 may differ from the reference in rounding order by ~ulp (acceptable).
//
// The three windows of cost3 (cost3 is always on):
//   s0(x,u) = sum_k A(x+u+k, x-u+k)
//   s1(x,u) = sum_k A(x+k,   x-2u+k)
//   s2(x,u) = sum_k A(x+2u+k, x+k)
// with A(i,j) = |p3(i)-p1(j)| + |p1(i)-n1(j)| + |n1(i)-n3(j)| over the four
// kept rows around the interpolated dst row (p3 = dy-3 ... n3 = dy+3).
const int RING_CAP = 7;   // >= 2*NRAD+1 for NRAD <= 3 (fixed bound -> registers)
#define RN (2 * NRAD + 1)

float rowA(int dy, int i, int j) {
    return abs(pad_get(dy - 3, i) - pad_get(dy - 1, j))
         + abs(pad_get(dy - 1, i) - pad_get(dy + 1, j))
         + abs(pad_get(dy + 1, i) - pad_get(dy + 3, j));
}

// Seed the three windows at column x (fresh full evaluation, k ascending).
void roll_seed(int dy, int x, int u, out float s0, out float s1, out float s2,
               inout float r0[RING_CAP], inout float r1[RING_CAP],
               inout float r2[RING_CAP]) {
    s0 = 0.0f; s1 = 0.0f; s2 = 0.0f;
    for (int k = 0; k < RING_CAP; ++k) {
        if (k >= RN) break;
        const float t0 = rowA(dy, x + u + k - NRAD, x - u + k - NRAD);
        const float t1 = rowA(dy, x + k - NRAD, x - 2 * u + k - NRAD);
        const float t2 = rowA(dy, x + 2 * u + k - NRAD, x + k - NRAD);
        r0[k] = t0; r1[k] = t1; r2[k] = t2;
        s0 += t0; s1 += t1; s2 += t2;
    }
}

// Advance the seeded windows from column x to column x+1.
void roll_push(int dy, int x, int u, inout float s0, inout float s1, inout float s2,
               inout float r0[RING_CAP], inout float r1[RING_CAP],
               inout float r2[RING_CAP]) {
    const float l0 = rowA(dy, x + u + NRAD + 1, x - u + NRAD + 1);
    const float l1 = rowA(dy, x + NRAD + 1, x - 2 * u + NRAD + 1);
    const float l2 = rowA(dy, x + 2 * u + NRAD + 1, x + NRAD + 1);
    s0 += l0 - r0[0];
    s1 += l1 - r1[0];
    s2 += l2 - r2[0];
    for (int k = 0; k < RING_CAP - 1; ++k) {
        if (k >= RN - 1) break;
        r0[k] = r0[k + 1]; r1[k] = r1[k + 1]; r2[k] = r2[k + 1];
    }
    r0[RN - 1] = l0; r1[RN - 1] = l1; r2[RN - 1] = l2;
}

// Combined cost (cost3 semantics, mirroring conn_cost's tail) from window
// sums that are all valid (interior columns: every gate holds).
float combine_interior(int dy, int x, int u, float s0, float s1, float s2) {
    const float S1 = s1;
    const float S2 = s2;
#if BITS == 16
    const float t1 = pad_get(dy - 1, x + u);
    const float t2 = pad_get(dy + 1, x - u);
    const float ip = floor((t1 + t2 + 1.0f) * 0.5f);
    const float c1 = pad_get(dy - 1, x);
    const float c2 = pad_get(dy + 1, x);
    const float v = abs(c1 - ip) + abs(c2 - ip);
#else
    const float ip = (pad_get(dy - 1, x + u) + pad_get(dy + 1, x - u)) * 0.5f;
    const float v = abs(pad_get(dy - 1, x) - ip) + abs(pad_get(dy + 1, x) - ip);
#endif
    return pc.alpha * (s0 + S1 + S2) + pc.beta * float(abs(u)) + pc.rw * v;
}
#if defined(ENTRY_ROW)

// Per-interp-row DP in REGISTERS with subgroup shuffles (eedi3vk2 structure):
// one workgroup of SGSIZE lanes per interpolated row, each lane owns
// K = ceil(TPITCH / SGSIZE) consecutive directions in private registers, so
// the per-column relax reads its +-1 predecessor window from the other lanes'
// registers via subgroupShuffleUp/Down — zero workgroup barriers in the column
// loop. Masked columns (mclip) are near-free: cur = pp register copy + pumax
// fixups + one pbt byte per lane. Backtrack/interpolate happens tile-by-tile
// (BT_TILE columns per tile) from a shared copy of the relative-delta pbt
// rows, exactly like eedi3vk2.
//
// pbt stores RELATIVE predecessor deltas (idx - u, int8), so backtracking
// accumulates: fpath[x] = fpath[x+1] + pbt[x][CENTER + fpath[x+1]].
//
// Connection costs keep the rolling window sums per direction (s0/s1/s2 +
// RING_CAP term rings per owned direction). Rolling is only valid across
// consecutive unmasked interior columns; a masked column or a column outside
// the direction's interior band invalidates the state (next interior column
// reseeds with the full window). This matches the barrier version's cost math
// bit-for-bit (same roll_seed/roll_push/combine_interior), so u16 stays
// bit-exact vs eedi3vk2 and f32 keeps its ~1 ulp measured band.
//
// The workgroup is a single 32-lane subgroup; each workgroup processes one
// interpolated row. The host requests requiredSubgroupSize = 32 for this
// pipeline (RDNA3's native 64-lane wavefront is split via the subgroup size
// control feature). NOTE (round 6): a 2-subgroup x 2-row-per-WG variant was
// tried and measured SLOWER on the mclip workload (see notes) — keep 1 row/WG.
const int SGSIZE = 32;                       // == workgroup size (host sets it)
const int K = (TPITCH + SGSIZE - 1) / SGSIZE;  // directions per lane

shared int8_t tileSh[BT_TILE * TPITCH];
shared int8_t tileF[BT_TILE];
shared uint bmaskSh[(WIDTH + 31) / 32];

layout(local_size_x_id = 6) in;

// Shared packed-bit test of the current row's mask (bmaskSh filled by the
// pack loop in main). HAS_MCLIP == 0 pipelines return true (nothing masked).
bool bmask_local(int x) {
    if (HAS_MCLIP == 0) return true;
    return (bmaskSh[x >> 5] & (1u << (x & 31))) != 0u;
}

void main() {
    const int lane = int(gl_SubgroupInvocationID);
    const int r = int(gl_WorkGroupID.y);
    const int dy = pc.field + 2 * r;
    const int pbt_row = pc.pbt_base + r * (WIDTH * TPITCH);
    const int laneBase = lane * K;

    if (HAS_MCLIP != 0) {
        // Pack this row's dilated mask into shared bits (one uint per 32
        // columns), so the per-column masked test is a shared read instead of
        // a serial dependent global load (eedi3vk2 does the same).
        for (int i = lane; i < (WIDTH + 31) / 32; i += SGSIZE) {
            uint bits = 0u;
            for (int j = 0; j < 32; j++) {
                const int x = i * 32 + j;
                if (x < WIDTH && bmask[pc.bmask_base + r * WIDTH + x] != uint8_t(0))
                    bits |= 1u << j;
            }
            bmaskSh[i] = bits;
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }

    // Per-direction DP state (registers). u = laneBase + j - CENTER.
    float pp[K];   // previous column's path costs
    int pRel[K];   // previous column's relative backtrack delta (mclip copy)
    float s0[K], s1[K], s2[K];          // rolling window sums
    float r0[K][RING_CAP], r1[K][RING_CAP], r2[K][RING_CAP];  // term rings
    bool rolled[K];                     // rolling state valid (unmasked interior run)

    for (int j = 0; j < K; j++) {
        pp[j] = 0.0f;
        pRel[j] = 0;
        s0[j] = 0.0f; s1[j] = 0.0f; s2[j] = 0.0f;
        rolled[j] = false;
    }

    // Column 0: only u == 0 carries its connection cost. A masked column 0 is
    // pinned to 0 (eedi3m would read uninitialized memory; eedi3vk2 pins 0).
    for (int j = 0; j < K; j++) {
        if (laneBase + j == CENTER && (HAS_MCLIP == 0 || bmask_local(0))) {
            pp[j] = conn_cost(dy, 0, 0);
        }
    }

    for (int xd = 1; xd < WIDTH; xd++) {
        const int umax = min(min(xd, WIDTH - 1 - xd), MDIS);
        const bool masked = (HAS_MCLIP != 0 && !bmask_local(xd));

        float cur[K];
        int cRel[K];

        if (masked) {
            // Masked column: cost row + backtrack row carry from the previous
            // column (eedi3m semantics); the two extreme entries get fixups so
            // the path stays inside the narrower reachable set. Rolling state
            // is invalid (windows could not advance over this column).
            if (xd == 1) {
                // ccosts at column 1 were never computed (pinned 0); backtrack
                // pointers zeroed (absolute v = 0 -> rel = -u).
                for (int j = 0; j < K; j++) {
                    cur[j] = 0.0f;
                    cRel[j] = -(laneBase + j - CENTER);
                    rolled[j] = false;
                }
            } else {
                const int pumax = min(xd - 1, WIDTH - xd);
                for (int j = 0; j < K; j++) {
                    const int i = laneBase + j;
                    cur[j] = pp[j];
                    cRel[j] = pRel[j];
                    rolled[j] = false;
                    if (pumax < MDIS) {
                        if (i == CENTER - pumax)
                            cRel[j] = (1 - pumax) - (i - CENTER);
                        else if (i == CENTER + pumax)
                            cRel[j] = (pumax - 1) - (i - CENTER);
                    }
                }
            }
            for (int j = 0; j < K; j++) {
                if (laneBase + j < TPITCH)
                    pbt[pbt_row + (xd - 1) * TPITCH + laneBase + j] = int8_t(cRel[j]);
            }
        } else {
            // Unmasked column: gather the previous column's path costs
            // [laneBase - 1, laneBase + K] from the subgroup's registers (the
            // +-1 neighbour window of the relax), then per-direction cost + DP.
            float ext[K + 2];
            for (int e = 0; e < K + 2; e++) {
                const int idx = e - 1;   // relative to laneBase
                if (idx < 0) {
                    const int q = (-idx + K - 1) / K;
                    ext[e] = subgroupShuffleUp(pp[idx + q * K], q);
                } else if (idx >= K) {
                    const int q = (idx - K) / K + 1;
                    ext[e] = subgroupShuffleDown(pp[idx - q * K], q);
                } else {
                    ext[e] = pp[idx];
                }
            }

            const int umax2 = min(min(xd - 1, WIDTH - xd), MDIS);

            for (int j = 0; j < K; j++) {
                const int i = laneBase + j;
                const int u = i - CENTER;
                const int au = abs(u);
                const bool laneActive = (i < TPITCH && au <= umax);

                cur[j] = pp[j];
                cRel[j] = pRel[j];

                if (laneActive) {
                    float ccost;
                    if (HAS_MCLIP == 0) {
                        // No mclip: every column is unmasked, so the rolling
                        // windows stay warm across the whole interior band and
                        // each column advances them by one term. (With mclip
                        // the rolling state would die at every masked column
                        // and be reseeded at every unmasked run — eedi3vk2
                        // recomputes the full cost there instead, which lets
                        // the ring registers go and keeps masked columns at
                        // tiny footprint.)
                        const bool interior = (xd >= 2 * au && xd <= WIDTH - 1 - 2 * au);
                        if (interior) {
                            if (!rolled[j]) {
                                roll_seed(dy, xd, u, s0[j], s1[j], s2[j],
                                          r0[j], r1[j], r2[j]);
                                rolled[j] = true;
                            } else {
                                roll_push(dy, xd - 1, u, s0[j], s1[j], s2[j],
                                          r0[j], r1[j], r2[j]);
                            }
                            ccost = combine_interior(dy, xd, u, s0[j], s1[j], s2[j]);
                        } else {
                            rolled[j] = false;
                            ccost = conn_cost(dy, xd, u);
                        }
                    } else {
                        ccost = conn_cost(dy, xd, u);
                    }

                    // DP relax over v in [u-1, u+1] (subset of |v| <= umax2 by
                    // construction), ascending v, strict < keeps the lowest v
                    // on ties. ext[e] = pp of direction laneBase + e - 1.
                    float bval = FLT_MAX_V;
                    int idx = 0;
                    for (int dd = -1; dd <= 1; dd++) {
                        const int v = u + dd;
                        if (abs(v) <= umax2) {
                            const float z = ext[j + 1 + dd] + pc.gamma * float(abs(dd));
                            const float cc = min(z, FLT_MAX_09);
                            if (cc < bval) {
                                bval = cc;
                                idx = v;
                            }
                        }
                    }
                    const float pcost = min(bval + ccost, FLT_MAX_09);
                    cur[j] = pcost;
                    cRel[j] = idx - u;
                    pbt[pbt_row + (xd - 1) * TPITCH + i] = int8_t(cRel[j]);
                }
            }
        }

        for (int j = 0; j < K; j++) {
            pp[j] = cur[j];
            pRel[j] = cRel[j];
        }
    }

    // Make the pbt writes visible to this subgroup's backtrack reads.
    subgroupMemoryBarrier();
    subgroupBarrier();

    // The rightmost column always takes direction 0 (fpath[WIDTH-1] == 0);
    // direction 0 interpolates to the vertical cubic (ucubic always on).
    if (lane == 0) {
        const int x = WIDTH - 1;
        const float oval = cubic_float(dy, x);
        if (VCHECK_MODE > 0) {
            dmap[pc.dmap_base + r * WIDTH + x] = int8_t(0);
            if (HAS_SCLIP == 0) {
#if BITS == 16
                cint[pc.cint_base + r * WIDTH + x] =
                    IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
            }
        }
        store_dst_val(r, x, oval);
    }
    subgroupBarrier();

    // Backtrack from the right in tiles (relative deltas accumulate); lane 0
    // walks each tile backwards from fcarry.
    int fcarry = 0;  // fpath[x0 + n]; starts at fpath[WIDTH - 1] == 0
    for (int x0 = ((WIDTH - 2) / BT_TILE) * BT_TILE; x0 >= 0; x0 -= BT_TILE) {
        const int n = min(BT_TILE, WIDTH - 1 - x0);

        for (int c = 0; c < n; ++c)
            for (int i = lane; i < TPITCH; i += SGSIZE)
                tileSh[c * TPITCH + i] = pbt[pbt_row + (x0 + c) * TPITCH + i];
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        if (lane == 0) {
            int f = fcarry;
            for (int x = x0 + n - 1; x >= x0; --x) {
                f += int(tileSh[(x - x0) * TPITCH + CENTER + f]);
                tileF[x - x0] = int8_t(f);
            }
            fcarry = f;
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        if (lane < n) {
            const int x = x0 + lane;
            const int dir = int(tileF[lane]);
            const bool masked_x = (HAS_MCLIP != 0 && !bmask_local(x));
            float oval;
            int dval = dir;
            if (masked_x) {
                // masked pixels interpolate the vertical cubic, direction 0
                dval = 0;
                oval = cubic_float(dy, x);
            } else {
                // ucubic always on: 4-tap cubic along the direction when the
                // 3*|dir| taps stay in the frame, else the 2-tap average.
                const int ad3 = abs(3 * dir);
                if (x >= ad3 && x <= WIDTH - 1 - ad3) {
                    oval = 0.5625f * (pad_get(dy - 1, x + dir) + pad_get(dy + 1, x - dir))
                         - 0.0625f * (pad_get(dy - 3, x + 3 * dir) + pad_get(dy + 3, x - 3 * dir));
                } else {
                    oval = (pad_get(dy - 1, x + dir) + pad_get(dy + 1, x - dir)) * 0.5f;
                }
            }
            if (VCHECK_MODE > 0) {
                dmap[pc.dmap_base + r * WIDTH + x] = int8_t(dval);
                if (HAS_SCLIP == 0) {
#if BITS == 16
                    cint[pc.cint_base + r * WIDTH + x] =
                        IO_TYPE(uint(clamp(floor(cubic_float(dy, x) + 0.5f), 0.0f, PEAK)));
#else
                    cint[pc.cint_base + r * WIDTH + x] = cubic_float(dy, x);
#endif
                }
            }
            store_dst_val(r, x, oval);
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();   // tile reads done before the next (leftward) tile reuses tileSh
    }
}

#endif  // ENTRY_ROW

#if defined(ENTRY_VCHECK)

// vcheck is a serial row walk (row r reads the MODIFIED row r-1 as its d2p
// term). A single workgroup iterates rows top-down and writes each vchecked
// row to the vout buffer (b7). All taps except d2p come from dst (b1), which
// the row kernel wrote and vcheck never modifies, so:
//   - row r / r+1 taps (dCi/dCp/dm/dNm): dst, always the plain row-kernel
//     output — no in-place race;
//   - d2p (row r-1): vout row r-1, written last iteration, L2-hot.
// One barrier per row orders vout row r before iteration r+1 reads it.
// No shared-memory staging (matches vszipcl's vcheck; the LDS ping-pong was
// measurably slower). Non-vcheckable rows (kept rows / edges) pass the plain
// dst value through to vout unchanged.
layout(local_size_x_id = 7) in;

void main() {
    const int tid = int(gl_LocalInvocationID.x);
    const int lsz = int(gl_WorkGroupSize.x);

    for (int r = 0; r < pc.rows; ++r) {
        const int y = MARGIN_V + pc.field + 2 * r;   // pad row of this interp row
        const bool do_row = (y >= 6 && y < pc.pad_height - 6);
        const int yf = pc.field + 2 * r;
        const int dr = (r >= 1) ? (r - 1) : 0;        // interp row for dmap dirt
        const int dn = (r + 1 < pc.rows) ? (r + 1) : r;   // next interp row
        const int pr_row = (r >= 1) ? (r - 1) : 0;    // vout row for d2p

        for (int x = tid; x < WIDTH; x += lsz) {
            float oval;
            if (!do_row) {
                oval = load_dst_val(r, x);
            } else {
                const int dirc = int(dmap[pc.dmap_base + r * WIDTH + x]);
#if BITS == 16
                const float cint_s = HAS_SCLIP != 0
                    ? load_sclip_val(r, x)
                    : float(int(cint[pc.cint_base + r * WIDTH + x]));
#else
                const float cint_s = HAS_SCLIP != 0
                    ? load_sclip_val(r, x)
                    : cint[pc.cint_base + r * WIDTH + x];
#endif

                oval = cint_s;
                if (dirc != 0) {
                    const int dirt = int(dmap[pc.dmap_base + dr * WIDTH + x]);
                    const int dirb = int(dmap[pc.dmap_base + dn * WIDTH + x]);
                    if (!(max(dirc * dirt, dirc * dirb) < 0 || (dirt == dirb && dirt == 0))) {
#if BITS == 16
                        const int dCi = int(load_dst_val(r, x));
                        const int dCp = int(load_dst_val(r, x + dirc));
                        const int dm  = int(load_dst_val(r, x - dirc));
                        const int dNm = int(load_dst_val(dn, x - dirc));
                        const int v1px = int(pad_get(yf - 1, x + dirc));
                        const int v1nx = int(pad_get(yf + 1, x - dirc));
                        const int v1p0 = int(pad_get(yf - 1, x));
                        const int v1n0 = int(pad_get(yf + 1, x));
                        const int pr = (r >= 1)
                            ? int(vout[pc.vout_base + pr_row * WIDTH + x + dirc]) : 0;
                        const int it = (pr + dm + 1) >> 1;
                        const int ib = (dCp + dNm + 1) >> 1;
                        const int vt = abs(pr - v1px) + abs(dCp - v1px);
                        const int vb = abs(dNm - v1nx) + abs(dm - v1nx);
                        const int vc = abs(dCi - v1p0) + abs(dCi - v1n0);
                        const int d0 = abs(it - v1p0);
                        const int d1 = abs(ib - v1n0);
                        const int d2 = abs(vt - vc);
                        const int d3 = abs(vb - vc);
                        int mdiff0, mdiff1;
                        if (VCHECK_MODE == 1) {
                            mdiff0 = min(d0, d1);
                            mdiff1 = min(d2, d3);
                        } else if (VCHECK_MODE == 2) {
                            mdiff0 = (d0 + d1 + 1) >> 1;
                            mdiff1 = (d2 + d3 + 1) >> 1;
                        } else {
                            mdiff0 = max(d0, d1);
                            mdiff1 = max(d2, d3);
                        }
                        const float a0 = float(mdiff0) * pc.vth0r;
                        const float a1 = float(mdiff1) * pc.vth1r;
                        const float a2 = max((pc.vth2 - float(abs(dirc))) * pc.vth2r, 0.0f);
                        const float a = min(max(a0, max(a1, a2)), 1.0f);
                        const float blend = (1.0f - a) * float(dCi) + a * cint_s;
                        oval = float(min(max(int(blend), 0), 65535));
#else
                        const float pr = (r >= 1)
                            ? vout[pc.vout_base + pr_row * WIDTH + x + dirc] : 0.0f;
                        const float dCi = load_dst_val(r, x);
                        const float dCp = load_dst_val(r, x + dirc);
                        const float dm  = load_dst_val(r, x - dirc);
                        const float dNm = load_dst_val(dn, x - dirc);
                        const float v1px = pad_get(yf - 1, x + dirc);
                        const float v1nx = pad_get(yf + 1, x - dirc);
                        const float v1p0 = pad_get(yf - 1, x);
                        const float v1n0 = pad_get(yf + 1, x);
                        const float it = (pr + dm) * 0.5f;
                        const float ib = (dCp + dNm) * 0.5f;
                        const float vt = abs(pr - v1px) + abs(dCp - v1px);
                        const float vb = abs(dNm - v1nx) + abs(dm - v1nx);
                        const float vc = abs(dCi - v1p0) + abs(dCi - v1n0);
                        const float d0 = abs(it - v1p0);
                        const float d1 = abs(ib - v1n0);
                        const float d2 = abs(vt - vc);
                        const float d3 = abs(vb - vc);
                        float mdiff0, mdiff1;
                        if (VCHECK_MODE == 1) {
                            mdiff0 = min(d0, d1);
                            mdiff1 = min(d2, d3);
                        } else if (VCHECK_MODE == 2) {
                            mdiff0 = (d0 + d1) * 0.5f;
                            mdiff1 = (d2 + d3) * 0.5f;
                        } else {
                            mdiff0 = max(d0, d1);
                            mdiff1 = max(d2, d3);
                        }
                        const float a0 = mdiff0 * pc.vth0r;
                        const float a1 = mdiff1 * pc.vth1r;
                        const float a2 = max((pc.vth2 - float(abs(dirc))) * pc.vth2r, 0.0f);
                        const float a = min(max(a0, max(a1, a2)), 1.0f);
                        oval = (1.0f - a) * dCi + a * cint_s;
#endif
                    }
                }
            }
#if BITS == 16
            vout[pc.vout_base + r * WIDTH + x] = IO_TYPE(uint(clamp(floor(oval + 0.5f), 0.0f, PEAK)));
#else
            vout[pc.vout_base + r * WIDTH + x] = oval;
#endif
        }
        groupMemoryBarrier();
        barrier();
    }
}

#endif  // ENTRY_VCHECK
