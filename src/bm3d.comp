void transform_pack8(inout float data[64]) {
    // transform 8 groups of 8 consecutive elements, groups stepped by 8
    for (int it = 0; it < 8; ++it) {
        float v[8];
        for (int i = 0; i < 8; ++i) v[i] = data[it * 8 + i];
        dct_fwd(v);
        for (int i = 0; i < 8; ++i) data[it * 8 + i] = v[i];
    }
}

void transform_pack8_inv(inout float data[64]) {
    for (int it = 0; it < 8; ++it) {
        float v[8];
        for (int i = 0; i < 8; ++i) v[i] = data[it * 8 + i];
        dct_inv(v);
        for (int i = 0; i < 8; ++i) data[it * 8 + i] = v[i];
    }
}

void transform_pack8_1d(inout float data[64]) {
    // stride 8 groups: the 8 members at a fixed position
    for (int it = 0; it < 8; ++it) {
        float v[8];
        for (int i = 0; i < 8; ++i) v[i] = data[it + i * 8];
        dct_fwd(v);
        for (int i = 0; i < 8; ++i) data[it + i * 8] = v[i];
    }
}

void transform_pack8_1d_inv(inout float data[64]) {
    for (int it = 0; it < 8; ++it) {
        float v[8];
        for (int i = 0; i < 8; ++i) v[i] = data[it + i * 8];
        dct_inv(v);
        for (int i = 0; i < 8; ++i) data[it + i * 8] = v[i];
    }
}

// Length-N scaled DCT-II pair (n in [1, 8); n == 8 uses the fast path).
// A_N^T A_N = 2N I, so the group-axis round trip gain is 2N.
