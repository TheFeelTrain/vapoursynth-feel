        o3 = 0.0f;
        o4 = 0.0f;
        o5 = 0.0f;
        o6 = 0.0f;
        o7 = 0.0f;
        break;
    case 4:
        o0 = fma(1.41421354f, v[3], fma(1.41421354f, v[2], fma(1.41421354f, v[1], 1.41421354f * v[0])));
        o1 = fma(-1.84775901f, v[3], fma(-0.765366852f, v[2], fma(0.765366852f, v[1], 1.84775901f * v[0])));
        o2 = fma(1.41421354f, v[3], fma(-1.41421354f, v[2], fma(-1.41421354f, v[1], 1.41421354f * v[0])));
        o3 = fma(-0.765366852f, v[3], fma(1.84775901f, v[2], fma(-1.84775901f, v[1], 0.765366852f * v[0])));
