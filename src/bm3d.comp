    float o0, o1, o2, o3, o4, o5, o6, o7;
    switch (n) {
    case 1:
        o0 = 1.41421354f * v[0];
        o1 = 0.0f;
        o2 = 0.0f;
        o3 = 0.0f;
        o4 = 0.0f;
        o5 = 0.0f;
        o6 = 0.0f;
        o7 = 0.0f;
        break;
