        o3 = fma(-1.56366301f, v[6], fma(0.867767453f, v[5], fma(1.9498558f, v[4], fma(-1.9498558f, v[2], fma(-0.867767453f, v[1], 1.56366301f * v[0])))));
        o4 = fma(1.24697959f, v[6], fma(-1.8019377f, v[5], fma(-0.445041865f, v[4], fma(2.0f, v[3], fma(-0.445041865f, v[2], fma(-1.8019377f, v[1], 1.24697959f * v[0]))))));
