#version 450
// Buffer float atomics are an extension no pre-RDNA3 AMD driver reports: RADV
// gates shaderBufferFloat32AtomicAdd at GFX11 and the Windows driver has no
// hardware fadd to expose on Polaris/Vega/RDNA1-2 either. -DNO_FLOAT_ATOMICS
// builds the accumulation on atomicCompSwap instead (the reference's own
// atom_add_f), and drops the `require` so the module carries no
// AtomicFloat32AddEXT capability.
#ifndef NO_FLOAT_ATOMICS
#extension GL_EXT_shader_atomic_float : require
#endif
#extension GL_KHR_shader_subgroup_shuffle : enable

/*
 * BM3D collaborative-filtering kernel. One workgroup = one warp of 32 lanes;
 * 4 groups of 8 lanes each process one 8x8 reference block. The per-lane layout
 * is [member(8) x row(8)] with the block column provided by the lane id, so the
 * 2D transform uses shared memory transposes between the 8 lanes of a group.
 *
 * Block matching follows mawen's CPU matcher (reference/VapourSynth-BM3D):
 * the reference block is reserved at group index 0, the current frame is
 * searched over its clipped bm_range rectangle, and every neighbouring frame is
 * searched over the *union* of the clipped predictive windows around the
 * surviving seeds -- each origin exactly once, which is what the CPU's
 * GenSearchPos/std::unique produces. A frame keeps its best eight qualifying
 * candidates (the prediction seeds are only its first ps_num), the two temporal
 * directions each restart from the current frame's seeds, and the group keeps
 * concatenation order until it overflows past eight, at which point the seven
 * best of the tail are kept. The group can be shorter than eight, so the
 * collaborative transform along the group axis has length N = group size.
 *
 * Compile-time variants: the kernel is specialized through specialization
 * constants (WIDTH..TRACE) so the pipeline can be built once per configuration.
 */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const int WIDTH = 1920;
layout(constant_id = 1) const int HEIGHT = 1080;
layout(constant_id = 2) const int STRIDE = 1920;
layout(constant_id = 3) const float SIGMA_Y = 0.0;
layout(constant_id = 4) const int BLOCK_STEP = 4;
layout(constant_id = 5) const int BM_RANGE = 16;
layout(constant_id = 6) const int RADIUS = 2;
layout(constant_id = 7) const int PS_NUM = 2;
layout(constant_id = 8) const int PS_RANGE = 7;
layout(constant_id = 9) const float EXTRACTOR = 0.0;
layout(constant_id = 10) const int NOSEARCH = 0;
layout(constant_id = 11) const int NOESTIMATE = 0;
layout(constant_id = 12) const int SRC_RING = 9;  // 4 * RADIUS + 1 (window union)
layout(constant_id = 13) const int FINAL = 0;    // Wiener (ref) pass vs hard thresholding
// Per-plane sigmas and the plane count of one entry. The reference's default
// mode builds one entry per plane (NPLANES = 1, every group plane is its own
// first plane); chroma mode builds one entry over all three, where the group
// comes from luma and each plane is filtered with its own sigma. In that joint
// mode a plane whose sigma is below FLT_EPSILON is skipped, exactly as the
// reference's `if (sigma < FLT_EPS_) continue`, and the host copies it through.
layout(constant_id = 14) const float SIGMA_U = 0.0;
layout(constant_id = 15) const float SIGMA_V = 0.0;
layout(constant_id = 16) const int NPLANES = 1;
// Matching threshold in SSD units (the host converts the user's 8-bit MSE
// threshold with 64/255^2). Acceptance is inclusive, as the CPU's
// `dist <= thSSE` is; zero means the reference-only group.
layout(constant_id = 17) const float TH_SSE = 1.0;
// Match trace (debug): writes the selected group of one (workgroup, group) pair
// into the buffer bound as the unused destination binding. Folded away when 0,
// so the production kernel carries no trace code at all.
layout(constant_id = 18) const int TRACE = 0;

const int KRADIUS = RADIUS;
const int TEMPORAL_STRIDE = HEIGHT * STRIDE;
const int TW = 2 * KRADIUS + 1;
// One entry's packed buffers are [slot][clip][plane][HEIGHT][STRIDE] (src) and
// [slot][plane][TW][2][HEIGHT][STRIDE] (res): all planes of one entry share
// their geometry, so a plane is one TEMPORAL_STRIDE hop away and the res slice
// offsets the aggregation takes are TW * 2 * TEMPORAL_STRIDE apart.
const int CLIP_STRIDE = NPLANES * TEMPORAL_STRIDE;
const int SLOT_STRIDE = (FINAL != 0 ? 2 : 1) * CLIP_STRIDE;
const int RES_PLANE_STRIDE = TW * 2 * TEMPORAL_STRIDE;

const float FLT_MAX_ = 3.402823466e+38f;
const float FLT_EPS_ = 1.192092896e-07f;
const int INT_MAX_ = 0x7fffffff;

// `coherent` on both arms: the accumulation target is written by atomics that
// every invocation must see, and the qualifier is the one structural difference
// between the two arms' buffer declarations (see notes/BM3D.md on Nvidia).
#ifndef NO_FLOAT_ATOMICS
layout(std430, binding = 0) coherent buffer ResBuf { float res[]; };
#else
layout(std430, binding = 0) coherent buffer ResBuf { uint res_u[]; };
#endif
layout(std430, binding = 1) readonly buffer SrcBuf { float src[]; };
// The destination plane of the aggregation. The estimation dispatch binds the
// trace buffer here instead: it never writes a destination.
layout(std430, binding = 2) buffer TraceBuf { uint trace[]; };
// Per-(slot, slice) witness: the frame index the estimation kernel wrote that
// slice for (frame + 1, so 0 means "never written"). The aggregation refuses a
// slice whose witness is not the frame it intends to read, which makes it
// impossible to aggregate another frame's data -- the intermittent contaminant
// band -- no matter what the slot bookkeeping or the host-side timing does.
layout(std430, binding = 3) buffer TagBuf { uint tags[]; };

// Adds val to the float at res[idx]. The no-extension form is the reference's
// atom_add_f: a CAS loop over the uint bits, one fadd per round like the
// hardware atomic, so the accumulated bits are the same up to add order.
// Every read of the accumulator is an atomic: the reference reads its initial
// value through a `volatile` pointer for this reason, and atomicCompSwap(x,0,0)
// is an atomic load that returns the current value without changing it.
// The loop is bounded on purpose: an unbounded retry that cannot make progress
// spins the GPU until the driver resets the device (seen as
// VK_ERROR_DEVICE_LOST with no fault). The bound is a contention bound, derived
// from the kernel's own geometry: one element can receive one add per matched
// patch from every reference block whose search window reaches it, and the
// blocks that can reach it are spaced BLOCK_STEP over a span of
// 2 * BM_RANGE + 8 origins, so at most 8 * (ceil((2 * BM_RANGE + 8) /
// BLOCK_STEP) + 1)^2 adds -- the 8 matches of each block. That is 968 at
// bm_range=16/block_step=4 and 13448 at bm_range=16/block_step=1. Erring high
// is safe: a failed exchange means another one of those adds landed, so the
// true retry count is below it.
// Unsigned arithmetic keeps the derivation in range at BM_RANGE's 8192 cap
// (the maximum, 8 * 16393^2, is still below 2^32).
void res_add(int idx, float val) {
#ifndef NO_FLOAT_ATOMICS
    atomicAdd(res[idx], val);
#else
    uint cells = (2u * uint(BM_RANGE) + 8u + uint(BLOCK_STEP) - 1u) / uint(BLOCK_STEP) + 1u;
    uint retries = 8u * cells * cells;
    uint assumed = atomicCompSwap(res_u[idx], 0u, 0u);
    for (uint i = 0u; i < retries; ++i) {
        const uint old = atomicCompSwap(res_u[idx], assumed,
                                        floatBitsToUint(uintBitsToFloat(assumed) + val));
        if (old == assumed) {
            return;
        }
        assumed = old;
    }
    // Unreachable for every accepted config (the bound above is exact), but if
    // it is ever taken, land the add atomically on the freshest value: a plain
    // store races a concurrent atomic writer and silently loses its addend.
    const uint latest = atomicCompSwap(res_u[idx], 0u, 0u);
    atomicCompSwap(res_u[idx], latest, floatBitsToUint(uintBitsToFloat(latest) + val));
#endif
}

layout(push_constant) uniform PushConstants {
    int res_off;   // float offset of this plane's result region
    int nmod;      // centre frame index of the window
    int nframes;   // total frame count (temporal bounds)
    int src_slot;  // radius 0: the stream's private source slot
    int tag_base;  // first tag index of this slot (slot * TW)
    int trace_xy;  // TRACE: packed origin to record, else -1
} pc;

// Absolute frame index of window position z. Only z in [zlo, zhi] is a real
// frame; a window position outside that range is not searched and its result
// slice is left unwritten, so an endpoint frame is never matched twice.
int src_frame(int z) {
    return pc.nmod - KRADIUS + z;
}

// ring slot holding the frame at window position z (at radius 0 the stream's
// own slot, keyed by stream not frame index so out-of-order frames never clash)
int slot_base(int z) {
    if (RADIUS == 0) {
        return pc.src_slot;
    }
    return src_frame(z) % SRC_RING;
}

// float offset of `plane`'s frame at window position z in the clip used for
// block matching and, in final mode, as the Wiener reference (clip 0). In final
// mode each ring slot holds [ref][source], so the slot stride doubles.
int src_search(int z, int plane) {
    return slot_base(z) * SLOT_STRIDE + plane * TEMPORAL_STRIDE;
}

// float offset of the same frame in the clip that is actually denoised (the
// source clip: clip 1 in final mode, the same as the search clip otherwise)
int src_input(int z, int plane) {
    return src_search(z, plane) + (FINAL != 0 ? CLIP_STRIDE : 0);
}

// Prediction seeds of the temporal chain, one row per 8-lane group. They live
// in shared memory because every lane of the group reads all of them: a
// register array indexed by a runtime seed count would spill to scratch.
shared int s_x[4][8];
shared int s_y[4][8];
// The current frame's seeds, kept so both temporal directions start from the
// same list.
shared int s0_x[4][8];
shared int s0_y[4][8];


void dct_fwd(inout float v[8]) {
    const float KP414213562 = +0.414213562373095048801688724209698078569671875;
    const float KP1_847759065 = +1.847759065022573512256366378793576573644833252;
    const float KP198912367 = +0.198912367379658006911597622644676228597850501;
    const float KP1_961570560 = +1.961570560806460898252364472268478073947867462;
    const float KP1_414213562 = +1.414213562373095048801688724209698078569671875;
    const float KP668178637 = +0.668178637919298919997757686523080761552472251;
    const float KP1_662939224 = +1.662939224605090474157576755235811513477121624;
    const float KP707106781 = +0.707106781186547524400844362104849039284835938;

    float T1 = v[0];
    float T2 = v[7];
    float T3 = T1 - T2;
    float Tj = T1 + T2;
    float Tc = v[4];
    float Td = v[3];
    float Te = Tc - Td;
    float Tk = Tc + Td;
    float T4 = v[2];
    float T5 = v[5];
    float T6 = T4 - T5;
    float T7 = v[1];
    float T8 = v[6];
    float T9 = T7 - T8;
    float Ta = T6 + T9;
    float Tn = T7 + T8;
    float Tf = T6 - T9;
    float Tm = T4 + T5;
    float Tb = fma(-KP707106781, Ta, T3);
    float Tg = fma(-KP707106781, Tf, Te);
    v[3] = KP1_662939224 * (fma(KP668178637, Tg, Tb));
    v[5] = -(KP1_662939224 * (fma(-KP668178637, Tb, Tg)));
    float Tp = Tj + Tk;
    float Tq = Tm + Tn;
    v[4] = KP1_414213562 * (Tp - Tq);
    v[0] = KP1_414213562 * (Tp + Tq);
    float Th = fma(KP707106781, Ta, T3);
    float Ti = fma(KP707106781, Tf, Te);
    v[1] = KP1_961570560 * (fma(-KP198912367, Ti, Th));
    v[7] = KP1_961570560 * (fma(KP198912367, Th, Ti));
    float Tl = Tj - Tk;
    float To = Tm - Tn;
    v[2] = KP1_847759065 * (fma(-KP414213562, To, Tl));
    v[6] = KP1_847759065 * (fma(KP414213562, Tl, To));
}

void dct_inv(inout float v[8]) {
    const float KP1_662939224 = +1.662939224605090474157576755235811513477121624;
    const float KP668178637 = +0.668178637919298919997757686523080761552472251;
    const float KP1_961570560 = +1.961570560806460898252364472268478073947867462;
    const float KP198912367 = +0.198912367379658006911597622644676228597850501;
    const float KP1_847759065 = +1.847759065022573512256366378793576573644833252;
    const float KP707106781 = +0.707106781186547524400844362104849039284835938;
    const float KP414213562 = +0.414213562373095048801688724209698078569671875;
    const float KP1_414213562 = +1.414213562373095048801688724209698078569671875;

    float T1 = v[0] * KP1_414213562;
    float T2 = v[4];
    float T3 = fma(KP1_414213562, T2, T1);
    float Tj = fma(-KP1_414213562, T2, T1);
    float T4 = v[2];
    float T5 = v[6];
    float T6 = fma(KP414213562, T5, T4);
    float Tk = fma(KP414213562, T4, -T5);
    float T8 = v[1];
    float Td = v[7];
    float T9 = v[5];
    float Ta = v[3];
    float Tb = T9 + Ta;
    float Te = Ta - T9;
    float Tc = fma(KP707106781, Tb, T8);
    float Tn = fma(-KP707106781, Te, Td);
    float Tf = fma(KP707106781, Te, Td);
    float Tm = fma(-KP707106781, Tb, T8);
    float T7 = fma(KP1_847759065, T6, T3);
    float Tg = fma(KP198912367, Tf, Tc);
    v[7] = fma(-KP1_961570560, Tg, T7);
    v[0] = fma(KP1_961570560, Tg, T7);
    float Tp = fma(-KP1_847759065, Tk, Tj);
    float Tq = fma(KP668178637, Tm, Tn);
    v[5] = fma(-KP1_662939224, Tq, Tp);
    v[2] = fma(KP1_662939224, Tq, Tp);
    float Th = fma(-KP1_847759065, T6, T3);
    float Ti = fma(-KP198912367, Tc, Tf);
    v[3] = fma(-KP1_961570560, Ti, Th);
    v[4] = fma(KP1_961570560, Ti, Th);
    float Tl = fma(KP1_847759065, Tk, Tj);
    float To = fma(-KP668178637, Tn, Tm);
    v[6] = fma(-KP1_662939224, To, Tl);
    v[1] = fma(KP1_662939224, To, Tl);
