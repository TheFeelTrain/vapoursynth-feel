        o3 = fma(-1.17557049f, v[4], fma(1.90211308f, v[3], fma(-1.90211308f, v[1], 1.17557049f * v[0])));
        o4 = fma(0.618034005f, v[4], fma(-1.61803401f, v[3], fma(2.0f, v[2], fma(-1.61803401f, v[1], 0.618034005f * v[0]))));
        o5 = 0.0f;
