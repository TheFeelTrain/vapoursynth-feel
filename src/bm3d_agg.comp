#version 450
// Native u16 samples in the destination plane.
#extension GL_EXT_shader_16bit_storage : require

/*
 * BM3D normalize kernel. Each processed pixel is the accumulated numerator of
 * its frame divided by the sum of the weights of every reference block that
 * covers it.
 *
 * The estimation kernel scatters each group member's filtered patch into the
 * frame it came from: one numerator add per pixel, and one denominator add per
 * block at the block's origin. The denominator of a pixel is therefore the sum
 * of the weights of the BLOCK x BLOCK block origins in [p - BLOCK + 1, p],
 * computed here from a shared tile separably (rows, then columns). Origins off
 * the block grid are zero, so the contiguous box is the right sum.
 *
 * -DIO_U16 / -DIO_F16 / -DIO_F32 selects the destination plane's element type.
 * The accumulator and the source ring are float at every depth.
 */

#if !defined(IO_U16) && !defined(IO_F32) && !defined(IO_F16)
#define IO_F32 1
#endif

#if defined(IO_U16)
#define PEAK 65535.0f
#else
#define PEAK 1.0f
#endif

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(constant_id = 0) const int HEIGHT = 1080;
layout(constant_id = 1) const int STRIDE = 1920;
layout(constant_id = 2) const int TW = 5; // unused, kept for the shared spec map
layout(constant_id = 3) const int RADIUS = 2;
layout(constant_id = 4) const int RES_CAP = 6;
layout(constant_id = 5) const int NPLANES = 1;
layout(constant_id = 6) const int TAG_BASE = 0; // unused
layout(constant_id = 7) const int CHROMA = 0;

layout(std430, binding = 0) readonly buffer AccBuf { float acc[]; };
layout(std430, binding = 1) readonly buffer SrcBuf { float src[]; };
#if defined(IO_U16)
layout(std430, binding = 2) buffer DstBuf { uint16_t dst16[]; };
#elif defined(IO_F16)
layout(std430, binding = 2) buffer DstBuf { float16_t dst16[]; };
#else
layout(std430, binding = 2) buffer DstBuf { float dst[]; };
#endif

layout(push_constant) uniform PushConstants {
    int n;         // output frame index
    int acc_base;  // first frame of the accumulator ring this frame lives in
    int slot0;     // radius 0: this frame's private accumulator slot
    int plane_off; // this plane's (numerator, denominator) pair in the slot
    int src_base;  // this frame's source plane in the src ring
    float out_gain; // Float2Int scale for this frame's _Range
    float out_bias; // neutral + 0.5, already including the rounding term
} pc;

const int BLOCK = 8;
const int TILE = 16;
const int SPAN = TILE + BLOCK - 1;
const int PE = HEIGHT * STRIDE;
const int ACC_SLOT = NPLANES * 2 * PE;

// The accumulator slot the output frame was scattered into.
int slot_of(int frame) {
    if (RADIUS == 0) {
        return pc.slot0;
    }
    const int rel = frame - pc.acc_base;
    return ((rel % RES_CAP) + RES_CAP) % RES_CAP;
}

int num_at(int x, int y) {
    return slot_of(pc.n) * ACC_SLOT + pc.plane_off + y * STRIDE + x;
}

float den_at(int x, int y) { return acc[num_at(x, y) + PE]; }

// One accumulated result to a native output sample, or to a float if the clip
// is float. The integer arm is the reference's Float2Int: it scales by 65535,
// adds 0.5, clips to the format's [0, 65535] and truncates, `Clip(v * gain +
// 0.5, floor, ceil)`, with a chroma plane carrying the 32768 neutral the copy
// kernel removed. That clip is not optional -- the weight sums num/den can land
// an ulp above 1.0, and a bare mask-and-truncate would wrap that to 0. The
// float arms store the value as-is (a half element narrows with the SPIR-V
// default round-to-nearest-even and no saturation).
void store_result(int x, int y, float v) {
    const int o = y * STRIDE + x;
#if defined(IO_U16)
    // The inverse of the copy kernel's widening, with this frame's own _Range
    // mapping: out_gain is 65535 full, 56064 limited luma, 57344 chroma, and
    // out_bias is the neutral code plus the reference's 0.5 rounding term.
    // Clip to the whole code range so limited output keeps its headroom.
    const float s = clamp(v * pc.out_gain + pc.out_bias, 0.0f, PEAK);
    dst16[o] = uint16_t(uint(s));
#elif defined(IO_F16)
    dst16[o] = float16_t(v);
#else
    dst[o] = v;
#endif
}

// The weight tile of the BLOCK-1 columns/rows before this workgroup's output
// tile, so every pixel's box is a contiguous span of it.
shared float blockWeights[SPAN][SPAN];
shared float rowSums[SPAN][TILE];

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 origin = ivec2(gl_WorkGroupID.xy) * TILE - ivec2(BLOCK - 1);
    const int lx = int(gl_LocalInvocationID.x);
    const int ly = int(gl_LocalInvocationID.y);

    // Every invocation takes part in both barriers, including those covering
    // the padding columns past STRIDE.
    for (int i = int(gl_LocalInvocationIndex); i < SPAN * SPAN; i += TILE * TILE) {
        const int c = i % SPAN;
        const int r = i / SPAN;
        const ivec2 q = origin + ivec2(c, r);
        const bool inside = q.x >= 0 && q.y >= 0 && q.x < STRIDE && q.y < HEIGHT;
        blockWeights[r][c] = inside ? den_at(q.x, q.y) : 0.0;
    }
    barrier();

    // Row sums: rowSums[r][x] covers block weights x .. x + BLOCK - 1.
    for (int r = ly; r < SPAN; r += TILE) {
        float sum = 0.0;
        for (int c = 0; c < BLOCK; ++c) {
            sum += blockWeights[r][lx + c];
        }
        rowSums[r][lx] = sum;
    }
    barrier();

    float den = 0.0;
    for (int r = 0; r < BLOCK; ++r) {
        den += rowSums[ly + r][lx];
    }

    if (p.x >= STRIDE || p.y >= HEIGHT) {
        return;
    }
    // A denominator of zero means no block covered the pixel, which only the
    // padded columns can have; the honest output there is the source pixel.
    const float v = den > 0.0 ? acc[num_at(p.x, p.y)] / den
                              : src[pc.src_base + p.y * STRIDE + p.x];
    store_result(p.x, p.y, v);
}
