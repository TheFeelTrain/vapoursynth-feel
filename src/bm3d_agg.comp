#version 450

/*
 * BM3D temporal aggregation kernel. For each output pixel, sums the
 * pre-aggregated estimates (wdst) and weights (weight) of the TW stacked
 * result slices (TW = 2 * RADIUS + 1, matching the reference implementation's
 * aggPlane loop) and divides. The per-slice table (estimate offset, witness
 * index, expected witness) is derived from the window geometry instead of
 * being handed over in push constants: at TW = 33 it is three times the 128
 * bytes every device guarantees, and deriving it costs nothing measurable at
 * TW = 5 either (ABBA-measured parity, see notes/BM3D.md). The division is
 * fp32, as in every reference (zipcl's aggPlane divides floats, BM3DCUDA
 * multiplies by an f32 reciprocal); fp64 would run at 1/16 rate on RDNA3 for
 * a rounding difference no reference makes.
 *
 * One thread covers four adjacent columns through vec4 accesses (the plane
 * pitch is already a multiple of four floats, so every slice base, row offset
 * and column is 16-byte aligned). Scalar loads left the kernel bound by its
 * ten interleaved load streams rather than by bytes: the same bytes move in a
 * quarter of the instructions.
 */

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(constant_id = 0) const int HEIGHT = 1080;
layout(constant_id = 1) const int STRIDE = 1920;
layout(constant_id = 2) const int TW = 5;
layout(constant_id = 3) const int RADIUS = 2;
layout(constant_id = 4) const int RES_CAP = 6;

layout(std430, binding = 0) readonly buffer ResBuf { vec4 res4[]; };
layout(std430, binding = 1) readonly buffer SrcBuf { float src[]; };
layout(std430, binding = 3) readonly buffer TagBuf { uint tags[]; };
layout(std430, binding = 4) buffer SkipBuf { uint skipped[]; };
layout(std430, binding = 5) buffer RefuseBuf { uint refusal[]; };
layout(std430, binding = 2) buffer DstBuf { vec4 dst4[]; };

layout(push_constant) uniform PushConstants {
    int n;          // centre frame index
    int nframes;    // total frame count (for boundary clamping)
    int slot0;      // radius 0: the frame's private estimate slot
    int plane_off4; // this plane's result region, in vec4 elements
    int src_base;   // element offset of this frame's source plane in the src ring
} pc;

const int TEMPORAL_STRIDE = HEIGHT * STRIDE;

// Absolute frame index of window position z (clamped at the clip boundaries),
// as the reference's aggZ.
int agg_z(int i) {
    return min(max(2 * RADIUS - i, pc.n - pc.nframes + 1 + RADIUS),
               pc.n + RADIUS);
}

// Ring slot holding the estimate stack of the window centred on frame m: the
// host keys a slot by that centre frame. Radius 0's slots are private to one
// in-flight frame rather than keyed by frame index, so the host hands its own
// slot over. RES_CAP is a constant here, so the modulo is a multiply-shift.
int slot_of(int m) {
    if (RADIUS == 0) {
        return pc.slot0;
    }
    return int(uint(m) % uint(RES_CAP));
}

// The frame whose contribution slice z of that window is, as the estimation
// kernel's witness stores it (frame + 1, so 0 means "never written").
int expect_of(int m, int z) {
    return clamp(m - RADIUS + z, 0, pc.nframes - 1) + 1;
}

void main() {
    const int x = 4 * int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    // x may reach into the row padding (never read back), which keeps the
    // store in bounds without a per-row tail path.
    if (x >= STRIDE || y >= HEIGHT) {
        return;
    }

    // The res stacks are completed before this dispatch: the estimation kernels
    // (and the slot zero-fill) that wrote them are separated from these reads by
    // an ALL_COMMANDS memory barrier recording shader-write -> shader-read, and
    // the cross-queue source dependencies are carried as device waits on the
    // aggregation submit. A coherent (atomic) load is therefore unnecessary —
    // atomicAdd(res[o], 0.0f) forced a device-scope read-modify-write per element
    // just to read a value nobody was racing to modify; a plain load is cheaper
    // with identical output.
    const int o = (y * STRIDE + x) >> 2;
    const int tstride4 = TEMPORAL_STRIDE >> 2;
    // vec4 units throughout: with the host's addressing guard holding, every
    // factor and product below stays inside int32 for any accepted config (see
    // the estimate-cache guard in bm3d.cpp).
    const int slot_stride4 = TW * 2 * tstride4;
    const int slice_stride4 = 2 * tstride4;

    vec4 acc = vec4(0.0);
    vec4 acw = vec4(0.0);
    int used = 0;
    for (int i = 0; i < TW; ++i) {
        // Only slices the estimation kernel witnessed for the frame this
        // aggregation wants may contribute: a slice left as the zero fill, one
        // whose estimation never landed, or one still holding a recycled
        // frame's stacks is skipped rather than averaged in.
        const int z = agg_z(i);
        const int m = clamp(pc.n - RADIUS + i, 0, pc.nframes - 1);
        const int slot = slot_of(m);
        if (tags[slot * TW + z] != uint(expect_of(m, z))) {
            continue;
        }
        const int b =
            slot * slot_stride4 + pc.plane_off4 + z * slice_stride4 + o;
        acc += res4[b];
        acw += res4[b + tstride4];
        used++;
    }

    // A slot whose estimation never landed (still the zero fill, or only partly
    // accumulated) leaves acw at 0 or short, and acc/acw then divides by zero or
    // averages a partial stack: that is the intermittent band -- black where the
    // whole slot was lost, dimmed where part of it was, and carrying a previous
    // frame's patch groups where the slot was recycled. Every pixel of a
    // complete stack has a nonzero weight (its own block always contributes), so
    // a zero weight here is proof the contribution is missing, and the honest
    // output for it is the source frame's own pixel: undenoised, never corrupt.
    if (o == 0 && used < TW) {
        // Count refusals, and record the first one: the witness value found
        // against the one wanted tells the two causes apart -- 0 means the
        // slice was never written, anything else means it holds another
        // frame's stacks. refusal[0] is the one-shot claim.
        atomicAdd(skipped[0], 1u);
        if (atomicCompSwap(refusal[0], 0u, 1u) == 0u) {
            for (int i = 0; i < TW; ++i) {
                const int z = agg_z(i);
                const int m = clamp(pc.n - RADIUS + i, 0, pc.nframes - 1);
                const int want = expect_of(m, z);
                const int at = slot_of(m) * TW + z;
                if (tags[at] != uint(want)) {
                    refusal[2] = uint(want);
                    refusal[3] = tags[at];
                    break;
                }
            }
        }
    }
    if (used > 0 && acw.x > 0.0 && acw.y > 0.0 && acw.z > 0.0 && acw.w > 0.0) {
        dst4[o] = acc / acw;
    } else {
        const int so = pc.src_base + y * STRIDE + x;
        dst4[o] = vec4(src[so], src[so + 1], src[so + 2], src[so + 3]);
    }
}
