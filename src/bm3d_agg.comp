#version 450
// Native 16-bit samples in the destination plane.
#extension GL_EXT_shader_16bit_storage : require

/*
 * BM3D temporal aggregation kernel. For each output pixel, sums the
 * pre-aggregated estimates (wdst) and weights (weight) of the real estimate
 * stacks that saw this frame and divides. A stack centred on frame m holds its
 * contribution to frame n in slice z = n - m + R; every centre in
 * [n - R, n + R] that exists is accumulated exactly once, so an endpoint frame
 * is never counted several times through a clamped window position.
 *
 * One thread covers four adjacent columns through vec4 accesses (the plane
 * pitch is already a multiple of four floats, so every slice base, row offset
 * and column is 16-byte aligned). Scalar loads left the kernel bound by its
 * interleaved load streams rather than by bytes: the same bytes move in a
 * quarter of the instructions.
 *
 * -DBITS=16|32 selects the destination plane's element type. The estimate
 * stacks and the source ring are float either way: the stacks hold the
 * reference's weighted sums, and the ring is already widened at copy time (see
 * bm3d_copy.comp), which is what keeps the matcher's inner loop free of a
 * conversion per candidate sample.
 */

#if !defined(BITS)
#define BITS 32
#endif

#if BITS == 16
#define PEAK 65535.0f
#else
#define PEAK 1.0f
#endif

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(constant_id = 0) const int HEIGHT = 1080;
layout(constant_id = 1) const int STRIDE = 1920;
layout(constant_id = 2) const int TW = 5;
layout(constant_id = 3) const int RADIUS = 2;
layout(constant_id = 4) const int RES_CAP = 6;
// Planes packed into one estimate slot: 1 for the reference's per-plane entries,
// 3 for a joint chroma entry ([slot][plane][TW][2][HEIGHT][STRIDE]).
layout(constant_id = 5) const int NPLANES = 1;
// First witness slot of this entry's own region of the shared tag buffer: each
// entry keys its estimate slots by frame index, so entries that hold different
// frames in the same slot index must not share witnesses.
layout(constant_id = 6) const int TAG_BASE = 0;

layout(std430, binding = 0) readonly buffer ResBuf { vec4 res4[]; };
layout(std430, binding = 1) readonly buffer SrcBuf { float src[]; };
layout(std430, binding = 3) readonly buffer TagBuf { uint tags[]; };
layout(std430, binding = 4) buffer SkipBuf { uint skipped[]; };
layout(std430, binding = 5) buffer RefuseBuf { uint refusal[]; };
// The destination plane keeps its vec4 form at depth 32 (the store stays one
// 16-byte access per thread); at depth 16 it is four native samples.
#if BITS == 16
layout(std430, binding = 2) buffer DstBuf { uint16_t dst16[]; };
#else
layout(std430, binding = 2) buffer DstBuf { vec4 dst4[]; };
#endif

layout(push_constant) uniform PushConstants {
    int n;          // centre frame index
    int nframes;    // total frame count (temporal bounds)
    int slot0;      // radius 0: the frame's private estimate slot
    int plane_off4; // this plane's result region, in vec4 elements
    int src_base;   // element offset of this frame's source plane in the src ring
} pc;

const int TEMPORAL_STRIDE = HEIGHT * STRIDE;

// Ring slot holding the estimate stack centred on frame m: the host keys a slot
// by that centre frame. Radius 0's slots are private to one in-flight frame
// rather than keyed by frame index, so the host hands its own slot over.
// RES_CAP is a constant here, so the modulo is a multiply-shift.
int slot_of(int m) {
    if (RADIUS == 0) {
        return pc.slot0;
    }
    return int(uint(m) % uint(RES_CAP));
}

// One accumulated result to a native output sample, or to a float if the clip
// is float: the reference's Float2Int scales by 65535, adds 0.5, clips to the
// format's [0, 65535] and truncates, `Clip(v * gain + 0.5, floor, ceil)`. The
// clip is not optional -- the weight sums num/den can land an ulp above 1.0,
// and a bare mask-and-truncate would wrap that to 0.
void store_result(int x, int y, vec4 v) {
#if BITS == 16
    const int o = y * STRIDE + x;
    const vec4 s = clamp(v * PEAK + 0.5f, vec4(0.0f), vec4(PEAK));
    dst16[o + 0] = uint16_t(uint(s.x));
    dst16[o + 1] = uint16_t(uint(s.y));
    dst16[o + 2] = uint16_t(uint(s.z));
    dst16[o + 3] = uint16_t(uint(s.w));
#else
    dst4[(y * STRIDE + x) >> 2] = v;
#endif
}

void main() {
    const int x = 4 * int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    // x may reach into the row padding (never read back), which keeps the
    // store in bounds without a per-row tail path.
    if (x >= STRIDE || y >= HEIGHT) {
        return;
    }

    // The res stacks are completed before this dispatch: the estimation kernels
    // (and the slot zero-fill) that wrote them are separated from these reads by
    // an ALL_COMMANDS memory barrier recording shader-write -> shader-read, and
    // the cross-queue source dependencies are carried as device waits on the
    // aggregation submit. A coherent (atomic) load is therefore unnecessary —
    // atomicAdd(res[o], 0.0f) forced a device-scope read-modify-write per element
    // just to read a value nobody was racing to modify; a plain load is cheaper
    // with identical output.
    const int o = (y * STRIDE + x) >> 2;
    const int tstride4 = TEMPORAL_STRIDE >> 2;
    // vec4 units throughout: with the host's addressing guard holding, every
    // factor and product below stays inside int32 for any accepted config (see
    // the estimate-cache guard in bm3d.cpp).
    const int slot_stride4 = NPLANES * TW * 2 * tstride4;
    const int slice_stride4 = 2 * tstride4;

    // Only the centres that exist contribute; each of them writes exactly one
    // slice for this output frame.
    const int mlo = max(pc.n - RADIUS, 0);
    const int mhi = min(pc.n + RADIUS, pc.nframes - 1);
    const uint want = uint(pc.n + 1);

    vec4 acc = vec4(0.0);
    vec4 acw = vec4(0.0);
    int used = 0;
    for (int m = mlo; m <= mhi; ++m) {
        const int z = pc.n - m + RADIUS;
        const int slot = slot_of(m);
        // Only slices the estimation kernel witnessed for this output frame may
        // contribute: a slice left as the zero fill, one whose estimation never
        // landed, or one still holding a recycled frame's stacks is skipped
        // rather than averaged in.
        if (tags[(TAG_BASE + slot) * TW + z] != want) {
            continue;
        }
        const int b =
            slot * slot_stride4 + pc.plane_off4 + z * slice_stride4 + o;
        acc += res4[b];
        acw += res4[b + tstride4];
        used++;
    }

    // A slot whose estimation never landed (still the zero fill, or only partly
    // accumulated) leaves acw at 0 or short, and acc/acw then divides by zero or
    // averages a partial stack: that is the intermittent band -- black where the
    // whole slot was lost, dimmed where part of it was, and carrying a previous
    // frame's patch groups where the slot was recycled. Every pixel of a
    // complete stack has a nonzero weight (its own block always contributes), so
    // a zero weight here is proof the contribution is missing, and the honest
    // output for it is the source frame's own pixel: undenoised, never corrupt.
    // A centre only contributes to this output frame when its group matched a
    // block in it, so a short stack is normal once the threshold rejects: only
    // a stack with no contribution at all is the failure the source fallback
    // exists for (the output would otherwise be the zero fill).
    if (o == 0 && used == 0) {
        // Count refusals, and record the first one: the witness value found
        // against the one wanted tells the two causes apart -- 0 means the
        // slice was never written, anything else means it holds another
        // frame's stacks. refusal[0] is the one-shot claim.
        atomicAdd(skipped[0], 1u);
        if (atomicCompSwap(refusal[0], 0u, 1u) == 0u) {
            for (int m = mlo; m <= mhi; ++m) {
                const int z = pc.n - m + RADIUS;
                const int at = (TAG_BASE + slot_of(m)) * TW + z;
                if (tags[at] != want) {
                    refusal[2] = uint(want);
                    refusal[3] = tags[at];
                    break;
                }
            }
        }
    }
    if (used > 0 && acw.x > 0.0 && acw.y > 0.0 && acw.z > 0.0 && acw.w > 0.0) {
        store_result(x, y, acc / acw);
    } else {
        // The fallback is the source frame's own pixel, to the same output
        // scale as the rest of the frame.
        const int so = pc.src_base + y * STRIDE + x;
        store_result(x, y,
                     vec4(src[so], src[so + 1], src[so + 2], src[so + 3]));
    }
}
